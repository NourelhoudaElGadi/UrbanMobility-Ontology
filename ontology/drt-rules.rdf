    <rdfs:label>S10</rdfs:label>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <rdfs:comment xml:lang="en">A reservation whose pickup slack is at most 1,200 seconds (20 minutes) is a tight pickup window reservation. Application-specific rule of the YeloFlex DRT routing optimisation use case.</rdfs:comment>
