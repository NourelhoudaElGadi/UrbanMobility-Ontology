  <rdf:Description rdf:nodeID="nc06707571914477c9ad9241d4d0a4920b34">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>S13</rdfs:label>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <rdfs:comment xml:lang="en">A reservation whose drop-off slack is greater than 0 and at most 1,800 seconds (30 minutes) is a tight drop-off window reservation. Application-specific rule of the YeloFlex DRT routing optimisation use case.</rdfs:comment>
    <swrl:body rdf:nodeID="nc06707571914477c9ad9241d4d0a4920b35"/>
    <swrl:head rdf:nodeID="nc06707571914477c9ad9241d4d0a4920b47"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc06707571914477c9ad9241d4d0a4920b16">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>S12</rdfs:label>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <rdfs:comment xml:lang="en">A reservation made by a customer whose profile is 'elderly' is a comfort-sensitive reservation. Application-specific rule of the YeloFlex DRT routing optimisation use case.</rdfs:comment>
    <swrl:body rdf:nodeID="nc06707571914477c9ad9241d4d0a4920b17"/>
    <swrl:head rdf:nodeID="nc06707571914477c9ad9241d4d0a4920b23"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/isPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/urbanmobility/drt-rules">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:bibliographicCitation>Nourelhouda El Gadi, Esma Talhi, Alain Bouju (2026). Urban-Mobility-Ontology (version 1.1.0). Zenodo. https://doi.org/10.5281/zenodo.20054329</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#gYearMonth">2026-11</dcterms:created>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0002-1599-9326"/>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0002-7792-8953"/>
    <dcterms:creator rdf:resource="https://orcid.org/0009-0000-4334-4557"/>
    <dcterms:description xml:lang="en">Application module of the Urban-Mobility-Ontology. It holds the SWRL rules used in the YeloFlex project to classify DRT reservations (short notice, tight pickup or drop-off window, comfort-sensitive) before the optimisation of the routes of autonomous on-demand shuttles. The thresholds of these rules are choices of that application, not part of the generic ontology: reusers can import the DRT module without this module, or write their own rules with other thresholds.</dcterms:description>
    <dcterms:identifier rdf:resource="https://doi.org/10.5281/zenodo.20054329"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/urbanmobility/"/>
    <dcterms:language>en</dcterms:language>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-27</dcterms:modified>
    <dcterms:title xml:lang="en">Urban-Mobility-Ontology: SWRL rules of the DRT routing optimisation application</dcterms:title>
    <owl:imports rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <owl:versionIRI rdf:resource="https://w3id.org/urbanmobility/drt-rules/1.1.0"/>
    <owl:versionInfo>1.1.0</owl:versionInfo>
    <foaf:homepage rdf:resource="https://nourelhoudaelgadi.github.io/UrbanMobility-Ontology/rules.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
