    <rdfs:label xml:lang="en">road type</rdfs:label>
    <rdfs:comment xml:lang="en">Road type of the street, for example residential or primary (OpenStreetMap highway type).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#Streets"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
