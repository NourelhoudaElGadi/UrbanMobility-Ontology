    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#Municipalities"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/infrastructure#frontsOnStreet">
    <rdfs:label xml:lang="en">fronts on street</rdfs:label>
