    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/infrastructure#activityType">
    <rdfs:label xml:lang="en">activity type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of activity of the industrial zone.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#Industrial_Zone"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/infrastructure#LanesBackward">
    <rdfs:label xml:lang="en">backward lanes</rdfs:label>
    <rdfs:comment xml:lang="en">Number of lanes in the backward direction of the road segment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#Road_segment"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/infrastructure#Longitude_R">
    <rdfs:label xml:lang="en">street longitude</rdfs:label>
    <rdfs:comment xml:lang="en">Longitude of the reference point of the street.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#Streets"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Bicycle_lane_marking">
    <rdfs:label xml:lang="en">bicycle lane marking</rdfs:label>
    <rdfs:comment xml:lang="en">Ground markings indicating a lane or a space reserved for cyclists, with specific symbols or signs.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#Road_markings"/>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
  <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#ehMeet">
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#bicycle">
    <rdfs:label xml:lang="en">bicycle</rdfs:label>
    <rdfs:comment xml:lang="en">A human-powered two-wheeled vehicle, used on streets, bicycle lanes and sometimes sidewalks.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#vehicle"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/infrastructure#Nom_rech">
    <rdfs:label xml:lang="en">charging station name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the charging station.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#Charging_station"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/infrastructure#Latitude_C">
    <rdfs:label xml:lang="en">municipality latitude</rdfs:label>
