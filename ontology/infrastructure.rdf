        <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
        <rdfs:range rdf:resource="https://w3id.org/urbanmobility/infrastructure#Streets"/>
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
