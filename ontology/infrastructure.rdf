    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/infrastructure#Streets"/>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
  <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#rcc8ntppi">
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
  <owl:NamedIndividual rdf:about="https://w3id.org/urbanmobility/infrastructure#Macro">
    <rdf:type rdf:resource="https://w3id.org/urbanmobility/infrastructure#GranularityLevel"/>
    <rdfs:label xml:lang="en">macro level</rdfs:label>
    <rdfs:comment xml:lang="en">Macro level of granularity: municipality-level entities, such as municipalities.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
  </owl:NamedIndividual>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/language"/>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle">
    <rdfs:label xml:lang="en">DRT shuttle</rdfs:label>
    <rdfs:comment xml:lang="en">A vehicle temporarily assigned to the demand-responsive transport (DRT) service. It can stop playing this role without ceasing to be the same vehicle.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#vehicle"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Intersection">
    <rdfs:label xml:lang="en">intersection</rdfs:label>
    <rdfs:comment xml:lang="en">A junction where several streets meet, where vehicles and pedestrians follow signage to take the right direction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b20">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#vehicle">
    <rdfs:label xml:lang="en">vehicle</rdfs:label>
    <rdfs:comment xml:lang="en">A motorised or non-motorised means of transport used on roads to move people or goods.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Traffic_signs">
    <rdfs:label xml:lang="en">traffic sign</rdfs:label>
    <rdfs:comment xml:lang="en">A road sign giving traffic information, such as a speed limit, a restriction or a direction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#Traffic_control"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Municipalities">
    <rdfs:label xml:lang="en">municipality</rdfs:label>
    <rdfs:comment xml:lang="en">A municipality: the territory of a city or a town, delimited in space and represented by a polygon or a multipolygon. Its identity is given by its spatial extent and its boundaries.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b21">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Sidewalk">
    <rdfs:label xml:lang="en">sidewalk</rdfs:label>
    <rdfs:comment xml:lang="en">A paved pathway adjacent to a street, intended for pedestrian use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b14">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#GranularityLevel">
    <rdfs:label xml:lang="en">granularity level</rdfs:label>
    <rdfs:comment xml:lang="en">The level of spatial granularity of an urban entity: micro (street level), meso (neighbourhood level) or macro (municipality level).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Parking">
    <rdfs:label xml:lang="en">parking area</rdfs:label>
    <rdfs:comment xml:lang="en">A designated area for parking vehicles, such as a car park or parking spaces.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Roundabout">
    <rdfs:label xml:lang="en">roundabout</rdfs:label>
    <rdfs:comment xml:lang="en">A roundabout: a circular intersection where traffic flows around a central island.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Traffic_light">
    <rdfs:label xml:lang="en">traffic light</rdfs:label>
    <rdfs:comment xml:lang="en">A traffic signal that controls the movement of vehicles and pedestrians with red, amber and green lights.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#Traffic_control"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Building">
    <rdfs:label xml:lang="en">building</rdfs:label>
    <rdfs:comment xml:lang="en">A building located along a street.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b19">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Road_segment">
    <rdfs:label xml:lang="en">road segment</rdfs:label>
    <rdfs:comment xml:lang="en">A portion of road between two reference points, such as intersections or stops. Its identity is determined by its position, its end points and the segmentation of the road network: correcting its coordinates does not create a new segment, whereas splitting or merging segments does.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b23">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#UrbanEntity">
    <rdfs:label xml:lang="en">urban entity</rdfs:label>
    <rdfs:comment xml:lang="en">Any entity of the urban and peri-urban environment considered in mobility modelling. It is the top class of the infrastructure module.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#AreaOfInterest">
    <rdfs:label xml:lang="en">area of interest</rdfs:label>
    <rdfs:comment xml:lang="en">A functional urban area of interest, such as a school, commercial or residential zone.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b15">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Charging_station">
    <rdfs:label xml:lang="en">charging station</rdfs:label>
    <rdfs:comment xml:lang="en">A place where electric vehicles, including DRT shuttles, can be charged.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b16">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Neighborhood">
    <rdfs:label xml:lang="en">neighbourhood</rdfs:label>
    <rdfs:comment xml:lang="en">A geographically delimited urban area that comprises streets, points of interest and other urban infrastructure elements. A neighbourhood is identified by its spatial extent and its boundaries in the adopted urban zoning; a change in geometric precision does not alter its identity when the area represented stays the same.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Industrial_Zone">
    <rdfs:label xml:lang="en">industrial zone</rdfs:label>
    <rdfs:comment xml:lang="en">An area where economic activities, such as industry, are concentrated.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b17">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Road_markings">
    <rdfs:label xml:lang="en">road marking</rdfs:label>
    <rdfs:comment xml:lang="en">Road surface markings that guide traffic, such as lane lines, crosswalks and directional arrows.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Streets">
    <rdfs:label xml:lang="en">street</rdfs:label>
    <rdfs:comment xml:lang="en">A street used by vehicles and pedestrians, made of one or more road segments.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b24">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Pedestrians">
    <rdfs:label xml:lang="en">pedestrian</rdfs:label>
    <rdfs:comment xml:lang="en">People walking along streets, crossing roads or using sidewalks.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature">
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#SpatialObject"/>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Sensor">
    <rdfs:label xml:lang="en">sensor</rdfs:label>
    <rdfs:comment xml:lang="en">A device that collects traffic data, such as vehicle speed, traffic volume or density on a road.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b22">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <rdf:Description rdf:about="https://orcid.org/0000-0002-1599-9326">
    <rdfs:label>Alain Bouju</rdfs:label>
  </rdf:Description>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Traffic_control">
    <rdfs:label xml:lang="en">traffic control</rdfs:label>
    <rdfs:comment xml:lang="en">The signs, traffic lights and road markings that regulate traffic and warn or inform drivers and pedestrians.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n411e60fd8d904ed69b203e8f4e1dccc0b18">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#Obstacles">
    <rdfs:label xml:lang="en">obstacle</rdfs:label>
    <rdfs:comment xml:lang="en">An object or a structure on the street that may block or slow down vehicles or pedestrians.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#UrbanEntity"/>
  </owl:Class>
  <rdf:Description rdf:about="https://orcid.org/0000-0002-7792-8953">
    <rdfs:label>Esma Talhi</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0009-0000-4334-4557">
    <rdfs:label>Nourelhouda El Gadi</rdfs:label>
  </rdf:Description>
</rdf:RDF>
