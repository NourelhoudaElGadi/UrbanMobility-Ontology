>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/infrastructure#School">
    <rdfs:label xml:lang="en">school</rdfs:label>
    <rdfs:comment xml:lang="en">A school building, an important destination of DRT trips.</rdfs:comment>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="https://w3id.org/urbanmobility/infrastructure">
        <dcterms:bibliographicCitation>Nourelhouda El Gadi, Esma Talhi, Alain Bouju (2026). Urban-Mobility-Ontology (version 1.1.0). Zenodo. https://doi.org/10.5281/zenodo.20054329</dcterms:bibliographicCitation>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#gYearMonth">2024-07</dcterms:created>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-1599-9326"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-7792-8953"/>
        <dcterms:creator rdf:resource="https://orcid.org/0009-0000-4334-4557"/>
        <dcterms:description xml:lang="en">Module of the Urban-Mobility-Ontology that represents the urban environment in which public transport services and autonomous shuttles operate: road segments, streets, intersections, roundabouts, road markings, traffic controls, sensors, buildings, neighbourhoods and municipalities, together with vehicles and pedestrians. Urban entities are organised in three levels of granularity: micro (street level), meso (neighbourhood level) and macro (municipality level). Spatial classes are GeoSPARQL features.</dcterms:description>
        <dcterms:identifier rdf:resource="https://doi.org/10.5281/zenodo.20054329"/>
        <dcterms:isPartOf rdf:resource="https://w3id.org/urbanmobility/"/>
        <dcterms:language>en</dcterms:language>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-27</dcterms:modified>
        <dcterms:title xml:lang="en">Urban-Mobility-Ontology: Urban infrastructure module</dcterms:title>
        <vann:preferredNamespacePrefix>Infrastructure</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/urbanmobility/infrastructure#</vann:preferredNamespaceUri>
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <owl:priorVersion rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation"/>
        <owl:versionIRI rdf:resource="https://w3id.org/urbanmobility/infrastructure/1.1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
        <foaf:homepage rdf:resource="https://nourelhoudaelgadi.github.io/UrbanMobility-Ontology/infrastructure.html"/>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#Building"/>
  </owl:Class>
