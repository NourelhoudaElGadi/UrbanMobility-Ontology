    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/infrastructure#Sensor"/>
  </owl:Class>
