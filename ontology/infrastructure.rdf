    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/infrastructure#IsPartOfStreet">
        <rdfs:label xml:lang="en">is part of street</rdfs:label>
        <rdfs:comment xml:lang="en">Links a road segment to the street it belongs to. It specialises the spatial relation geosparql:sfWithin.</rdfs:comment>
