    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#amount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#amount">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The cost of the fare product. May be negative to represent transfer discounts. May be zero to represent a fare product that is free.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#area_id -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#area_id">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Area"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Identifier of the area.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#area_name -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#area_name">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Area"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the area as presented to riders.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#arrival_time -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#arrival_time">
