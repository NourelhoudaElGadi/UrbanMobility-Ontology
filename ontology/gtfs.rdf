<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stopInArea">
    <rdfs:label xml:lang="en">stop in area</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop to an area that contains or groups it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="https://w3id.org/urbanmobility/gtfs">
        <dcterms:bibliographicCitation>Nourelhouda El Gadi, Esma Talhi, Alain Bouju (2026). Urban-Mobility-Ontology (version 1.1.0). Zenodo. https://doi.org/10.5281/zenodo.20054329</dcterms:bibliographicCitation>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcterms:created>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-1599-9326"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-7792-8953"/>
        <dcterms:creator rdf:resource="https://orcid.org/0009-0000-4334-4557"/>
        <dcterms:description xml:lang="en">Module of the Urban-Mobility-Ontology that represents scheduled and flexible public transport services according to the General Transit Feed Specification (GTFS): agencies, routes, trips, stops, stop times, service calendars, fares, transfers, booking rules and pickup and drop-off areas (GTFS-Flex). Spatial classes are GeoSPARQL features, so that transport services can be related to their geographical environment.</dcterms:description>
        <dcterms:identifier rdf:resource="https://doi.org/10.5281/zenodo.20054329"/>
        <dcterms:isPartOf rdf:resource="https://w3id.org/urbanmobility/"/>
        <dcterms:language>en</dcterms:language>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-27</dcterms:modified>
        <dcterms:source rdf:resource="https://gtfs.org/documentation/schedule/reference/"/>
        <dcterms:title xml:lang="en">Urban-Mobility-Ontology: GTFS service module</dcterms:title>
        <vann:preferredNamespacePrefix>GTFS</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/urbanmobility/gtfs#</vann:preferredNamespaceUri>
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <owl:priorVersion rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport"/>
        <owl:versionIRI rdf:resource="https://w3id.org/urbanmobility/gtfs/1.1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
        <foaf:homepage rdf:resource="https://nourelhoudaelgadi.github.io/UrbanMobility-Ontology/gtfs.html"/>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Area"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasLocation">
    <rdfs:label xml:lang="en">has flex location</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop to a GTFS-Flex zone (location) associated with it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Location"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#bikes_allowed">
    <rdfs:label xml:lang="en">bikes allowed</rdfs:label>
    <rdfs:comment xml:lang="en">Whether bicycles are allowed on the trip: 0 (or empty) = no information, 1 = at least one bicycle can be carried, 2 = no bicycles allowed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#agency_phone">
    <rdfs:label xml:lang="en">agency phone</rdfs:label>
    <rdfs:comment xml:lang="en">Phone number of the agency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#prior_notice_last_day">
    <rdfs:label xml:lang="en">prior notice last day</rdfs:label>
    <rdfs:comment xml:lang="en">Last day before travel on which the booking can be made, counted in days before the day of service (for example 1 = the day before).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#isDiverted">
    <rdfs:label xml:lang="en">is diverted</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the stop is diverted, that is temporarily moved because of a disruption. This property extends GTFS: it is not a field of the GTFS reference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#usesService">
    <rdfs:label xml:lang="en">uses service</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trip to the service calendar that says on which days it runs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#fare_media_id">
    <rdfs:label xml:lang="en">fare media ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the fare media.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasEndTimeframeGroup">
    <rdfs:label xml:lang="en">has end timeframe group</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare leg rule to the timeframe group that applies to the fare validation event at the end of the fare leg.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareLegRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#TimeFrame"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#direction_id">
    <rdfs:label xml:lang="en">direction ID</rdfs:label>
    <rdfs:comment xml:lang="en">Direction of travel of the trip on its route: 0 = one direction (for example outbound), 1 = the opposite direction (for example inbound).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#is_bookable">
    <rdfs:label xml:lang="en">is bookable</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the stop can be booked as a pickup or drop-off point of the DRT service. This property extends GTFS: it is not a field of the GTFS reference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#level_name">
    <rdfs:label xml:lang="en">level name</rdfs:label>
    <rdfs:comment xml:lang="en">Public name of the level.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Level"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#reversed_signposted_as">
    <rdfs:label xml:lang="en">reversed signposted as</rdfs:label>
    <rdfs:comment xml:lang="en">Public-facing text shown when the pathway is used in the reverse direction.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasDestinationArea">
    <rdfs:label xml:lang="en">has destination area</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare leg rule to the destination area at which the fare leg ends.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareLegRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Area"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_sequence">
    <rdfs:label xml:lang="en">stop sequence</rdfs:label>
    <rdfs:comment xml:lang="en">Sequence number of the stop within the trip.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_short_name">
    <rdfs:label xml:lang="en">route short name</rdfs:label>
    <rdfs:comment xml:lang="en">Short public name or code of the route.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#translation">
    <rdfs:label xml:lang="en">translated value</rdfs:label>
    <rdfs:comment xml:lang="en">Translated value provided for the selected field.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Translation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#endtime">
    <rdfs:label xml:lang="en">end time (frequency)</rdfs:label>
    <rdfs:comment xml:lang="en">Time at which the service changes to another headway or stops (HH:MM:SS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Frequency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#shape_pt_lat">
    <rdfs:label xml:lang="en">shape point latitude</rdfs:label>
    <rdfs:comment xml:lang="en">Latitude of a point in the shape geometry.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Shapes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#date">
    <rdfs:label xml:lang="en">date</rdfs:label>
    <rdfs:comment xml:lang="en">Specific date to which the service exception applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#CalendarDates"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range>
      <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    </rdfs:range>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_color">
    <rdfs:label xml:lang="en">route color</rdfs:label>
    <rdfs:comment xml:lang="en">Colour of the route, as a six-digit hexadecimal number (for example 00FFFF).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#monday">
    <rdfs:label xml:lang="en">monday</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the service runs on all Mondays of the date range: 1 = yes, 0 = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#duration_limit">
    <rdfs:label xml:lang="en">duration limit</rdfs:label>
    <rdfs:comment xml:lang="en">Duration limit of the transfer, in seconds.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareTransferRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasDestinationRoute">
    <rdfs:label xml:lang="en">has destination route</rdfs:label>
    <rdfs:comment xml:lang="en">Links a transfer rule to the destination route to which the transfer leads.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Transfer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#network_id">
    <rdfs:label xml:lang="en">network ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the network.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Network"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#field_name">
    <rdfs:label xml:lang="en">field name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the GTFS field being translated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Translation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#duration_limit_type">
    <rdfs:label xml:lang="en">duration limit type</rdfs:label>
    <rdfs:comment xml:lang="en">Which times define the duration limit of the transfer: 0 = departure of the current leg to arrival of the next leg, 1 = departure to departure, 2 = arrival to departure, 3 = arrival to arrival.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareTransferRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#fare_id">
    <rdfs:label xml:lang="en">fare ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the fare definition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareAttribute"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#bookingRuleAppliesToTrip">
    <rdfs:label xml:lang="en">booking rule applies to trip</rdfs:label>
    <rdfs:comment xml:lang="en">Links a booking rule to a trip it applies to.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#level_index">
    <rdfs:label xml:lang="en">level index</rdfs:label>
    <rdfs:comment xml:lang="en">Numeric index that gives the relative position of the level: 0 = ground level, positive values above ground, negative values below ground.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Level"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasStopTime">
    <rdfs:label xml:lang="en">has stop time</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trip to one of its stop times.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#area_name">
    <rdfs:label xml:lang="en">area name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the area as presented to riders.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Area"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#prior_notice_duration_max">
    <rdfs:label xml:lang="en">prior notice duration max</rdfs:label>
    <rdfs:comment xml:lang="en">Maximum number of minutes before travel at which the booking can be made.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#offersSupportTo">
    <rdfs:label xml:lang="en">offers support to</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare medium to a fare product that it can hold.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareProduct"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#record_sub_id">
    <rdfs:label xml:lang="en">record sub ID</rdfs:label>
    <rdfs:comment xml:lang="en">Secondary identifier used when a record needs additional disambiguation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Translation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#tuesday">
    <rdfs:label xml:lang="en">tuesday</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the service runs on all Tuesdays of the date range: 1 = yes, 0 = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#appliesToLegGroup">
    <rdfs:label xml:lang="en">applies to leg group</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare transfer rule to the fare leg rules (leg group) between which the transfer applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareTransferRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareLegRule"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#is_operator">
    <rdfs:label xml:lang="en">is operator</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the organisation operates the service: 1 = yes, 0 (or empty) = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_name">
    <rdfs:label xml:lang="en">stop name</rdfs:label>
    <rdfs:comment xml:lang="en">Public name of the stop or location.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_lat">
    <rdfs:label xml:lang="en">stop latitude</rdfs:label>
    <rdfs:comment xml:lang="en">Latitude of the stop or location.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#shape_dist_traveled">
    <rdfs:label xml:lang="en">shape distance traveled</rdfs:label>
    <rdfs:comment xml:lang="en">Distance travelled along the shape from its first point to this point.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Shapes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#feed_contact_email">
    <rdfs:label xml:lang="en">feed contact email</rdfs:label>
    <rdfs:comment xml:lang="en">Contact email address for the feed publisher.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#agency_name">
    <rdfs:label xml:lang="en">agency name</rdfs:label>
    <rdfs:comment xml:lang="en">Public name of the agency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_url">
    <rdfs:label xml:lang="en">route URL</rdfs:label>
    <rdfs:comment xml:lang="en">Public web page for the route.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_headsign">
    <rdfs:label xml:lang="en">stop headsign</rdfs:label>
    <rdfs:comment xml:lang="en">Headsign displayed to riders for this stop time.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#fare_media_type">
    <rdfs:label xml:lang="en">fare media type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of fare medium: 0 = none (for example cash paid to the driver), 1 = paper ticket, 2 = transit card, 3 = contactless bank card or mobile wallet, 4 = mobile app.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#agency_fare_url">
    <rdfs:label xml:lang="en">agency fare URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL of a page describing fares for the agency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#phone_number">
    <rdfs:label xml:lang="en">phone number</rdfs:label>
    <rdfs:comment xml:lang="en">Phone number that riders call to make a booking.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#message">
    <rdfs:label xml:lang="en">message</rdfs:label>
    <rdfs:comment xml:lang="en">General rider-facing message associated with the booking rule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#address">
    <rdfs:label xml:lang="en">address</rdfs:label>
    <rdfs:comment xml:lang="en">Postal address of the stop. This property extends GTFS: it is not a field of the GTFS reference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasParentStation">
    <rdfs:label xml:lang="en">has parent station</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop to its parent station.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasOriginTrip">
    <rdfs:label xml:lang="en">has origin trip</rdfs:label>
    <rdfs:comment xml:lang="en">Links a transfer rule to the origin trip from which the transfer starts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Transfer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#attribution_id">
    <rdfs:label xml:lang="en">attribution ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the attribution record.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#pathway_mode">
    <rdfs:label xml:lang="en">pathway mode</rdfs:label>
    <rdfs:comment xml:lang="en">Type of the pathway: 1 = walkway, 2 = stairs, 3 = moving sidewalk or travelator, 4 = escalator, 5 = elevator, 6 = fare gate, 7 = exit gate.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#partOfNetwork">
    <rdfs:label xml:lang="en">part of network</rdfs:label>
    <rdfs:comment xml:lang="en">Links a route to the network it belongs to.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Network"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#service_id">
    <rdfs:label xml:lang="en">service ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the service calendar.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#block_id">
    <rdfs:label xml:lang="en">block ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies the block to which the trip belongs. A block consists of a single trip or many sequential trips made using the same vehicle, defined by shared service days and block_id.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#feed_contact_url">
    <rdfs:label xml:lang="en">feed contact URL</rdfs:label>
    <rdfs:comment xml:lang="en">Contact URL for the feed publisher.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#location_group_id">
    <rdfs:label xml:lang="en">location group ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the location group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#LocationGroup"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#trip_id">
    <rdfs:label xml:lang="en">trip ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the trip.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stopInLocationGroup">
    <rdfs:label xml:lang="en">stop in location group</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop to the location group to which it belongs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#LocationGroup"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#AppliesToTrip">
    <rdfs:label xml:lang="en">attribution applies to trip</rdfs:label>
    <rdfs:comment xml:lang="en">Links an attribution record to the trip it applies to.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#pathway_id">
    <rdfs:label xml:lang="en">pathway ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the pathway.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#friday">
    <rdfs:label xml:lang="en">friday</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the service runs on all Fridays of the date range: 1 = yes, 0 = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#timeframe_group_id">
    <rdfs:label xml:lang="en">timeframe group ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the timeframe group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#TimeFrame"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#thursday">
    <rdfs:label xml:lang="en">thursday</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the service runs on all Thursdays of the date range: 1 = yes, 0 = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#end_pickup_drop_off_window">
    <rdfs:label xml:lang="en">end pickup drop off window</rdfs:label>
    <rdfs:comment xml:lang="en">Time at which the on-demand pickup or drop-off service stops being available at the location, location group or stop (HH:MM:SS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#pickup_message">
    <rdfs:label xml:lang="en">pickup message</rdfs:label>
    <rdfs:comment xml:lang="en">Message shown to riders for on-demand pickup booking.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#arrival_time">
    <rdfs:label xml:lang="en">arrival time</rdfs:label>
    <rdfs:comment xml:lang="en">Arrival time of the trip at the stop, in local time (HH:MM:SS). Values greater than 24:00:00 are used for trips that end after midnight.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#location_group_name">
    <rdfs:label xml:lang="en">location group name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the location group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#LocationGroup"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#wheelchair_accessible">
    <rdfs:label xml:lang="en">wheelchair accessible</rdfs:label>
    <rdfs:comment xml:lang="en">Wheelchair accessibility of the trip: 0 (or empty) = no information, 1 = at least one rider in a wheelchair can be accommodated, 2 = no rider in a wheelchair can be accommodated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#appliesToRoute">
    <rdfs:label xml:lang="en">attribution applies to route</rdfs:label>
    <rdfs:comment xml:lang="en">Links an attribution record to the route to which it applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#headway_secs">
    <rdfs:label xml:lang="en">headway seconds</rdfs:label>
    <rdfs:comment xml:lang="en">Headway, in seconds, between departures for the trip.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Frequency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasFareRule">
    <rdfs:label xml:lang="en">has fare rule</rdfs:label>
    <rdfs:comment xml:lang="en">Links a route to a fare rule that applies to it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareRule"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#Agency_id">
    <rdfs:label xml:lang="en">agency ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the agency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#prior_notice_start_time">
    <rdfs:label xml:lang="en">prior notice start time</rdfs:label>
    <rdfs:comment xml:lang="en">Earliest time, on the first day on which a booking can be made, at which the booking can be made (HH:MM:SS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasDestinationTrip">
    <rdfs:label xml:lang="en">has destination trip</rdfs:label>
    <rdfs:comment xml:lang="en">Links a transfer rule to the destination trip to which the transfer leads.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Transfer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#sunday">
    <rdfs:label xml:lang="en">sunday</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the service runs on all Sundays of the date range: 1 = yes, 0 = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#feed_start_date">
    <rdfs:label xml:lang="en">feed start date</rdfs:label>
    <rdfs:comment xml:lang="en">First date of service covered by the feed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#agency_timezone">
    <rdfs:label xml:lang="en">agency timezone</rdfs:label>
    <rdfs:comment xml:lang="en">Timezone used by the agency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#exact_times">
    <rdfs:label xml:lang="en">exact times</rdfs:label>
    <rdfs:comment xml:lang="en">Type of service of the frequency: false = frequency-based trips without exact schedule, true = schedule-based trips that run with exactly the same headway.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Frequency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasOriginRoute">
    <rdfs:label xml:lang="en">has origin route</rdfs:label>
    <rdfs:comment xml:lang="en">Links a transfer rule to the origin route from which the transfer starts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Transfer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#parent_station">
    <rdfs:label xml:lang="en">parent station</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the parent station or parent location.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#isApplicableDuring">
    <rdfs:label xml:lang="en">is applicable during</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that the time period described by timeframes applies to the service days defined in the calendar.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#TimeFrame"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#fare_media_name">
    <rdfs:label xml:lang="en">fare media name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the fare media.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#length">
    <rdfs:label xml:lang="en">length</rdfs:label>
    <rdfs:comment xml:lang="en">Horizontal length of the pathway, in metres.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_timezone">
    <rdfs:label xml:lang="en">stop timezone</rdfs:label>
    <rdfs:comment xml:lang="en">Timezone assigned to the stop or location.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_desc">
    <rdfs:label xml:lang="en">route description</rdfs:label>
    <rdfs:comment xml:lang="en">Description of the route.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_url">
    <rdfs:label xml:lang="en">stop URL</rdfs:label>
    <rdfs:comment xml:lang="en">Public web page for the stop or location.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#feed_end_date">
    <rdfs:label xml:lang="en">feed end date</rdfs:label>
    <rdfs:comment xml:lang="en">Last date of service covered by the feed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#default_lang">
    <rdfs:label xml:lang="en">default language</rdfs:label>
    <rdfs:comment xml:lang="en">Language to use when the language of the rider is unknown, as an IETF BCP 47 language code.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#feed_publisher_name">
    <rdfs:label xml:lang="en">feed publisher name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the feed publisher.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasStop">
    <rdfs:label xml:lang="en">has stop</rdfs:label>
    <rdfs:comment xml:lang="en">Links a location group to a stop that it contains.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#LocationGroup"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_code">
    <rdfs:label xml:lang="en">stop code</rdfs:label>
    <rdfs:comment xml:lang="en">Short code used to identify the stop to riders.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#exception_type">
    <rdfs:label xml:lang="en">exception type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of the exception on the given date: 1 = service added, 2 = service removed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#CalendarDates"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#zone_id">
    <rdfs:label xml:lang="en">zone ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the fare zone associated with the stop.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_type">
    <rdfs:label xml:lang="en">route type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of transport used on the route: 0 = tram or light rail, 1 = metro, 2 = rail, 3 = bus, 4 = ferry, 5 = cable tram, 6 = aerial lift, 7 = funicular, 11 = trolleybus, 12 = monorail.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#booking_rule_id">
    <rdfs:label xml:lang="en">booking rule ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the booking rule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#start_date">
    <rdfs:label xml:lang="en">start date</rdfs:label>
    <rdfs:comment xml:lang="en">First date on which the service is active.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#start_time">
    <rdfs:label xml:lang="en">start time (timeframe)</rdfs:label>
    <rdfs:comment xml:lang="en">Start of the time of day of the timeframe (HH:MM:SS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#TimeFrame"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#fare_product_id">
    <rdfs:label xml:lang="en">fare product ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the fare product.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareProduct"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#destination_id">
    <rdfs:label xml:lang="en">destination ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the destination fare zone.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#fare_transfer_type">
    <rdfs:label xml:lang="en">fare transfer type</rdfs:label>
    <rdfs:comment xml:lang="en">How the cost of a transfer between two fare legs is computed: 0 = fare of the first leg plus the transfer fare, 1 = fare of the first leg plus the transfer fare plus the fare of the second leg, 2 = transfer fare only.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareTransferRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#rule_priority">
    <rdfs:label xml:lang="en">rule priority</rdfs:label>
    <rdfs:comment xml:lang="en">Priority used to choose among multiple matching fare leg rules.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareLegRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#definesLevelFor">
    <rdfs:label xml:lang="en">defines level for</rdfs:label>
    <rdfs:comment xml:lang="en">Links a level to a stop located on that level.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Level"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#ToStop">
    <rdfs:label xml:lang="en">to stop</rdfs:label>
    <rdfs:comment xml:lang="en">Links a pathway to the stop where the pathway ends.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_id">
    <rdfs:label xml:lang="en">stop ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the stop or location.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#booking_url">
    <rdfs:label xml:lang="en">booking URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL of the online booking interface.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#roadside_index">
    <rdfs:label xml:lang="en">roadside index</rdfs:label>
    <rdfs:comment xml:lang="en">Index that gives the side of the road on which the stop is located. This property extends GTFS: it is not a field of the GTFS reference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#start_pickup_drop_off_window">
    <rdfs:label xml:lang="en">start pickup drop off window</rdfs:label>
    <rdfs:comment xml:lang="en">Time at which the on-demand pickup or drop-off service becomes available at the location, location group or stop (HH:MM:SS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#amount">
    <rdfs:label xml:lang="en">amount</rdfs:label>
    <rdfs:comment xml:lang="en">The cost of the fare product. May be negative to represent transfer discounts. May be zero to represent a fare product that is free.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareProduct"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#saturday">
    <rdfs:label xml:lang="en">saturday</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the service runs on all Saturdays of the date range: 1 = yes, 0 = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#location_type">
    <rdfs:label xml:lang="en">location type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of the location: 0 (or empty) = stop or platform, 1 = station, 2 = entrance or exit, 3 = generic node, 4 = boarding area.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#departure_time">
    <rdfs:label xml:lang="en">departure time</rdfs:label>
    <rdfs:comment xml:lang="en">Departure time of the trip from the stop, in local time (HH:MM:SS). Values greater than 24:00:00 are used for trips that run after midnight.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_id">
    <rdfs:label xml:lang="en">route ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the route.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#isUnavailable">
    <rdfs:label xml:lang="en">is unavailable</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the stop is unavailable, for example because of a disruption. This property extends GTFS: it is not a field of the GTFS reference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasAgency">
    <rdfs:label xml:lang="en">has agency</rdfs:label>
    <rdfs:comment xml:lang="en">Links a route to the agency that operates it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#field_value">
    <rdfs:label xml:lang="en">field value</rdfs:label>
    <rdfs:comment xml:lang="en">Original field value used as the basis for the translation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Translation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#area_id">
    <rdfs:label xml:lang="en">area ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the area.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Area"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#level_id">
    <rdfs:label xml:lang="en">level ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the level.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Level"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isPartOf"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasRoute">
    <rdfs:label xml:lang="en">has route</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trip to the route it belongs to.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#is_authority">
    <rdfs:label xml:lang="en">is authority</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the organisation is the transport authority of the service: 1 = yes, 0 (or empty) = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#payment_method">
    <rdfs:label xml:lang="en">payment method</rdfs:label>
    <rdfs:comment xml:lang="en">When the fare must be paid: 0 = on board, 1 = before boarding.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareAttribute"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#transfer_duration">
    <rdfs:label xml:lang="en">transfer duration</rdfs:label>
    <rdfs:comment xml:lang="en">Length of time, in seconds, after which a transfer expires.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareAttribute"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#feed_version">
    <rdfs:label xml:lang="en">feed version</rdfs:label>
    <rdfs:comment xml:lang="en">Version identifier of the feed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasFareProduct">
    <rdfs:label xml:lang="en">has fare product</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare leg rule to the fare product that it applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareLegRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareProduct"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#transfer_type">
    <rdfs:label xml:lang="en">transfer type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of connection: 0 (or empty) = recommended transfer point, 1 = timed transfer, 2 = transfer that requires a minimum time (min_transfer_time), 3 = transfer not possible, 4 = in-seat transfer, 5 = in-seat transfer not allowed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Transfer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#attribution_email">
    <rdfs:label xml:lang="en">attribution email</rdfs:label>
    <rdfs:comment xml:lang="en">Email address for the attribution record.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#end_date">
    <rdfs:label xml:lang="en">end date</rdfs:label>
    <rdfs:comment xml:lang="en">Last date on which the service is active.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#pickup_type">
    <rdfs:label xml:lang="en">pickup type</rdfs:label>
    <rdfs:comment xml:lang="en">Pickup method at the stop: 0 (or empty) = regularly scheduled pickup, 1 = no pickup, 2 = phone the agency to arrange a pickup, 3 = coordinate with the driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#booking_type">
    <rdfs:label xml:lang="en">booking type</rdfs:label>
    <rdfs:comment xml:lang="en">When the booking must be made: 0 = real-time booking, 1 = up to the same day with prior notice, 2 = up to one or more days before travel.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#fare_product_name">
    <rdfs:label xml:lang="en">fare product name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the fare product.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareProduct"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasOriginStop">
    <rdfs:label xml:lang="en">has origin stop</rdfs:label>
    <rdfs:comment xml:lang="en">Links a transfer rule to the origin stop where the transfer begins.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Transfer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#network_name">
    <rdfs:label xml:lang="en">network name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the network.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Network"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#transfer_count">
    <rdfs:label xml:lang="en">transfer count</rdfs:label>
    <rdfs:comment xml:lang="en">Number of consecutive transfers covered by the rule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareTransferRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#isLocatedIn">
    <rdfs:label xml:lang="en">is located in</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop to a zone (location) in which it is located.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Location"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#attribution_url">
    <rdfs:label xml:lang="en">attribution URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL associated with the attribution record.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#prior_notice_last_time">
    <rdfs:label xml:lang="en">prior notice last time</rdfs:label>
    <rdfs:comment xml:lang="en">Latest time, on the last day on which a booking can be made, at which the booking must be made (HH:MM:SS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#continuous_drop_off">
    <rdfs:label xml:lang="en">continuous drop off</rdfs:label>
    <rdfs:comment xml:lang="en">Whether riders can alight anywhere along the path of the vehicle on the route: 0 = continuous stopping drop-off, 1 (or empty) = no continuous drop-off, 2 = phone the agency, 3 = coordinate with the driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#table_name">
    <rdfs:label xml:lang="en">table name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the GTFS table that contains the translated field: agency, stops, routes, trips, stop_times, pathways, levels, feed_info or attributions.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Translation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#servesStop">
    <rdfs:label xml:lang="en">serves stop</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop time to the stop that it serves.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#traversal_time">
    <rdfs:label xml:lang="en">traversal time</rdfs:label>
    <rdfs:comment xml:lang="en">Average time needed to walk through the pathway, in seconds.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#is_producer">
    <rdfs:label xml:lang="en">is producer</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the organisation produced the data of the feed: 1 = yes, 0 (or empty) = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#transfers">
    <rdfs:label xml:lang="en">transfers</rdfs:label>
    <rdfs:comment xml:lang="en">Number of transfers allowed with the fare: 0 = none, 1 = one transfer, 2 = two transfers. No value means that unlimited transfers are allowed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareAttribute"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#drop_off_message">
    <rdfs:label xml:lang="en">drop off message</rdfs:label>
    <rdfs:comment xml:lang="en">Message shown to riders for on-demand drop-off booking.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#agency_lang">
    <rdfs:label xml:lang="en">agency language</rdfs:label>
    <rdfs:comment xml:lang="en">Main language used by the agency, as an IETF BCP 47 language code (for example fr).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#info_url">
    <rdfs:label xml:lang="en">info URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL providing rider information about the booking rule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasOriginArea">
    <rdfs:label xml:lang="en">has origin area</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare leg rule to the origin area from which the fare leg starts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareLegRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Area"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#agency_url">
    <rdfs:label xml:lang="en">agency URL</rdfs:label>
    <rdfs:comment xml:lang="en">Public website URL of the agency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#currency_type">
    <rdfs:label xml:lang="en">currency type</rdfs:label>
    <rdfs:comment xml:lang="en">Currency of the price of the fare, as an ISO 4217 code (for example EUR).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareAttribute"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#attribution_phone">
    <rdfs:label xml:lang="en">attribution phone</rdfs:label>
    <rdfs:comment xml:lang="en">Phone number of the organisation credited by the attribution.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#agency_email">
    <rdfs:label xml:lang="en">agency email</rdfs:label>
    <rdfs:comment xml:lang="en">Email address of the agency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#belongsToTrip">
    <rdfs:label xml:lang="en">belongs to trip</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop time to the trip it belongs to.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#prior_notice_start_day">
    <rdfs:label xml:lang="en">prior notice start day</rdfs:label>
    <rdfs:comment xml:lang="en">First day before travel on which the booking can be made, counted in days before the day of service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#followsShape">
    <rdfs:label xml:lang="en">follows shape</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trip to the shape that its vehicle follows.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Shapes"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#min_transfer_time">
    <rdfs:label xml:lang="en">min transfer time</rdfs:label>
    <rdfs:comment xml:lang="en">Minimum transfer time, in seconds, required between services.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Transfer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#managedBy">
    <rdfs:label xml:lang="en">managed by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare to the agency that manages it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareAttribute"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#language">
    <rdfs:label xml:lang="en">language</rdfs:label>
    <rdfs:comment xml:lang="en">Language of the translation, as an IETF BCP 47 language code.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Translation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_lon">
    <rdfs:label xml:lang="en">stop longitude</rdfs:label>
    <rdfs:comment xml:lang="en">Longitude of the stop or location.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stop_desc">
    <rdfs:label xml:lang="en">stop description</rdfs:label>
    <rdfs:comment xml:lang="en">Description of the stop or location.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#shape_pt_sequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">shape point sequence</rdfs:label>
    <rdfs:comment xml:lang="en">Sequence number of a point within the shape.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Shapes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#stair_count">
    <rdfs:label xml:lang="en">stair count</rdfs:label>
    <rdfs:comment xml:lang="en">Number of stairs along the pathway.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#continuous_pickup">
    <rdfs:label xml:lang="en">continuous pickup</rdfs:label>
    <rdfs:comment xml:lang="en">Whether riders can board anywhere along the path of the vehicle on the route: 0 = continuous stopping pickup, 1 (or empty) = no continuous pickup, 2 = phone the agency, 3 = coordinate with the driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#trip_headsign">
    <rdfs:label xml:lang="en">trip headsign</rdfs:label>
    <rdfs:comment xml:lang="en">Headsign displayed to riders for the trip.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasStartTimeframeGroup">
    <rdfs:label xml:lang="en">has start timeframe group</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare leg rule to the timeframe group that applies to the fare validation event at the start of the fare leg.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareLegRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#TimeFrame"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#origin_id">
    <rdfs:label xml:lang="en">origin ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the origin fare zone.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#shape_id">
    <rdfs:label xml:lang="en">shape ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the shape.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Shapes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#fromStop">
    <rdfs:label xml:lang="en">from stop</rdfs:label>
    <rdfs:comment xml:lang="en">Links a pathway to the stop where the pathway starts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#feed_lang">
    <rdfs:label xml:lang="en">feed language</rdfs:label>
    <rdfs:comment xml:lang="en">Default language of the text of the feed, as an IETF BCP 47 language code.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#record_id">
    <rdfs:label xml:lang="en">record ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the record containing the field to translate.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Translation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#tts_stop_name">
    <rdfs:label xml:lang="en">text-to-speech stop name</rdfs:label>
    <rdfs:comment xml:lang="en">Text-to-speech friendly version of the stop name.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#shape_pt_lon">
    <rdfs:label xml:lang="en">shape point longitude</rdfs:label>
    <rdfs:comment xml:lang="en">Longitude of a point in the shape geometry.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Shapes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#drop_off_type">
    <rdfs:label xml:lang="en">drop off type</rdfs:label>
    <rdfs:comment xml:lang="en">Drop-off method at the stop: 0 (or empty) = regularly scheduled drop-off, 1 = no drop-off, 2 = phone the agency to arrange a drop-off, 3 = coordinate with the driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#leg_group_id">
    <rdfs:label xml:lang="en">leg group ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the fare leg rule group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareLegRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#usesFareAttribute">
    <rdfs:label xml:lang="en">uses fare attribute</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fare rule to the fare that it applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareAttribute"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#prior_notice_duration_min">
    <rdfs:label xml:lang="en">prior notice duration min</rdfs:label>
    <rdfs:comment xml:lang="en">Minimum number of minutes before travel by which the booking must be made.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#isServedAtTime">
    <rdfs:label xml:lang="en">is served at time</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop to a stop time at which it is served.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#platform_code">
    <rdfs:label xml:lang="en">platform code</rdfs:label>
    <rdfs:comment xml:lang="en">Platform identifier shown to riders.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#contains_id">
    <rdfs:label xml:lang="en">contains ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of a fare zone that must be traversed for the fare rule to apply.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareRule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#starttime">
    <rdfs:label xml:lang="en">start time (frequency)</rdfs:label>
    <rdfs:comment xml:lang="en">Time at which the first vehicle departs from the first stop of the trip with the given headway (HH:MM:SS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Frequency"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#trip_short_name">
    <rdfs:label xml:lang="en">trip short name</rdfs:label>
    <rdfs:comment xml:lang="en">Short public name or code of the trip.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#wheelchair_boarding">
    <rdfs:label xml:lang="en">wheelchair boarding</rdfs:label>
    <rdfs:comment xml:lang="en">Wheelchair boarding at the stop: 0 (or empty) = no information, 1 = some vehicles at this stop can be boarded by a rider in a wheelchair, 2 = wheelchair boarding is not possible.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#AppliesToAgency">
    <rdfs:label xml:lang="en">applies to agency</rdfs:label>
    <rdfs:comment xml:lang="en">Links an attribution record to the agency it applies to.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Agency"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#isScheduledBy">
    <rdfs:label xml:lang="en">is scheduled by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trip to the frequency (headway) definition that schedules it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Frequency"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#currency">
    <rdfs:label xml:lang="en">currency</rdfs:label>
    <rdfs:comment xml:lang="en">Currency of the amount of the fare product, as an ISO 4217 code (for example EUR).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareProduct"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasDestinationStop">
    <rdfs:label xml:lang="en">has destination stop</rdfs:label>
    <rdfs:comment xml:lang="en">Links a transfer rule to the destination stop where the transfer ends.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Transfer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#end_time">
    <rdfs:label xml:lang="en">end time (timeframe)</rdfs:label>
    <rdfs:comment xml:lang="en">End of the time of day of the timeframe (HH:MM:SS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#TimeFrame"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#price">
    <rdfs:label xml:lang="en">price</rdfs:label>
    <rdfs:comment xml:lang="en">Price of the fare attribute.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FareAttribute"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#is_bidirectional">
    <rdfs:label xml:lang="en">is bidirectional</rdfs:label>
    <rdfs:comment xml:lang="en">Direction in which the pathway can be used: 0 = only from the origin to the destination stop, 1 = in both directions.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#timepoint">
    <rdfs:label xml:lang="en">timepoint</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the arrival and departure times of the stop time are exact (1) or approximate or interpolated (0).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasException">
    <rdfs:label xml:lang="en">has date exception</rdfs:label>
    <rdfs:comment xml:lang="en">Links a service calendar to a date exception that adds or removes the service on a given date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#CalendarDates"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#wednesday">
    <rdfs:label xml:lang="en">wednesday</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the service runs on all Wednesdays of the date range: 1 = yes, 0 = no.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Calendar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/gtfs#hasBookingRule">
    <rdfs:label xml:lang="en">has booking rule</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop time record to the booking rule that governs it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#StopTimes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#is_bus_stop">
    <rdfs:label xml:lang="en">is bus stop</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the stop is a stop of the regular bus network. This property extends GTFS: it is not a field of the GTFS reference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#organization_name">
    <rdfs:label xml:lang="en">organization name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the organization referenced by the attribution.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Attribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#feed_publisher_url">
    <rdfs:label xml:lang="en">feed publisher URL</rdfs:label>
    <rdfs:comment xml:lang="en">Website URL of the feed publisher.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#FeedInfo"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_long_name">
    <rdfs:label xml:lang="en">route long name</rdfs:label>
    <rdfs:comment xml:lang="en">Long public name of the route.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_text_color">
    <rdfs:label xml:lang="en">route text color</rdfs:label>
    <rdfs:comment xml:lang="en">Colour of the text drawn on the route colour, as a six-digit hexadecimal number.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#min_width">
    <rdfs:label xml:lang="en">min width</rdfs:label>
    <rdfs:comment xml:lang="en">Minimum width of the pathway, in metres.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#route_sort_order">
    <rdfs:label xml:lang="en">route sort order</rdfs:label>
    <rdfs:comment xml:lang="en">Display order of the route for rider-facing presentation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#signposted_as">
    <rdfs:label xml:lang="en">signposted as</rdfs:label>
    <rdfs:comment xml:lang="en">Public-facing text shown on signs for the pathway.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/gtfs#max_slope">
    <rdfs:label xml:lang="en">max slope</rdfs:label>
    <rdfs:comment xml:lang="en">Maximum slope ratio of the pathway: positive upwards, negative downwards (for example 0.083 for an 8.3 % slope).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Pathway"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/language"/>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#StopTimes">
    <rdfs:label xml:lang="en">stop time</rdfs:label>
    <rdfs:comment xml:lang="en">The scheduled time at which a trip serves a stop: arrival time, departure time and position of the stop in the trip. It corresponds to the file stop_times.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#stop_timestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Stops">
    <rdfs:label xml:lang="en">stop</rdfs:label>
    <rdfs:comment xml:lang="en">A stop or a station where vehicles pick up or drop off riders. Stops of the regular network and stops of the DRT service are both instances of this class, so both services share the same stops. It corresponds to the file stops.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#stopstxt"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n886473b8ac84421daf77925479cdcf7bb5">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Network">
    <rdfs:label xml:lang="en">network</rdfs:label>
    <rdfs:comment xml:lang="en">A group of routes, used in particular to define fares by network. It corresponds to the file networks.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#networkstxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#TimeFrame">
    <rdfs:label xml:lang="en">timeframe</rdfs:label>
    <rdfs:comment xml:lang="en">A time period (time of day and service days) during which a fare applies. It corresponds to the file timeframes.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#timeframestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#LocationGroup">
    <rdfs:label xml:lang="en">location group</rdfs:label>
    <rdfs:comment xml:lang="en">A group of stops where a rider may request a pickup or a drop-off (GTFS-Flex). It corresponds to the file location_groups.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#location_groupstxt"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n886473b8ac84421daf77925479cdcf7bb2">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#FareMedia">
    <rdfs:label xml:lang="en">fare medium</rdfs:label>
    <rdfs:comment xml:lang="en">A medium that holds or validates a fare product, such as a smart card, a paper ticket or a mobile app. It corresponds to the file fare_media.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#fare_mediatxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Shapes">
    <rdfs:label xml:lang="en">shape</rdfs:label>
    <rdfs:comment xml:lang="en">The path that a vehicle travels along a route, as an ordered sequence of points. It corresponds to the file shapes.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#shapestxt"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#BookingRule">
    <rdfs:label xml:lang="en">booking rule</rdfs:label>
    <rdfs:comment xml:lang="en">The booking rules of a service that must be booked in advance, such as on-demand transport: how, when and how far ahead a pickup or drop-off must be booked. It corresponds to the file booking_rules.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#booking_rulestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Trips">
    <rdfs:label xml:lang="en">trip</rdfs:label>
    <rdfs:comment xml:lang="en">A journey of a vehicle along a route at a given time, serving a sequence of stops. It corresponds to the file trips.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#tripstxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Agency">
    <rdfs:label xml:lang="en">agency</rdfs:label>
    <rdfs:comment xml:lang="en">A transit agency whose services are described in the feed. It corresponds to the file agency.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#agencytxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#FareTransferRule">
    <rdfs:label xml:lang="en">fare transfer rule</rdfs:label>
    <rdfs:comment xml:lang="en">A rule for the cost of a transfer between two fare legs (GTFS-Fares v2). It corresponds to the file fare_transfer_rules.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#fare_transfer_rulestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Area">
    <rdfs:label xml:lang="en">area</rdfs:label>
    <rdfs:comment xml:lang="en">A geographical area that groups stops, used to define fares by origin and destination areas. It corresponds to the file areas.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#areastxt"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n886473b8ac84421daf77925479cdcf7bb3">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Location">
    <rdfs:label xml:lang="en">flex location</rdfs:label>
    <rdfs:comment xml:lang="en">A zone, given as a GeoJSON polygon, where riders can request a pickup or a drop-off (GTFS-Flex). It corresponds to the file locations.geojson of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#locationsgeojson"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n886473b8ac84421daf77925479cdcf7bb1">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Level">
    <rdfs:label xml:lang="en">level</rdfs:label>
    <rdfs:comment xml:lang="en">A physical level of a station, such as a floor of a multimodal station or of a multi-storey car park. It corresponds to the file levels.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#levelstxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Routes">
    <rdfs:label xml:lang="en">route</rdfs:label>
    <rdfs:comment xml:lang="en">A public transit line: a group of trips shown to riders as a single service. It corresponds to the file routes.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#routestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Translation">
    <rdfs:label xml:lang="en">translation</rdfs:label>
    <rdfs:comment xml:lang="en">A translation of a rider-facing text field of the feed into another language. It corresponds to the file translations.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#translationstxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Transfer">
    <rdfs:label xml:lang="en">transfer</rdfs:label>
    <rdfs:comment xml:lang="en">A rule for connections between routes, trips or stops, such as a minimum transfer time. It corresponds to the file transfers.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#transferstxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#FareLegRule">
    <rdfs:label xml:lang="en">fare leg rule</rdfs:label>
    <rdfs:comment xml:lang="en">A fare rule for one leg of a journey (GTFS-Fares v2), defined by origin and destination areas, network and time frames. It corresponds to the file fare_leg_rules.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#fare_leg_rulestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#FareRule">
    <rdfs:label xml:lang="en">fare rule</rdfs:label>
    <rdfs:comment xml:lang="en">A rule that says when a fare applies, based on the route, the origin, the destination or the zones a rider passes through (GTFS-Fares v1). It corresponds to the file fare_rules.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#fare_rulestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#FeedInfo">
    <rdfs:label xml:lang="en">feed information</rdfs:label>
    <rdfs:comment xml:lang="en">Information about the GTFS feed itself: publisher, language, version and validity period. It corresponds to the file feed_info.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#feed_infotxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Pathway">
    <rdfs:label xml:lang="en">pathway</rdfs:label>
    <rdfs:comment xml:lang="en">A link between two locations of a station, such as a walkway, stairs, an escalator or an elevator. It corresponds to the file pathways.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#pathwaystxt"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n886473b8ac84421daf77925479cdcf7bb4">
        <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#CalendarDates">
    <rdfs:label xml:lang="en">calendar date exception</rdfs:label>
    <rdfs:comment xml:lang="en">An exception to a service calendar on a given date, for example a service added or removed on a public holiday. It corresponds to the file calendar_dates.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#calendar_datestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#FareProduct">
    <rdfs:label xml:lang="en">fare product</rdfs:label>
    <rdfs:comment xml:lang="en">A fare product that riders can buy, such as a single ticket or a pass. It corresponds to the file fare_products.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#fare_productstxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Frequency">
    <rdfs:label xml:lang="en">frequency</rdfs:label>
    <rdfs:comment xml:lang="en">A headway-based service, whose trips run at regular intervals instead of following a fixed timetable. It corresponds to the file frequencies.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#frequenciestxt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Attribution">
    <rdfs:label xml:lang="en">attribution</rdfs:label>
    <rdfs:comment xml:lang="en">An organisation credited for the data of the feed, such as its producer, operator or authority, with copyright and licence information. It corresponds to the file attributions.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#attributionstxt"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature">
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#Calendar">
    <rdfs:label xml:lang="en">service calendar</rdfs:label>
    <rdfs:comment xml:lang="en">The days of the week on which a service runs, between a start date and an end date. It corresponds to the file calendar.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#calendartxt"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
  </owl:Class>
  <rdf:Description rdf:about="https://orcid.org/0000-0002-1599-9326">
    <rdfs:label>Alain Bouju</rdfs:label>
  </rdf:Description>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/gtfs#FareAttribute">
    <rdfs:label xml:lang="en">fare attribute</rdfs:label>
    <rdfs:comment xml:lang="en">A fare (GTFS-Fares v1): its price, currency, payment method and transfer conditions. It corresponds to the file fare_attributes.txt of the GTFS reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
    <rdfs:seeAlso rdf:resource="https://gtfs.org/documentation/schedule/reference/#fare_attributestxt"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry"/>
  <rdf:Description rdf:about="https://orcid.org/0000-0002-7792-8953">
    <rdfs:label>Esma Talhi</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0009-0000-4334-4557">
    <rdfs:label>Nourelhouda El Gadi</rdfs:label>
  </rdf:Description>
</rdf:RDF>
