    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#exact_times -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#exact_times">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Frequency"/>
