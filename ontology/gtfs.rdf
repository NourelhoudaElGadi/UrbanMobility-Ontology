        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Identifier of a fare zone that must be traversed for the fare rule to apply.</rdfs:comment>
    </owl:DatatypeProperty>
    


