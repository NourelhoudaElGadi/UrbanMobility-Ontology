    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#duration_limit -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#duration_limit">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareTransferRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment>Duration limit, in seconds, for the transfer rule.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#duration_limit_type -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#duration_limit_type">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareTransferRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Method used to interpret the transfer duration limit.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#end_date -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#end_date">
