<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/hp/ontologies/2024/transport#"
     xml:base="http://www.semanticweb.org/hp/ontologies/2024/transport"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:GTFS="http://www.semanticweb.org/hp/ontologies/2024/transport#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/"
     xmlns:geosparql="http://www.opengis.net/ont/geosparql#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport">
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#AppliesToAgency -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#AppliesToAgency">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Attribution"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Agency"/>
        <rdfs:comment>indicating that the attribution is managed or applicable to the specific agency.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#AppliesToTrip -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#AppliesToTrip">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Attribution"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:comment>the attribution applies to the trip.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#ToStop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#ToStop">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Pathway"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>Links a pathway to the stop where the pathway ends.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#appliesToLegGroup -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#appliesToLegGroup">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareTransferRule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareLegRule"/>
        <rdfs:comment>Indicates which segment group (defined by fare_leg_rules.leg group_id) a transfer rule (fare_transfer_rules.from_leg_group_id and fare_transfer_rules.to_leg_group_id) applied</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#appliesToRoute -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#appliesToRoute">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Attribution"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:comment>Links an attribution record to the route to which it applies.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#appliesTotrip -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#appliesTotrip">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#BookingRule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:comment>Indicates that booking rules apply to trips</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#belongsToTrip -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#belongsToTrip">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#StopTimes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:comment>It indicates when the trips  passes through a stop</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#definesLevelFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#definesLevelFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Level"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>indicating the specific level to which the stops belong.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#followsShape -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#followsShape">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Shapes"/>
        <rdfs:comment>It indicates that the trip follows a geographical shape.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#fromStop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#fromStop">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Pathway"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>Links a pathway to the stop where the pathway starts.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasAgency -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasAgency">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Agency"/>
        <rdfs:comment>line of network transport has differents agency</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasBookingRule -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasBookingRule">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#StopTimes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#BookingRule"/>
        <rdfs:comment>Links a stop time record to the booking rule that governs it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasDestinationArea -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasDestinationArea">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareLegRule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Area"/>
        <rdfs:comment>Links a fare leg rule to the destination area at which the fare leg ends</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasDestinationRoute -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasDestinationRoute">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:comment>Links a transfer rule to the destination route to which the transfer leads</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasDestinationStop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasDestinationStop">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>Links a transfer rule to the destination stop where the transfer ends</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasDestinationTrip -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasDestinationTrip">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:comment>Links a transfer rule to the destination trip to which the transfer leads</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasEndTimeframeGroup -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasEndTimeframeGroup">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareLegRule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#TimeFrame"/>
        <rdfs:comment>Links a fare leg rule to the timeframe group that applies to the fare validation event at the end of the fare leg</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#isExceptionOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#isExceptionOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#CalendarDates"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Calendar"/>
        <rdfs:comment>indicates exceptions or variations in the Calendar</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasFareProduct -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasFareProduct">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareLegRule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareProduct"/>
        <rdfs:comment>andicates the fare product applied in the leg rule.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasFareRule -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasFareRule">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareRule"/>
        <rdfs:comment>It describes the fare rule applicable to a route.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Location"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasOriginArea -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasOriginArea">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareLegRule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Area"/>
        <rdfs:comment>Links a fare leg rule to the origin area from which the fare leg starts.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasOriginRoute -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasOriginRoute">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:comment>Links a transfer rule to the origin route from which the transfer starts</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasOriginStop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasOriginStop">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>Links a transfer rule to the origin stop where the transfer begins</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasOriginTrip -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasOriginTrip">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:comment>Links a transfer rule to the origin trip from which the transfer starts</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasParentStation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasParentStation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>Associates a stop with a parent station . It indicates the main stop to which another stop is attached.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasRoute -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasRoute">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasStartTimeframeGroup -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasStartTimeframeGroup">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareLegRule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#TimeFrame"/>
        <rdfs:comment>Links a fare leg rule to the timeframe group that applies to the fare validation event at the start of the fare leg</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasStop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasStop">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#LocationGroup"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>A group location has differents stops</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasStopTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasStopTime">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#StopTimes"/>
        <rdfs:comment>a trips has a stop times</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#isApplicableDuring -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#isApplicableDuring">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#TimeFrame"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Calendar"/>
        <rdfs:comment>Indicates that the time period described by timeframes applies to the service days defined in the calendar.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#isLocatedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#isLocatedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Location"/>
        <rdfs:comment>This relation defines that a stops is located in differents location</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#isScheduledBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#isScheduledBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Frequency"/>
        <rdfs:comment>A trip  is scheduled by a frequency.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#isServedAtTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#isServedAtTime">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#StopTimes"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#managedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#managedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareAttribute"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Agency"/>
        <rdfs:comment>indicates that the agency manages the fare attribute.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#offersupportTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#offersupportTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareMedia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareProduct"/>
        <rdfs:comment>It indicates the fare support type offered to the fare product.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#operatesOnRoute -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#operatesOnRoute">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:comment>represents that Trips operate on a Route</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#partOfNetwork -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#partOfNetwork">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Network"/>
        <rdfs:comment>It indicates that the route is part of a network.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#servesStop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#servesStop">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#StopTimes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>indicates what time the stop is served</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#stopInArea -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#stopInArea">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Area"/>
        <rdfs:comment>Links a stop to an area that contains or groups it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#stopInLocationGroup -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#stopInLocationGroup">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#LocationGroup"/>
        <rdfs:comment>Links a stop to the location group to which it belongs.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#usesFareAttribute -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#usesFareAttribute">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareRule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareAttribute"/>
        <rdfs:comment>describes which attribute is used by the fare rule</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#usesService -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#usesService">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Calendar"/>
        <rdfs:comment>Represents that Trips use a Service (Calandar)</rdfs:comment>
    </owl:ObjectProperty>
    


