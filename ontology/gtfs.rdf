    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#attribution_id -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#attribution_id">
