        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Identifier of the fare definition</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#fare_media_id -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#fare_media_id">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareMedia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
