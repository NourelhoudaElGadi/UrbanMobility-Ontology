    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#fare_media_name -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#fare_media_name">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareMedia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
