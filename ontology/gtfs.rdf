        <rdfs:comment>Indicates whether the stop time is exact or approximate.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#transfer_count -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#transfer_count">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareTransferRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Number of consecutive transfers covered by the rule.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#transfer_duration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#transfer_duration">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareAttribute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Maximum time window during which transfers remain valid.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#transfer_type -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#transfer_type">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Type of transfer rule applied between the specified locations or trips.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#transfers -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#transfers">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareAttribute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Number of transfers allowed by the fare attribute.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#translation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#translation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Translation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Translated value provided for the selected field.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#traversal_time -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#traversal_time">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Pathway"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment>Average traversal time of the pathway in seconds.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#trip_headsign -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#trip_headsign">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Headsign displayed to riders for the trip.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#trip_id -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#trip_id">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifier of the trip.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#trip_short_name -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#trip_short_name">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Short public name or code of the trip.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#tts_stop_name -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#tts_stop_name">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Text-to-speech friendly version of the stop name.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#tuesday -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#tuesday">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Calendar"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Indicates whether the service runs on Tuesday.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#wednesday -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#wednesday">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Calendar"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Indicates whether the service runs on Wednesday.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#wheelchair_accessible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#wheelchair_accessible">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Indicates whether the trip is wheelchair accessible.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#wheelchair_boarding -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#wheelchair_boarding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Indicates wheelchair boarding accessibility at the stop or location.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#zone_id -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#zone_id">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Identifier of the fare zone associated with the stop.</rdfs:comment>
    </owl:DatatypeProperty>
    


