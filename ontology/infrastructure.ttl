Infrastructure:IsPartOfStreet a owl:ObjectProperty ;
    rdfs:label "is part of street"@en ;
    rdfs:comment "Links a road segment to the street it belongs to. It specialises the spatial relation geosparql:sfWithin."@en ;
    rdfs:domain Infrastructure:Road_segment ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range Infrastructure:Streets ;
    rdfs:subPropertyOf geosparql:sfWithin .

Infrastructure:Pedestrians a owl:Class ;
    rdfs:label "pedestrian"@en ;
    rdfs:comment "People walking along streets, crossing roads or using sidewalks."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> .

geosparql:wktLiteral a rdfs:Datatype .

Infrastructure:DRT_Shuttle a owl:Class ;
    rdfs:label "DRT shuttle"@en ;
    rdfs:comment "A vehicle temporarily assigned to the demand-responsive transport (DRT) service. It can stop playing this role without ceasing to be the same vehicle."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:vehicle .

Infrastructure:Sidewalk a owl:Class ;
    rdfs:label "sidewalk"@en ;
    rdfs:comment "A paved pathway adjacent to a street, intended for pedestrian use."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

geosparql:sfTouches a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:sfWithin a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

Infrastructure:AreaOfInterest a owl:Class ;
    rdfs:label "area of interest"@en ;
    rdfs:comment "A functional urban area of interest, such as a school, commercial or residential zone."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Charging_station a owl:Class ;
    rdfs:label "charging station"@en ;
    rdfs:comment "A place where electric vehicles, including DRT shuttles, can be charged."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:GranularityLevel a owl:Class ;
    rdfs:label "granularity level"@en ;
    rdfs:comment "The level of spatial granularity of an urban entity: micro (street level), meso (neighbourhood level) or macro (municipality level)."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> .

Infrastructure:Obstacles a owl:Class ;
    rdfs:label "obstacle"@en ;
    rdfs:comment "An object or a structure on the street that may block or slow down vehicles or pedestrians."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Traffic_light a owl:Class ;
    rdfs:label "traffic light"@en ;
    rdfs:comment "A traffic signal that controls the movement of vehicles and pedestrians with red, amber and green lights."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:Traffic_control .

Infrastructure:Industrial_Zone a owl:Class ;
    rdfs:label "industrial zone"@en ;
    rdfs:comment "An area where economic activities, such as industry, are concentrated."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Parking a owl:Class ;
    rdfs:label "parking area"@en ;
    rdfs:comment "A designated area for parking vehicles, such as a car park or parking spaces."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Traffic_control a owl:Class ;
    rdfs:label "traffic control"@en ;
    rdfs:comment "The signs, traffic lights and road markings that regulate traffic and warn or inform drivers and pedestrians."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Building a owl:Class ;
    rdfs:label "building"@en ;
    rdfs:comment "A building located along a street."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Traffic_signs a owl:Class ;
    rdfs:label "traffic sign"@en ;
    rdfs:comment "A road sign giving traffic information, such as a speed limit, a restriction or a direction."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:Traffic_control .

Infrastructure:Intersection a owl:Class ;
    rdfs:label "intersection"@en ;
    rdfs:comment "A junction where several streets meet, where vehicles and pedestrians follow signage to take the right direction."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Municipalities a owl:Class ;
    rdfs:label "municipality"@en ;
    rdfs:comment "A municipality: the territory of a city or a town, delimited in space and represented by a polygon or a multipolygon. Its identity is given by its spatial extent and its boundaries."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Neighborhood a owl:Class ;
    rdfs:label "neighbourhood"@en ;
    rdfs:comment "A geographically delimited urban area that comprises streets, points of interest and other urban infrastructure elements. A neighbourhood is identified by its spatial extent and its boundaries in the adopted urban zoning; a change in geometric precision does not alter its identity when the area represented stays the same."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Roundabout a owl:Class ;
    rdfs:label "roundabout"@en ;
    rdfs:comment "A roundabout: a circular intersection where traffic flows around a central island."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:Sensor a owl:Class ;
    rdfs:label "sensor"@en ;
    rdfs:comment "A device that collects traffic data, such as vehicle speed, traffic volume or density on a road."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:vehicle a owl:Class ;
    rdfs:label "vehicle"@en ;
    rdfs:comment "A motorised or non-motorised means of transport used on roads to move people or goods."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:UrbanEntity .

Infrastructure:Road_markings a owl:Class ;
    rdfs:label "road marking"@en ;
    rdfs:comment "Road surface markings that guide traffic, such as lane lines, crosswalks and directional arrows."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf geosparql:Feature,
        Infrastructure:UrbanEntity .

geosparql:hasGeometry a owl:ObjectProperty ;
    rdfs:domain geosparql:Feature ;
    rdfs:range geosparql:Geometry .

geosparql:Geometry a owl:Class ;
    rdfs:subClassOf geosparql:SpatialObject .

Infrastructure:Road_segment a owl:Class ;
    rdfs:label "road segment"@en ;
    rdfs:comment "A portion of road between two reference points, such as intersections or stops. Its identity is determined by its position, its end points and the segmentation of the road network: correcting its coordinates does not create a new segment, whereas splitting or merging segments does."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

Infrastructure:UrbanEntity a owl:Class ;
    rdfs:label "urban entity"@en ;
    rdfs:comment "Any entity of the urban and peri-urban environment considered in mobility modelling. It is the top class of the infrastructure module."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> .

geosparql:Feature a owl:Class ;
    rdfs:subClassOf geosparql:SpatialObject .

Infrastructure:Streets a owl:Class ;
    rdfs:label "street"@en ;
    rdfs:comment "A street used by vehicles and pedestrians, made of one or more road segments."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature,
        Infrastructure:UrbanEntity .

geosparql:SpatialObject a owl:Class .

<https://w3id.org/urbanmobility/infrastructure> a owl:Ontology ;
    dcterms:bibliographicCitation "Nourelhouda El Gadi, Esma Talhi, Alain Bouju (2026). Urban-Mobility-Ontology (version 1.1.0). Zenodo. https://doi.org/10.5281/zenodo.20054329" ;
    dcterms:created "2024-07"^^xsd:gYearMonth ;
    dcterms:creator <https://orcid.org/0000-0002-1599-9326>,
        <https://orcid.org/0000-0002-7792-8953>,
        <https://orcid.org/0009-0000-4334-4557> ;
    dcterms:description "Module of the Urban-Mobility-Ontology that represents the urban environment in which public transport services and autonomous shuttles operate: road segments, streets, intersections, roundabouts, road markings, traffic controls, sensors, buildings, neighbourhoods and municipalities, together with vehicles and pedestrians. Urban entities are organised in three levels of granularity: micro (street level), meso (neighbourhood level) and macro (municipality level). Spatial classes are GeoSPARQL features."@en ;
    dcterms:identifier <https://doi.org/10.5281/zenodo.20054329> ;
    dcterms:isPartOf <https://w3id.org/urbanmobility/> ;
    dcterms:language "en" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-27"^^xsd:date ;
    dcterms:title "Urban-Mobility-Ontology: Urban infrastructure module"@en ;
    vann:preferredNamespacePrefix "Infrastructure" ;
    vann:preferredNamespaceUri "https://w3id.org/urbanmobility/infrastructure#"^^xsd:anyURI ;
    owl:imports <http://www.opengis.net/ont/geosparql> ;
    owl:priorVersion <http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation> ;
    owl:versionIRI <https://w3id.org/urbanmobility/infrastructure/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    foaf:homepage <https://nourelhoudaelgadi.github.io/UrbanMobility-Ontology/infrastructure.html> .

