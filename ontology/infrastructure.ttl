@prefix Infrastructure: <https://w3id.org/urbanmobility/infrastructure#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:isPartOf a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

geosparql:ehContains a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:ehCoveredBy a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:ehCovers a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:ehInside a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:ehMeet a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:ehOverlap a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:rcc8ec a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:rcc8ntpp a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:rcc8ntppi a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:rcc8po a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:rcc8tpp a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:rcc8tppi a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:sfContains a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:sfCrosses a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:sfDisjoint a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

geosparql:sfOverlaps a owl:ObjectProperty ;
    rdfs:domain geosparql:SpatialObject ;
    rdfs:range geosparql:SpatialObject .

foaf:homepage a owl:AnnotationProperty .

Infrastructure:AdressBat a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "building address"@en ;
    rdfs:comment "Postal address of the building."@en ;
    rdfs:domain Infrastructure:Building ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:Aggregates a owl:ObjectProperty ;
    rdfs:label "aggregates"@en ;
    rdfs:comment "Links an urban entity to a finer-grained entity that it groups, for example a neighbourhood and its streets."@en ;
    rdfs:domain Infrastructure:UrbanEntity ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range Infrastructure:UrbanEntity .

Infrastructure:Arrow_markings a owl:Class ;
    rdfs:label "arrow marking"@en ;
    rdfs:comment "Directional arrows painted on the road surface to indicate traffic flow and vehicle movements."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:Road_markings .

Infrastructure:Bicycle_lane_marking a owl:Class ;
    rdfs:label "bicycle lane marking"@en ;
    rdfs:comment "Ground markings indicating a lane or a space reserved for cyclists, with specific symbols or signs."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:Road_markings .

Infrastructure:Blocks a owl:ObjectProperty ;
    rdfs:label "blocks"@en ;
    rdfs:comment "Links an obstacle to the road segment that it blocks."@en ;
    rdfs:domain Infrastructure:Obstacles ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range Infrastructure:Road_segment .

Infrastructure:Bus a owl:Class ;
    rdfs:label "bus"@en ;
    rdfs:comment "A road vehicle that runs on fixed routes for public or private transport."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:vehicle .

Infrastructure:Cars a owl:Class ;
    rdfs:label "car"@en ;
    rdfs:comment "A four-wheeled motor vehicle, used mainly for personal transport."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:vehicle .

Infrastructure:Category_poi a owl:DatatypeProperty ;
    rdfs:label "area of interest category"@en ;
    rdfs:comment "Category of the area of interest."@en ;
    rdfs:domain Infrastructure:AreaOfInterest ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:Code_Postal a owl:DatatypeProperty ;
    rdfs:label "postal code"@en ;
    rdfs:comment "Postal code of the municipality."@en ;
    rdfs:domain Infrastructure:Municipalities ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:CurvatureSegment a owl:DatatypeProperty ;
    rdfs:label "segment curvature"@en ;
    rdfs:comment "Curvature of the road segment."@en ;
    rdfs:domain Infrastructure:Road_segment ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:CurvatureTotal a owl:DatatypeProperty ;
    rdfs:label "total curvature"@en ;
    rdfs:comment "Total curvature accumulated along the street."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:EquippedBy a owl:ObjectProperty ;
    rdfs:label "equipped with"@en ;
    rdfs:comment "Links a road segment to a traffic control device (a sign or a light) installed on it."@en ;
    rdfs:domain Infrastructure:Road_segment ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range Infrastructure:Traffic_control .

Infrastructure:HasIntersection a owl:ObjectProperty ;
    rdfs:label "has intersection"@en ;
    rdfs:comment "Links a street to an intersection located on it."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range Infrastructure:Intersection .

Infrastructure:HasSegments a owl:ObjectProperty ;
    rdfs:label "has road segment"@en ;
    rdfs:comment "Links a street to one of its road segments."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range Infrastructure:Road_segment ;
    owl:inverseOf Infrastructure:IsPartOfStreet .

Infrastructure:Hospital a owl:Class ;
    rdfs:label "hospital"@en ;
    rdfs:comment "A hospital building, an important destination of DRT trips."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf geosparql:Feature,
        Infrastructure:Building .

Infrastructure:ID_Capteur a owl:DatatypeProperty ;
    rdfs:label "sensor ID"@en ;
    rdfs:comment "Identifier of the sensor."@en ;
    rdfs:domain Infrastructure:Sensor ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:integer .

Infrastructure:IdIntersection a owl:DatatypeProperty ;
    rdfs:label "intersection ID"@en ;
    rdfs:comment "Identifier of the intersection."@en ;
    rdfs:domain Infrastructure:Intersection ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:IdMarquage a owl:DatatypeProperty ;
    rdfs:label "road marking ID"@en ;
    rdfs:comment "Identifier of the road marking."@en ;
    rdfs:domain Infrastructure:Road_markings ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:integer .

Infrastructure:IdRoundabout a owl:DatatypeProperty ;
    rdfs:label "roundabout ID"@en ;
    rdfs:comment "Identifier of the roundabout."@en ;
    rdfs:domain Infrastructure:Roundabout ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:IdSecteur a owl:DatatypeProperty ;
    rdfs:label "industrial zone ID"@en ;
    rdfs:comment "Identifier of the industrial zone."@en ;
    rdfs:domain Infrastructure:Industrial_Zone ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:integer .

Infrastructure:IdSegment a owl:DatatypeProperty ;
    rdfs:label "road segment ID"@en ;
    rdfs:comment "Identifier of the road segment."@en ;
    rdfs:domain Infrastructure:Road_segment ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:Id_Feux a owl:DatatypeProperty ;
    rdfs:label "traffic light ID"@en ;
    rdfs:comment "Identifier of the traffic light."@en ;
    rdfs:domain Infrastructure:Traffic_light ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:integer .

Infrastructure:Id_pan a owl:DatatypeProperty ;
    rdfs:label "traffic sign ID"@en ;
    rdfs:comment "Identifier of the traffic sign."@en ;
    rdfs:domain Infrastructure:Traffic_signs ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:integer .

Infrastructure:Id_rue a owl:DatatypeProperty ;
    rdfs:label "street ID"@en ;
    rdfs:comment "Identifier of the street."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:IsPartOfNeighborhood a owl:ObjectProperty ;
    rdfs:label "is part of neighbourhood"@en ;
    rdfs:comment "Links a street to the neighbourhood it belongs to."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range Infrastructure:Neighborhood ;
    rdfs:subPropertyOf geosparql:sfWithin .

Infrastructure:LanesBackward a owl:DatatypeProperty ;
    rdfs:label "backward lanes"@en ;
    rdfs:comment "Number of lanes in the backward direction of the road segment."@en ;
    rdfs:domain Infrastructure:Road_segment ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:integer .

Infrastructure:LanesForward a owl:DatatypeProperty ;
    rdfs:label "forward lanes"@en ;
    rdfs:comment "Number of lanes in the forward direction of the road segment."@en ;
    rdfs:domain Infrastructure:Road_segment ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:integer .

Infrastructure:Largeur a owl:DatatypeProperty ;
    rdfs:label "street width"@en ;
    rdfs:comment "Width of the street."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:LargeurSegment a owl:DatatypeProperty ;
    rdfs:label "segment width"@en ;
    rdfs:comment "Width of the road segment."@en ;
    rdfs:domain Infrastructure:Road_segment ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:LatitudeR a owl:DatatypeProperty ;
    rdfs:label "roundabout latitude"@en ;
    rdfs:comment "Latitude of the roundabout."@en ;
    rdfs:domain Infrastructure:Roundabout ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_C a owl:DatatypeProperty ;
    rdfs:label "municipality latitude"@en ;
    rdfs:comment "Latitude of the reference point of the municipality."@en ;
    rdfs:domain Infrastructure:Municipalities ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_Cap a owl:DatatypeProperty ;
    rdfs:label "sensor latitude"@en ;
    rdfs:comment "Latitude of the sensor."@en ;
    rdfs:domain Infrastructure:Sensor ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_Feu a owl:DatatypeProperty ;
    rdfs:label "traffic light latitude"@en ;
    rdfs:comment "Latitude of the traffic light."@en ;
    rdfs:domain Infrastructure:Traffic_light ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_I a owl:DatatypeProperty ;
    rdfs:label "intersection latitude"@en ;
    rdfs:comment "Latitude of the intersection."@en ;
    rdfs:domain Infrastructure:Intersection ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_Q a owl:DatatypeProperty ;
    rdfs:label "neighbourhood latitude"@en ;
    rdfs:comment "Latitude of the reference point of the neighbourhood."@en ;
    rdfs:domain Infrastructure:Neighborhood ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_R a owl:DatatypeProperty ;
    rdfs:label "street latitude"@en ;
    rdfs:comment "Latitude of the reference point of the street."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_pan a owl:DatatypeProperty ;
    rdfs:label "traffic sign latitude"@en ;
    rdfs:comment "Latitude of the traffic sign."@en ;
    rdfs:domain Infrastructure:Traffic_signs ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_poi a owl:DatatypeProperty ;
    rdfs:label "area of interest latitude"@en ;
    rdfs:comment "Latitude of the area of interest."@en ;
    rdfs:domain Infrastructure:AreaOfInterest ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_rech a owl:DatatypeProperty ;
    rdfs:label "charging station latitude"@en ;
    rdfs:comment "Latitude of the charging station."@en ;
    rdfs:domain Infrastructure:Charging_station ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Latitude_zon a owl:DatatypeProperty ;
    rdfs:label "parking area latitude"@en ;
    rdfs:comment "Latitude of the parking area."@en ;
    rdfs:domain Infrastructure:Parking ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Lidar_sensor a owl:Class ;
    rdfs:label "lidar sensor"@en ;
    rdfs:comment "A sensor that uses laser light to measure distances and detect objects."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:Sensor .

Infrastructure:LocatedOnStreet a owl:ObjectProperty ;
    rdfs:label "located on road segment"@en ;
    rdfs:comment "Links a road marking to the road segment on which it is painted."@en ;
    rdfs:domain Infrastructure:Road_markings ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range Infrastructure:Road_segment .

Infrastructure:LonObs a owl:DatatypeProperty ;
    rdfs:label "obstacle longitude"@en ;
    rdfs:comment "Longitude of the obstacle."@en ;
    rdfs:domain Infrastructure:Obstacles ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:LongitudeMarquage a owl:DatatypeProperty ;
    rdfs:label "road marking longitude"@en ;
    rdfs:comment "Longitude of the road marking."@en ;
    rdfs:domain Infrastructure:Road_markings ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:LongitudeR a owl:DatatypeProperty ;
    rdfs:label "roundabout longitude"@en ;
    rdfs:comment "Longitude of the roundabout."@en ;
    rdfs:domain Infrastructure:Roundabout ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_C a owl:DatatypeProperty ;
    rdfs:label "municipality longitude"@en ;
    rdfs:comment "Longitude of the reference point of the municipality."@en ;
    rdfs:domain Infrastructure:Municipalities ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_Cap a owl:DatatypeProperty ;
    rdfs:label "sensor longitude"@en ;
    rdfs:comment "Longitude of the sensor."@en ;
    rdfs:domain Infrastructure:Sensor ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_Feu a owl:DatatypeProperty ;
    rdfs:label "traffic light longitude"@en ;
    rdfs:comment "Longitude of the traffic light."@en ;
    rdfs:domain Infrastructure:Traffic_light ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_I a owl:DatatypeProperty ;
    rdfs:label "intersection longitude"@en ;
    rdfs:comment "Longitude of the intersection."@en ;
    rdfs:domain Infrastructure:Intersection ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_Q a owl:DatatypeProperty ;
    rdfs:label "neighbourhood longitude"@en ;
    rdfs:comment "Longitude of the reference point of the neighbourhood."@en ;
    rdfs:domain Infrastructure:Neighborhood ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_R a owl:DatatypeProperty ;
    rdfs:label "street longitude"@en ;
    rdfs:comment "Longitude of the reference point of the street."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_pan a owl:DatatypeProperty ;
    rdfs:label "traffic sign longitude"@en ;
    rdfs:comment "Longitude of the traffic sign."@en ;
    rdfs:domain Infrastructure:Traffic_signs ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_poi a owl:DatatypeProperty ;
    rdfs:label "area of interest longitude"@en ;
    rdfs:comment "Longitude of the area of interest."@en ;
    rdfs:domain Infrastructure:AreaOfInterest ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_rech a owl:DatatypeProperty ;
    rdfs:label "charging station longitude"@en ;
    rdfs:comment "Longitude of the charging station."@en ;
    rdfs:domain Infrastructure:Charging_station ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longitude_zon a owl:DatatypeProperty ;
    rdfs:label "parking area longitude"@en ;
    rdfs:comment "Longitude of the parking area."@en ;
    rdfs:domain Infrastructure:Parking ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Longueur a owl:DatatypeProperty ;
    rdfs:label "street length"@en ;
    rdfs:comment "Length of the street."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:LongueurSegment a owl:DatatypeProperty ;
    rdfs:label "segment length"@en ;
    rdfs:comment "Length of the road segment."@en ;
    rdfs:domain Infrastructure:Road_segment ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:decimal .

Infrastructure:Macro a owl:NamedIndividual,
        Infrastructure:GranularityLevel ;
    rdfs:label "macro level"@en ;
    rdfs:comment "Macro level of granularity: municipality-level entities, such as municipalities."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> .

Infrastructure:Meso a owl:NamedIndividual,
        Infrastructure:GranularityLevel ;
    rdfs:label "meso level"@en ;
    rdfs:comment "Meso level of granularity: neighbourhood-level entities, such as neighbourhoods, areas of interest, industrial zones and parking areas."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> .

Infrastructure:Metro a owl:Class ;
    rdfs:label "metro"@en ;
    rdfs:comment "A metro (urban rail) vehicle."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:subClassOf Infrastructure:vehicle .

Infrastructure:Micro a owl:NamedIndividual,
        Infrastructure:GranularityLevel ;
    rdfs:label "micro level"@en ;
    rdfs:comment "Micro level of granularity: street-level entities, such as road segments, intersections, streets, road markings, traffic signs and sensors."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> .

Infrastructure:Nbr_lane a owl:DatatypeProperty ;
    rdfs:label "number of lanes"@en ;
    rdfs:comment "Number of lanes of the street."@en ;
    rdfs:domain Infrastructure:Streets ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:integer .

Infrastructure:NomBat a owl:DatatypeProperty ;
    rdfs:label "building name"@en ;
    rdfs:comment "Name of the building."@en ;
    rdfs:domain Infrastructure:Building ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:NomSecteur a owl:DatatypeProperty ;
    rdfs:label "industrial zone name"@en ;
    rdfs:comment "Name of the industrial zone."@en ;
    rdfs:domain Infrastructure:Industrial_Zone ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:Nom_C a owl:DatatypeProperty ;
    rdfs:label "municipality name"@en ;
    rdfs:comment "Name of the municipality."@en ;
    rdfs:domain Infrastructure:Municipalities ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:Nom_Q a owl:DatatypeProperty ;
    rdfs:label "neighbourhood name"@en ;
    rdfs:comment "Name of the neighbourhood."@en ;
    rdfs:domain Infrastructure:Neighborhood ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:Nom_poi a owl:DatatypeProperty ;
    rdfs:label "area of interest name"@en ;
    rdfs:comment "Name of the area of interest."@en ;
    rdfs:domain Infrastructure:AreaOfInterest ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/infrastructure> ;
    rdfs:range xsd:string .

Infrastructure:Nom_rech a owl:DatatypeProperty ;
