DRT:ShortNoticeReservation a owl:Class ;
    rdfs:comment "A reservation made with a short lead time between its creation time and its currently requested pickup time. If the requested pickup time is modified, the lead time is recalculated, and the reservation may enter or leave this class without losing its identity." ;
    rdfs:subClassOf DRT:Reservation .

DRT:TightDropWindowReservation a owl:Class ;
    rdfs:comment "A reservation with a narrow drop-off time window, meaning that the passenger must be dropped off within a limited time interval defined by the DRT service. This time window may be modified after the reservation is created, and the reservation may consequently cease to belong to this class." ;
    rdfs:subClassOf DRT:Reservation .

DRT:TightPickupWindowReservation a owl:Class ;
    rdfs:comment "A reservation with a narrow pickup time window, meaning that the passenger must be picked up within a limited time interval defined by the DRT service. This time window may be modified after the reservation is created, and the reservation may consequently cease to belong to this class." ;
    rdfs:subClassOf DRT:Reservation .

DRT:dropoffSlackSec a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dropoff slack in seconds" ;
    rdfs:domain DRT:Reservation ;
    rdfs:range xsd:double .

DRT:includesTrip a owl:ObjectProperty ;
    rdfs:label "includes trip" ;
    rdfs:domain DRT:Ride ;
    rdfs:range DRT:Trips .

DRT:madeBy a owl:ObjectProperty ;
    rdfs:label "made by" ;
    rdfs:domain DRT:Reservation ;
    rdfs:range DRT:Customer .

DRT:noticeSec a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "notice in seconds" ;
    rdfs:domain DRT:Reservation ;
    rdfs:range xsd:double .

DRT:pickupSlackSec a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "pickup slack in seconds" ;
    rdfs:domain DRT:Reservation ;
    rdfs:range xsd:double .

