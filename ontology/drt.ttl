    rdfs:comment "Meso Level: An area where specific types of economic activities are concentrated, such as industrial zones",
        "Meso Level: An area where specific types of economic activities are concentrated, such as industrial zones or commercial areas." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature .

Infrastructure:Traffic_control a owl:Class ;
    rdfs:comment "Micro Level: Includes all signs, traffic lights, and road markings used to regulate, warn, or inform drivers and pedestrians about traffic rules" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature .

GTFS:FareRule a owl:Class ;
    rdfs:comment "Specifies the fare application rules based on routes, zones..." .

GTFS:FareTransferRule a owl:Class ;
    rdfs:comment "Defines the Fare rules for transfers between legs of trips" .

GTFS:Frequency a owl:Class ;
    rdfs:comment "represents trips that operate on regular headways (time between trips)" .

DRT:Ride a owl:Class .

