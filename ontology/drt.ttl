    dcterms:publisher <http://purl.org/dc/aboutdcmi#DCMI> ;
    dcterms:title "Dublin Core Metadata Element Set, Version 1.1"@en .

GTFS:Trips a owl:Class ;
    rdfs:comment "Defines trips, which are specific journeys made on a  route at a particular time" .

GTFS:BookingRule a owl:Class ;
    rdfs:comment "Specifies the rules for booking services requested by the passenger, e.g. in the case of transport on demand, the rules include a deadline for booking before departure" .

geosparql:Geometry a owl:Class .

geosparql:hasGeometry a owl:ObjectProperty .

DRT:Trips a owl:Class ;
    rdfs:comment """Defines a DRT trips, which are specific journeys made on a  route at a particular time.
Each Trips instance represents a passenger journey performed as a result of a prior Reservation. In the DRT system, every passenger trip necessarily originates from a reservation.""" .

GTFS:Routes a owl:Class ;
    rdfs:comment "Routes describe the public transit lines." .

geosparql:Feature a owl:Class .

DRT:seg a swrl:Variable .

Infrastructure:Road_segment a owl:Class ;
    rdfs:comment """Micro Level: A segment of road between two points, such as those defined by intersections or road markings.
A spatially and topologically delimited portion of the road network at the micro level, generally defined between two reference points such as intersections or stops. Its identity is determined by its position, endpoints, and segmentation within the road network. Corrections to geometric coordinates do not create a new segment when the network segment remains unchanged, whereas splitting or merging segments results in distinct network segment identities.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature .

Infrastructure:Streets a owl:Class ;
    rdfs:comment "Micro Level: Describes streets designed for the movement of both vehicles and pedestrians" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature .

GTFS:Stops a owl:Class ;
    rdfs:label "GTFS Stops" ;
    rdfs:comment "the stops or stations served by the transportation network" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geosparql:hasGeometry ;
            owl:someValuesFrom geosparql:Geometry ],
        geosparql:Feature .

DRT:Reservation a owl:Class ;
    rdfs:comment "Represents a booking made by a passenger to access on-demand transportation services." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty time:hasTime ;
            owl:someValuesFrom time:Interval ],
        Dtx:Plan .

