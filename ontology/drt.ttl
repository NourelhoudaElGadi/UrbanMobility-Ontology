@prefix DRT: <https://w3id.org/urbanmobility/drt#> .
@prefix Dtx: <http://purl.org/td/transportdisruption#> .
@prefix GTFS: <https://w3id.org/urbanmobility/gtfs#> .
@prefix Infrastructure: <https://w3id.org/urbanmobility/infrastructure#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:isPartOf a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

foaf:homepage a owl:AnnotationProperty .

DRT:Admin a owl:Class ;
    rdfs:label "administrator"@en ;
    rdfs:comment "A person who administers the DRT service, for example an operator or a call-centre agent who manages reservations."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf DRT:Person .

DRT:Arrives_at a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "arrives at"@en ;
    rdfs:comment "Links a DRT trip to the stop where the passenger is dropped off."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:Stops .

DRT:ComfortSensitiveReservation a owl:Class ;
    rdfs:label "comfort-sensitive reservation"@en ;
    rdfs:comment "A reservation made for a user with a reduced-mobility (PMR) or elderly profile. Such reservations are comfort-sensitive: accessibility and comfort needs must be taken into account when the service is planned."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf DRT:Reservation .

DRT:Departs_from a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "departs from"@en ;
    rdfs:comment "Links a DRT trip to the stop where the passenger is picked up."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:Stops .

DRT:Email a owl:DatatypeProperty ;
    rdfs:label "e-mail"@en ;
    rdfs:comment "E-mail address of the person."@en ;
    rdfs:domain DRT:Person ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:Makes_a a owl:ObjectProperty ;
    rdfs:label "makes reservation"@en ;
    rdfs:comment "Links a customer to a reservation that he or she makes."@en ;
    rdfs:domain DRT:Customer ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Reservation ;
    owl:inverseOf DRT:madeBy .

DRT:ShortNoticeReservation a owl:Class ;
    rdfs:label "short-notice reservation"@en ;
    rdfs:comment "A reservation made with a short lead time between its creation and its requested pickup time. The lead time is recalculated if the requested pickup time changes, so a reservation may enter or leave this class without losing its identity."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf DRT:Reservation .

DRT:StopAt a owl:ObjectProperty ;
    rdfs:label "stops at"@en ;
    rdfs:comment "Links a DRT shuttle to a stop that it serves."@en ;
    rdfs:domain Infrastructure:DRT_Shuttle ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:Stops .

DRT:TAD_speed a owl:DatatypeProperty ;
    rdfs:label "shuttle speed"@en ;
    rdfs:comment "Commercial speed of the shuttle. TAD stands for transport à la demande, the French term for DRT."@en ;
    rdfs:domain Infrastructure:DRT_Shuttle ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

DRT:TAD_trips_id a owl:DatatypeProperty ;
    rdfs:label "DRT trip identifier"@en ;
    rdfs:comment "Identifier of the trip in the information system of the DRT (TAD) operator."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

DRT:TAD_type a owl:DatatypeProperty ;
    rdfs:label "DRT vehicle type"@en ;
    rdfs:comment "Type of DRT vehicle, for example its size or category."@en ;
    rdfs:domain Infrastructure:DRT_Shuttle ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:TightDropWindowReservation a owl:Class ;
    rdfs:label "tight drop-off window reservation"@en ;
    rdfs:comment "A reservation with a narrow drop-off time window: the passenger must be dropped off within a short time interval. The window may be modified after the reservation is created, and the reservation may then leave this class."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf DRT:Reservation .

DRT:TightPickupWindowReservation a owl:Class ;
    rdfs:label "tight pickup window reservation"@en ;
    rdfs:comment "A reservation with a narrow pickup time window: the passenger must be picked up within a short time interval. The window may be modified after the reservation is created, and the reservation may then leave this class."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf DRT:Reservation .

DRT:Travels_by a owl:ObjectProperty ;
    rdfs:label "travels by"@en ;
    rdfs:comment "Links a passenger to the DRT shuttle in which he or she travels."@en ;
    rdfs:domain DRT:Passenger ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range Infrastructure:DRT_Shuttle .

DRT:Use_fare_media a owl:ObjectProperty ;
    rdfs:label "uses fare medium"@en ;
    rdfs:comment "Links a customer to a fare medium (card, ticket or mobile app) that he or she uses."@en ;
    rdfs:domain DRT:Customer ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:FareMedia .

DRT:actualDropoffTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "actual dropoff time"@en ;
    rdfs:comment "Date and time at which the passenger was actually dropped off."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:actualPickupTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "actual pickup time"@en ;
    rdfs:comment "Date and time at which the passenger was actually picked up."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:actualRideDuration a owl:DatatypeProperty ;
    rdfs:label "actual ride duration"@en ;
    rdfs:comment "Actual in-vehicle duration of the trip."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:arrivalTime a owl:DatatypeProperty ;
    rdfs:label "requested arrival time"@en ;
    rdfs:comment "Requested arrival time at the destination."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:assigned_to a owl:ObjectProperty ;
    rdfs:label "assigned to ride"@en ;
    rdfs:comment "Links a reservation to the ride (vehicle run) to which it is assigned."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Ride .

DRT:belongsToRide a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to ride"@en ;
    rdfs:comment "Links a DRT trip to the ride during which it is performed."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Ride ;
    owl:inverseOf DRT:includesTrip .

DRT:bookedFrom a owl:DatatypeProperty ;
    rdfs:label "booked from"@en ;
    rdfs:comment "Channel through which the reservation was made: mobile app, call centre, driver app or website."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:bookingCreatedAt a owl:DatatypeProperty ;
    rdfs:label "booking creation date and time"@en ;
    rdfs:comment "Date and time at which the booking was created."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:buslineCode a owl:DatatypeProperty ;
    rdfs:label "DRT line code"@en ;
    rdfs:comment "Code of the DRT line associated with the route."@en ;
    rdfs:domain GTFS:Routes ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

DRT:buslineName a owl:DatatypeProperty ;
    rdfs:label "DRT line name"@en ;
    rdfs:comment "Name of the DRT line associated with the route."@en ;
    rdfs:domain GTFS:Routes ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:buy a owl:ObjectProperty ;
    rdfs:label "buys fare product"@en ;
    rdfs:comment "Links a customer to a fare product that he or she buys."@en ;
    rdfs:domain DRT:Customer ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:FareProduct .

DRT:cancellationReason a owl:DatatypeProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Reason given for the cancellation of the reservation (free text)."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:capacity a owl:DatatypeProperty ;
    rdfs:label "capacity"@en ;
    rdfs:comment "Passenger capacity of the shuttle: the maximum number of passengers it can carry at the same time."@en ;
    rdfs:domain Infrastructure:DRT_Shuttle ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

DRT:clientComment a owl:DatatypeProperty ;
    rdfs:label "client comment"@en ;
    rdfs:comment "Free-text comment left by the customer."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:complies_with a owl:ObjectProperty ;
    rdfs:label "complies with"@en ;
    rdfs:comment "Links a reservation to a booking rule that it must comply with, for example a minimum prior notice."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:BookingRule .

DRT:constraintPrecision a owl:DatatypeProperty ;
    rdfs:label "constraint precision"@en ;
    rdfs:comment "Precision attached to the time constraint expressed by the customer."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:constraintType a owl:DatatypeProperty ;
    rdfs:label "constraint type"@en ;
    rdfs:comment "Type of time constraint expressed by the customer, for example a desired pickup time or a desired arrival time."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:cost a owl:DatatypeProperty ;
    rdfs:label "cost"@en ;
    rdfs:comment "Operating cost of the shuttle."@en ;
    rdfs:domain Infrastructure:DRT_Shuttle ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:decimal .

DRT:dateTransport a owl:DatatypeProperty ;
    rdfs:label "journey date"@en ;
    rdfs:comment "Date of the requested journey."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:delay a owl:DatatypeProperty ;
    rdfs:label "delay"@en ;
    rdfs:comment "Delay of the trip with respect to the time selected at booking, in seconds."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:double .

DRT:departureTime a owl:DatatypeProperty ;
    rdfs:label "requested departure time"@en ;
    rdfs:comment "Requested departure time from the origin."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:directTripDistanceMeters a owl:DatatypeProperty ;
    rdfs:label "direct trip distance (m)"@en ;
    rdfs:comment "Direct (shortest-path) distance between the pickup and drop-off stops, in metres."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:distance a owl:DatatypeProperty ;
    rdfs:label "distance"@en ;
    rdfs:comment "Distance of the requested journey."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:driven_by a owl:ObjectProperty ;
    rdfs:label "driven by"@en ;
    rdfs:comment "Links a DRT trip to the driver of the vehicle that performs it."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Driver .

DRT:driverEmail a owl:DatatypeProperty ;
    rdfs:label "driver email"@en ;
    rdfs:comment "E-mail address of the driver."@en ;
    rdfs:domain DRT:Driver ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:driverName a owl:DatatypeProperty ;
    rdfs:label "driver name"@en ;
    rdfs:comment "Name of the driver."@en ;
    rdfs:domain DRT:Driver ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:dropoffSlackSec a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dropoff slack in seconds"@en ;
    rdfs:comment "Slack of the drop-off time window, in seconds: the tolerance around the requested drop-off time."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:double .

DRT:dropoffWalkTime a owl:DatatypeProperty ;
    rdfs:label "dropoff walk time"@en ;
    rdfs:comment "Walking time between the drop-off stop and the final destination."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:int .

DRT:entryDate a owl:DatatypeProperty ;
    rdfs:label "entry date"@en ;
    rdfs:comment "Date and time at which the reservation was entered in the booking system."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:firstName a owl:DatatypeProperty ;
    rdfs:label "first name"@en ;
    rdfs:comment "First name of the person."@en ;
    rdfs:domain DRT:Person ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:gender a owl:DatatypeProperty ;
    rdfs:label "gender"@en ;
    rdfs:comment "Gender of the person."@en ;
    rdfs:domain DRT:Person ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:hasDropoffLocation a owl:ObjectProperty ;
    rdfs:label "has dropoff location"@en ;
    rdfs:comment "Links a reservation to the requested drop-off stop."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:Stops .

DRT:hasDropoffTimeWindow a owl:ObjectProperty ;
    rdfs:label "has dropoff time window"@en ;
    rdfs:comment "Links a reservation to the time interval in which the passenger must be dropped off."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range time:Interval .

DRT:hasPassenger a owl:ObjectProperty ;
    rdfs:label "has passenger"@en ;
    rdfs:comment "Links a reservation to a passenger who travels under it."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Passenger .

DRT:hasPickupLocation a owl:ObjectProperty ;
    rdfs:label "has pickup location"@en ;
    rdfs:comment "Links a reservation to the requested pickup stop."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:Stops .

DRT:hasPickupTimeWindow a owl:ObjectProperty ;
    rdfs:label "has pickup time window"@en ;
    rdfs:comment "Links a reservation to the time interval in which the passenger must be picked up."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range time:Interval .

DRT:has_Vehicle a owl:ObjectProperty ;
    rdfs:label "has vehicle"@en ;
    rdfs:comment "Links a DRT line (route) to a shuttle assigned to it."@en ;
    rdfs:domain GTFS:Routes ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range Infrastructure:DRT_Shuttle .

DRT:indicationToDriver a owl:DatatypeProperty ;
    rdfs:label "indication to driver"@en ;
    rdfs:comment "Free-text instructions for the driver."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:initialPrice a owl:DatatypeProperty ;
    rdfs:label "initial price"@en ;
    rdfs:comment "Price initially quoted for the reservation."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:isDropoffStandard a owl:DatatypeProperty ;
    rdfs:label "is standard drop-off"@en ;
    rdfs:comment "Indicates whether the drop-off takes place at a standard stop of the service."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:boolean .

DRT:isPMR a owl:DatatypeProperty ;
    rdfs:label "has reduced mobility"@en ;
    rdfs:comment "Indicates whether the person has reduced mobility (in French: personne à mobilité réduite, PMR)."@en ;
    rdfs:domain DRT:Person ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:boolean .

DRT:isPickupStandard a owl:DatatypeProperty ;
    rdfs:label "is standard pickup"@en ;
    rdfs:comment "Indicates whether the pickup takes place at a standard stop of the service."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:boolean .

DRT:isRecommended a owl:DatatypeProperty ;
    rdfs:label "is recommended"@en ;
    rdfs:comment "Indicates whether the trip was the option recommended to the customer by the booking system."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:boolean .

DRT:isShared a owl:DatatypeProperty ;
    rdfs:label "is shared"@en ;
    rdfs:comment "Indicates whether the trip is shared with other passengers (pooled ride)."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:boolean .

DRT:is_located_on_Streets a owl:ObjectProperty ;
    rdfs:label "is located on street"@en ;
    rdfs:comment "Links a stop to the street on which it is located."@en ;
    rdfs:domain GTFS:Stops ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range Infrastructure:Streets .

DRT:journeyDuration a owl:DatatypeProperty ;
    rdfs:label "journey duration"@en ;
    rdfs:comment "Duration of the requested journey."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:duration .

DRT:lastName a owl:DatatypeProperty ;
    rdfs:label "last name"@en ;
    rdfs:comment "Last name of the person."@en ;
    rdfs:domain DRT:Person ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:latestDropoffTime a owl:DatatypeProperty ;
    rdfs:label "latest dropoff time"@en ;
    rdfs:comment "Latest acceptable drop-off time: the end of the drop-off time window."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:latestPickupTime a owl:DatatypeProperty ;
    rdfs:label "latest pickup time"@en ;
    rdfs:comment "Latest acceptable pickup time: the end of the pickup time window."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:make_a_trip a owl:ObjectProperty ;
    rdfs:label "makes trip"@en ;
    rdfs:comment "Links a DRT shuttle to a trip that it performs."@en ;
    rdfs:domain Infrastructure:DRT_Shuttle ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Trips .

DRT:motif a owl:DatatypeProperty ;
    rdfs:label "journey reason"@en ;
    rdfs:comment "Reason for the journey."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:noticeSec a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "notice in seconds"@en ;
    rdfs:comment "Notice time, in seconds: the time between the creation of the request and the requested pickup time."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:double .

DRT:numberOfPeople a owl:DatatypeProperty ;
    rdfs:label "number of people"@en ;
    rdfs:comment "Number of people covered by the reservation."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

DRT:number_passenger a owl:DatatypeProperty ;
    rdfs:label "number of passengers"@en ;
    rdfs:comment "Number of passengers travelling on the trip."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

DRT:operate_on a owl:ObjectProperty ;
    rdfs:label "operates on line"@en ;
    rdfs:comment "Links a DRT trip to the DRT line (route) on which it operates."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:Routes .

DRT:operatedBy a owl:ObjectProperty ;
    rdfs:label "operated by"@en ;
    rdfs:comment "Links a ride to the driver who operates it."@en ;
    rdfs:domain DRT:Ride ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Driver .

DRT:operatesOn a owl:ObjectProperty ;
    rdfs:label "operates on line (ride)"@en ;
    rdfs:comment "Links a ride to the DRT line (route) on which it operates."@en ;
    rdfs:domain DRT:Ride ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:Routes .

DRT:paidWithMedia a owl:ObjectProperty ;
    rdfs:label "paid with media"@en ;
    rdfs:comment "Links a reservation to the fare medium used to pay for it."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:FareMedia .

DRT:passengerStatus a owl:DatatypeProperty ;
    rdfs:label "passenger status"@en ;
    rdfs:comment "Status of the passenger for the trip, for example trip completed."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:paymentMode a owl:DatatypeProperty ;
    rdfs:label "payment mode"@en ;
    rdfs:comment "Payment mode of the reservation, for example on board with a pass."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:pickupSlackSec a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "pickup slack in seconds"@en ;
    rdfs:comment "Slack of the pickup time window, in seconds: the tolerance around the requested pickup time."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:double .

DRT:pickupWalkTime a owl:DatatypeProperty ;
    rdfs:label "pickup walk time"@en ;
    rdfs:comment "Walking time between the origin and the pickup stop."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:int .

DRT:releaseTimeHHMM a owl:DatatypeProperty ;
    rdfs:label "release time as HHMM"@en ;
    rdfs:comment "Release time of the request, formatted as HHMM: the time at which the request becomes known to the dispatcher."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:releaseTimeSec a owl:DatatypeProperty ;
    rdfs:label "release time in seconds"@en ;
    rdfs:comment "Release time of the request, in seconds."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:double .

DRT:reservationNumber a owl:DatatypeProperty ;
    rdfs:label "reservation number"@en ;
    rdfs:comment "Number of the reservation in the booking system."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

DRT:rideID a owl:DatatypeProperty ;
    rdfs:label "ride ID"@en ;
    rdfs:comment "Identifier of the ride to which the trip belongs."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:selectedDropoffTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "selected dropoff time"@en ;
    rdfs:comment "Drop-off time selected by the customer at booking."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:selectedPickupTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "selected pickup time"@en ;
    rdfs:comment "Pickup time selected by the customer at booking."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:dateTime .

DRT:selectedRideDuration a owl:DatatypeProperty ;
    rdfs:label "selected ride duration"@en ;
    rdfs:comment "Ride duration of the option selected at booking."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Status of the reservation in the booking system, for example validated or cancelled."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:theoreticalTripDistanceKm a owl:DatatypeProperty ;
    rdfs:label "theoretical trip distance (km)"@en ;
    rdfs:comment "Theoretical distance of the requested journey, in kilometres."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:totalPrice a owl:DatatypeProperty ;
    rdfs:label "total price"@en ;
    rdfs:comment "Total price paid for the reservation."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:tripDistanceKm a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "trip distance (km)"@en ;
    rdfs:comment "Distance travelled for the trip, in kilometres."@en ;
    rdfs:domain DRT:Trips ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:tripPurpose a owl:DatatypeProperty ;
    rdfs:label "trip purpose"@en ;
    rdfs:comment "Purpose of the journey, for example work, health or shopping."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:userID a owl:DatatypeProperty ;
    rdfs:label "user ID"@en ;
    rdfs:comment "Identifier of the user in the booking system."@en ;
    rdfs:domain DRT:Person ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

DRT:userProfile a owl:DatatypeProperty ;
    rdfs:label "user profile"@en ;
    rdfs:comment "Profile of the customer used to adapt the service, for example PMR (person with reduced mobility) or elderly."@en ;
    rdfs:domain DRT:Customer ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:usesFareProduct a owl:ObjectProperty ;
    rdfs:label "uses fare product"@en ;
    rdfs:comment "Links a reservation to the fare product applied to it."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:FareProduct .

DRT:usesVehicle a owl:ObjectProperty ;
    rdfs:label "uses vehicle"@en ;
    rdfs:comment "Links a ride to the DRT shuttle that performs it."@en ;
    rdfs:domain DRT:Ride ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range Infrastructure:DRT_Shuttle .

DRT:vatAmount a owl:DatatypeProperty ;
    rdfs:label "VAT amount"@en ;
    rdfs:comment "Amount of VAT included in the price."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:float .

DRT:vehicleName a owl:DatatypeProperty ;
    rdfs:label "DRT shuttle name"@en ;
    rdfs:comment "Name of the DRT shuttle."@en ;
    rdfs:domain Infrastructure:DRT_Shuttle ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:string .

DRT:wait_at a owl:ObjectProperty ;
    rdfs:label "waits at"@en ;
    rdfs:comment "Links a passenger to the stop where he or she waits to be picked up."@en ;
    rdfs:domain DRT:Passenger ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range GTFS:Stops .

DRT:wasCancelledBy a owl:ObjectProperty ;
    rdfs:label "was cancelled by"@en ;
    rdfs:comment "Links a cancelled reservation to the person who cancelled it: the customer, the driver or an administrator."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Person .

DRT:year a owl:DatatypeProperty ;
    rdfs:label "year"@en ;
    rdfs:comment "Year of the journey."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range xsd:integer .

Infrastructure:Pedestrians rdfs:subClassOf DRT:Person .

Dtx:Plan a owl:Class .

xsd:duration a rdfs:Datatype .

time:hasTime a owl:ObjectProperty .

<https://orcid.org/0000-0002-1599-9326> rdfs:label "Alain Bouju" .

<https://orcid.org/0000-0002-7792-8953> rdfs:label "Esma Talhi" .

<https://orcid.org/0009-0000-4334-4557> rdfs:label "Nourelhouda El Gadi" .

DRT:includesTrip a owl:ObjectProperty ;
    rdfs:label "includes trip"@en ;
    rdfs:comment "Links a ride to a passenger trip that it includes."@en ;
    rdfs:domain DRT:Ride ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Trips .

DRT:madeBy a owl:ObjectProperty ;
    rdfs:label "made by"@en ;
    rdfs:comment "Links a reservation to the customer who made it."@en ;
    rdfs:domain DRT:Reservation ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:range DRT:Customer .

time:Interval a owl:Class .

DRT:Passenger a owl:Class ;
    rdfs:label "passenger"@en ;
    rdfs:comment "A person who travels on a DRT trip under a reservation."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf DRT:Person .

DRT:Driver a owl:Class ;
    rdfs:label "driver"@en ;
    rdfs:comment "A person who drives the vehicle during a ride or, for an autonomous shuttle, supervises it."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf DRT:Person .

DRT:Customer a owl:Class ;
    rdfs:label "customer"@en ;
    rdfs:comment "A person who books DRT trips. The customer makes the reservation and may travel or book for other passengers."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf DRT:Person .

DRT:Ride a owl:Class ;
    rdfs:label "ride"@en ;
    rdfs:comment "A vehicle run of the DRT service. A ride is operated by one driver with one shuttle on a DRT line, and includes the trips of all the passengers served during the run."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> .

DRT:Person a owl:Class ;
    rdfs:label "person"@en ;
    rdfs:comment "A person involved in the DRT service: a customer, a passenger, a driver or an administrator."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> .

DRT:Trips a owl:Class ;
    rdfs:label "DRT trip"@en ;
    rdfs:comment "A passenger journey of the DRT service: the trip of one passenger from a pickup stop to a drop-off stop during a ride. Every DRT trip originates from a prior reservation."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> .

DRT:Reservation a owl:Class ;
    rdfs:label "reservation"@en ;
    rdfs:comment "A booking for the on-demand transport service, made by a customer for one or more passengers. It states the requested pickup and drop-off stops, the time windows and the constraints of the journey, and is assigned to a ride."@en ;
    rdfs:isDefinedBy <https://w3id.org/urbanmobility/drt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty time:hasTime ;
            owl:someValuesFrom time:Interval ],
        Dtx:Plan .

<https://w3id.org/urbanmobility/drt> a owl:Ontology ;
    dcterms:bibliographicCitation "Nourelhouda El Gadi, Esma Talhi, Alain Bouju (2026). Urban-Mobility-Ontology (version 1.1.0). Zenodo. https://doi.org/10.5281/zenodo.20054329" ;
    dcterms:created "2024-06"^^xsd:gYearMonth ;
    dcterms:creator <https://orcid.org/0000-0002-1599-9326>,
        <https://orcid.org/0000-0002-7792-8953>,
        <https://orcid.org/0009-0000-4334-4557> ;
    dcterms:description "Main module of the Urban-Mobility-Ontology. The Demand-Responsive Transport (DRT) module represents passenger mobility demand and its relationship with on-demand transport services operated by autonomous shuttles. It describes each transport request through its spatial, temporal and individual constraints (pickup and drop-off locations, time windows, booking notice, maximum ride duration, accessibility needs) and distinguishes the customer who makes a reservation, the passengers associated with it, the individual trips and the vehicle rides that serve them. It imports the GTFS, Infrastructure and Events modules and links passenger demand to the public transport supply, the urban environment and disruptive events."@en ;
    dcterms:identifier <https://doi.org/10.5281/zenodo.20054329> ;
    dcterms:isPartOf <https://w3id.org/urbanmobility/> ;
    dcterms:language "en" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-27"^^xsd:date ;
    dcterms:title "Urban-Mobility-Ontology: DRT core module"@en ;
    vann:preferredNamespacePrefix "DRT" ;
    vann:preferredNamespaceUri "https://w3id.org/urbanmobility/drt#"^^xsd:anyURI ;
    owl:imports <http://www.opengis.net/ont/geosparql>,
        <http://www.w3.org/2006/time>,
        <https://w3id.org/urbanmobility/event>,
        <https://w3id.org/urbanmobility/gtfs>,
        <https://w3id.org/urbanmobility/infrastructure> ;
    owl:priorVersion <http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand> ;
    owl:versionIRI <https://w3id.org/urbanmobility/drt/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    foaf:homepage <https://nourelhoudaelgadi.github.io/UrbanMobility-Ontology/drt.html> .

