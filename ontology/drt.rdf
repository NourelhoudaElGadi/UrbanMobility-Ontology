        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasAgency -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasAgency">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Agency"/>
        <rdfs:comment>lines of network transport has differents agency</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasBookingRule -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasBookingRule">
