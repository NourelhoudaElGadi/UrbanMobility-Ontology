        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Calendar"/>
        <rdfs:comment>indicates exceptions or variations in the Calendar</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasExeption -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasExeption">
