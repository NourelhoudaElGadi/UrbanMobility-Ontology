        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>indicates what time the stop is served</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#stopInArea -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#stopInArea">
