<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#dropoffSlackSec">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">dropoff slack in seconds</rdfs:label>
    <rdfs:comment xml:lang="en">Slack of the drop-off time window, in seconds: the tolerance around the requested drop-off time.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="https://w3id.org/urbanmobility/drt">
        <dcterms:bibliographicCitation>Nourelhouda El Gadi, Esma Talhi, Alain Bouju (2026). Urban-Mobility-Ontology (version 1.1.0). Zenodo. https://doi.org/10.5281/zenodo.20054329</dcterms:bibliographicCitation>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#gYearMonth">2024-06</dcterms:created>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-1599-9326"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-7792-8953"/>
        <dcterms:creator rdf:resource="https://orcid.org/0009-0000-4334-4557"/>
        <dcterms:description xml:lang="en">Main module of the Urban-Mobility-Ontology. The Demand-Responsive Transport (DRT) module represents passenger mobility demand and its relationship with on-demand transport services operated by autonomous shuttles. It describes each transport request through its spatial, temporal and individual constraints (pickup and drop-off locations, time windows, booking notice, maximum ride duration, accessibility needs) and distinguishes the customer who makes a reservation, the passengers associated with it, the individual trips and the vehicle rides that serve them. It imports the GTFS, Infrastructure and Events modules and links passenger demand to the public transport supply, the urban environment and disruptive events.</dcterms:description>
        <dcterms:identifier rdf:resource="https://doi.org/10.5281/zenodo.20054329"/>
        <dcterms:isPartOf rdf:resource="https://w3id.org/urbanmobility/"/>
        <dcterms:language>en</dcterms:language>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-27</dcterms:modified>
        <dcterms:title xml:lang="en">Urban-Mobility-Ontology: DRT core module</dcterms:title>
        <vann:preferredNamespacePrefix>DRT</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/urbanmobility/drt#</vann:preferredNamespaceUri>
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="https://w3id.org/urbanmobility/event"/>
        <owl:imports rdf:resource="https://w3id.org/urbanmobility/gtfs"/>
        <owl:imports rdf:resource="https://w3id.org/urbanmobility/infrastructure"/>
        <owl:priorVersion rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand"/>
        <owl:versionIRI rdf:resource="https://w3id.org/urbanmobility/drt/1.1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
        <foaf:homepage rdf:resource="https://nourelhoudaelgadi.github.io/UrbanMobility-Ontology/drt.html"/>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#directTripDistanceMeters">
    <rdfs:label xml:lang="en">direct trip distance (m)</rdfs:label>
    <rdfs:comment xml:lang="en">Direct (shortest-path) distance between the pickup and drop-off stops, in metres.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#isPMR">
    <rdfs:label xml:lang="en">has reduced mobility</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the person has reduced mobility (in French: personne à mobilité réduite, PMR).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#actualRideDuration">
    <rdfs:label xml:lang="en">actual ride duration</rdfs:label>
    <rdfs:comment xml:lang="en">Actual in-vehicle duration of the trip.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#cancellationReason">
    <rdfs:label xml:lang="en">cancellation reason</rdfs:label>
    <rdfs:comment xml:lang="en">Reason given for the cancellation of the reservation (free text).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#hasDropoffLocation">
    <rdfs:label xml:lang="en">has dropoff location</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to the requested drop-off stop.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#Use_fare_media">
    <rdfs:label xml:lang="en">uses fare medium</rdfs:label>
    <rdfs:comment xml:lang="en">Links a customer to a fare medium (card, ticket or mobile app) that he or she uses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Customer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareMedia"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#buslineCode">
    <rdfs:label xml:lang="en">DRT line code</rdfs:label>
    <rdfs:comment xml:lang="en">Code of the DRT line associated with the route.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#vehicleName">
    <rdfs:label xml:lang="en">DRT shuttle name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the DRT shuttle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#initialPrice">
    <rdfs:label xml:lang="en">initial price</rdfs:label>
    <rdfs:comment xml:lang="en">Price initially quoted for the reservation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#selectedRideDuration">
    <rdfs:label xml:lang="en">selected ride duration</rdfs:label>
    <rdfs:comment xml:lang="en">Ride duration of the option selected at booking.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#dateTransport">
    <rdfs:label xml:lang="en">journey date</rdfs:label>
    <rdfs:comment xml:lang="en">Date of the requested journey.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#delay">
    <rdfs:label xml:lang="en">delay</rdfs:label>
    <rdfs:comment xml:lang="en">Delay of the trip with respect to the time selected at booking, in seconds.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#releaseTimeSec">
    <rdfs:label xml:lang="en">release time in seconds</rdfs:label>
    <rdfs:comment xml:lang="en">Release time of the request, in seconds.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#actualPickupTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">actual pickup time</rdfs:label>
    <rdfs:comment xml:lang="en">Date and time at which the passenger was actually picked up.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#firstName">
    <rdfs:label xml:lang="en">first name</rdfs:label>
    <rdfs:comment xml:lang="en">First name of the person.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#number_passenger">
    <rdfs:label xml:lang="en">number of passengers</rdfs:label>
    <rdfs:comment xml:lang="en">Number of passengers travelling on the trip.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#hasPickupTimeWindow">
    <rdfs:label xml:lang="en">has pickup time window</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to the time interval in which the passenger must be picked up.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#StopAt">
    <rdfs:label xml:lang="en">stops at</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DRT shuttle to a stop that it serves.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#wasCancelledBy">
    <rdfs:label xml:lang="en">was cancelled by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a cancelled reservation to the person who cancelled it: the customer, the driver or an administrator.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#userProfile">
    <rdfs:label xml:lang="en">user profile</rdfs:label>
    <rdfs:comment xml:lang="en">Profile of the customer used to adapt the service, for example PMR (person with reduced mobility) or elderly.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Customer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:FunctionalProperty rdf:about="https://w3id.org/urbanmobility/drt#belongsToRide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">belongs to ride</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DRT trip to the ride during which it is performed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Ride"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#includesTrip">
        <rdfs:label xml:lang="en">includes trip</rdfs:label>
        <rdfs:comment xml:lang="en">Links a ride to a passenger trip that it includes.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Ride"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
        <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:FunctionalProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#theoreticalTripDistanceKm">
    <rdfs:label xml:lang="en">theoretical trip distance (km)</rdfs:label>
    <rdfs:comment xml:lang="en">Theoretical distance of the requested journey, in kilometres.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:FunctionalProperty rdf:about="https://w3id.org/urbanmobility/drt#Arrives_at">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">arrives at</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DRT trip to the stop where the passenger is dropped off.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:FunctionalProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#operatesOn">
    <rdfs:label xml:lang="en">operates on line (ride)</rdfs:label>
    <rdfs:comment xml:lang="en">Links a ride to the DRT line (route) on which it operates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Ride"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#hasDropoffTimeWindow">
    <rdfs:label xml:lang="en">has dropoff time window</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to the time interval in which the passenger must be dropped off.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#operatedBy">
    <rdfs:label xml:lang="en">operated by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a ride to the driver who operates it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Ride"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Driver"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#buy">
    <rdfs:label xml:lang="en">buys fare product</rdfs:label>
    <rdfs:comment xml:lang="en">Links a customer to a fare product that he or she buys.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Customer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareProduct"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#selectedPickupTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">selected pickup time</rdfs:label>
    <rdfs:comment xml:lang="en">Pickup time selected by the customer at booking.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#TAD_trips_id">
    <rdfs:label xml:lang="en">DRT trip identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the trip in the information system of the DRT (TAD) operator.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#motif">
    <rdfs:label xml:lang="en">journey reason</rdfs:label>
    <rdfs:comment xml:lang="en">Reason for the journey.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#Makes_a">
    <rdfs:label xml:lang="en">makes reservation</rdfs:label>
    <rdfs:comment xml:lang="en">Links a customer to a reservation that he or she makes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Customer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#madeBy">
        <rdfs:label xml:lang="en">made by</rdfs:label>
        <rdfs:comment xml:lang="en">Links a reservation to the customer who made it.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
        <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Customer"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#assigned_to">
    <rdfs:label xml:lang="en">assigned to ride</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to the ride (vehicle run) to which it is assigned.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Ride"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#complies_with">
    <rdfs:label xml:lang="en">complies with</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to a booking rule that it must comply with, for example a minimum prior notice.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#BookingRule"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#pickupWalkTime">
    <rdfs:label xml:lang="en">pickup walk time</rdfs:label>
    <rdfs:comment xml:lang="en">Walking time between the origin and the pickup stop.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#buslineName">
    <rdfs:label xml:lang="en">DRT line name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the DRT line associated with the route.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#releaseTimeHHMM">
    <rdfs:label xml:lang="en">release time as HHMM</rdfs:label>
    <rdfs:comment xml:lang="en">Release time of the request, formatted as HHMM: the time at which the request becomes known to the dispatcher.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#arrivalTime">
    <rdfs:label xml:lang="en">requested arrival time</rdfs:label>
    <rdfs:comment xml:lang="en">Requested arrival time at the destination.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#latestDropoffTime">
    <rdfs:label xml:lang="en">latest dropoff time</rdfs:label>
    <rdfs:comment xml:lang="en">Latest acceptable drop-off time: the end of the drop-off time window.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#operate_on">
    <rdfs:label xml:lang="en">operates on line</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DRT trip to the DRT line (route) on which it operates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#clientComment">
    <rdfs:label xml:lang="en">client comment</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text comment left by the customer.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#journeyDuration">
    <rdfs:label xml:lang="en">journey duration</rdfs:label>
    <rdfs:comment xml:lang="en">Duration of the requested journey.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range>
      <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    </rdfs:range>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#status">
    <rdfs:label xml:lang="en">status</rdfs:label>
    <rdfs:comment xml:lang="en">Status of the reservation in the booking system, for example validated or cancelled.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#driven_by">
    <rdfs:label xml:lang="en">driven by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DRT trip to the driver of the vehicle that performs it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Driver"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#constraintType">
    <rdfs:label xml:lang="en">constraint type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of time constraint expressed by the customer, for example a desired pickup time or a desired arrival time.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#isPickupStandard">
    <rdfs:label xml:lang="en">is standard pickup</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the pickup takes place at a standard stop of the service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#isDropoffStandard">
    <rdfs:label xml:lang="en">is standard drop-off</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the drop-off takes place at a standard stop of the service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#isRecommended">
    <rdfs:label xml:lang="en">is recommended</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the trip was the option recommended to the customer by the booking system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#rideID">
    <rdfs:label xml:lang="en">ride ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the ride to which the trip belongs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#numberOfPeople">
    <rdfs:label xml:lang="en">number of people</rdfs:label>
    <rdfs:comment xml:lang="en">Number of people covered by the reservation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#Travels_by">
    <rdfs:label xml:lang="en">travels by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a passenger to the DRT shuttle in which he or she travels.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Passenger"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#TAD_speed">
    <rdfs:label xml:lang="en">shuttle speed</rdfs:label>
    <rdfs:comment xml:lang="en">Commercial speed of the shuttle. TAD stands for transport à la demande, the French term for DRT.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#userID">
    <rdfs:label xml:lang="en">user ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the user in the booking system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#isShared">
    <rdfs:label xml:lang="en">is shared</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the trip is shared with other passengers (pooled ride).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#Admin">
    <rdfs:label xml:lang="en">administrator</rdfs:label>
    <rdfs:comment xml:lang="en">A person who administers the DRT service, for example an operator or a call-centre agent who manages reservations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#actualDropoffTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">actual dropoff time</rdfs:label>
    <rdfs:comment xml:lang="en">Date and time at which the passenger was actually dropped off.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#gender">
    <rdfs:label xml:lang="en">gender</rdfs:label>
    <rdfs:comment xml:lang="en">Gender of the person.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#has_Vehicle">
    <rdfs:label xml:lang="en">has vehicle</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DRT line (route) to a shuttle assigned to it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Routes"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#tripPurpose">
    <rdfs:label xml:lang="en">trip purpose</rdfs:label>
    <rdfs:comment xml:lang="en">Purpose of the journey, for example work, health or shopping.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#driverEmail">
    <rdfs:label xml:lang="en">driver email</rdfs:label>
    <rdfs:comment xml:lang="en">E-mail address of the driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Driver"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#entryDate">
    <rdfs:label xml:lang="en">entry date</rdfs:label>
    <rdfs:comment xml:lang="en">Date and time at which the reservation was entered in the booking system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#departureTime">
    <rdfs:label xml:lang="en">requested departure time</rdfs:label>
    <rdfs:comment xml:lang="en">Requested departure time from the origin.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#selectedDropoffTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">selected dropoff time</rdfs:label>
    <rdfs:comment xml:lang="en">Drop-off time selected by the customer at booking.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:FunctionalProperty rdf:about="https://w3id.org/urbanmobility/drt#Departs_from">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">departs from</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DRT trip to the stop where the passenger is picked up.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:FunctionalProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#dropoffWalkTime">
    <rdfs:label xml:lang="en">dropoff walk time</rdfs:label>
    <rdfs:comment xml:lang="en">Walking time between the drop-off stop and the final destination.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#reservationNumber">
    <rdfs:label xml:lang="en">reservation number</rdfs:label>
    <rdfs:comment xml:lang="en">Number of the reservation in the booking system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#hasPickupLocation">
    <rdfs:label xml:lang="en">has pickup location</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to the requested pickup stop.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#TAD_type">
    <rdfs:label xml:lang="en">DRT vehicle type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of DRT vehicle, for example its size or category.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#paidWithMedia">
    <rdfs:label xml:lang="en">paid with media</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to the fare medium used to pay for it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareMedia"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#vatAmount">
    <rdfs:label xml:lang="en">VAT amount</rdfs:label>
    <rdfs:comment xml:lang="en">Amount of VAT included in the price.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#capacity">
    <rdfs:label xml:lang="en">capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Passenger capacity of the shuttle: the maximum number of passengers it can carry at the same time.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#bookingCreatedAt">
    <rdfs:label xml:lang="en">booking creation date and time</rdfs:label>
    <rdfs:comment xml:lang="en">Date and time at which the booking was created.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#hasPassenger">
    <rdfs:label xml:lang="en">has passenger</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to a passenger who travels under it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Passenger"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#paymentMode">
    <rdfs:label xml:lang="en">payment mode</rdfs:label>
    <rdfs:comment xml:lang="en">Payment mode of the reservation, for example on board with a pass.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#passengerStatus">
    <rdfs:label xml:lang="en">passenger status</rdfs:label>
    <rdfs:comment xml:lang="en">Status of the passenger for the trip, for example trip completed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#cost">
    <rdfs:label xml:lang="en">cost</rdfs:label>
    <rdfs:comment xml:lang="en">Operating cost of the shuttle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#distance">
    <rdfs:label xml:lang="en">distance</rdfs:label>
    <rdfs:comment xml:lang="en">Distance of the requested journey.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#usesVehicle">
    <rdfs:label xml:lang="en">uses vehicle</rdfs:label>
    <rdfs:comment xml:lang="en">Links a ride to the DRT shuttle that performs it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Ride"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#make_a_trip">
    <rdfs:label xml:lang="en">makes trip</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DRT shuttle to a trip that it performs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/infrastructure#DRT_Shuttle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#pickupSlackSec">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">pickup slack in seconds</rdfs:label>
    <rdfs:comment xml:lang="en">Slack of the pickup time window, in seconds: the tolerance around the requested pickup time.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#tripDistanceKm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">trip distance (km)</rdfs:label>
    <rdfs:comment xml:lang="en">Distance travelled for the trip, in kilometres.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Trips"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isPartOf"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#latestPickupTime">
    <rdfs:label xml:lang="en">latest pickup time</rdfs:label>
    <rdfs:comment xml:lang="en">Latest acceptable pickup time: the end of the pickup time window.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#TightDropWindowReservation">
    <rdfs:label xml:lang="en">tight drop-off window reservation</rdfs:label>
    <rdfs:comment xml:lang="en">A reservation with a narrow drop-off time window: the passenger must be dropped off within a short time interval. The window may be modified after the reservation is created, and the reservation may then leave this class.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#year">
    <rdfs:label xml:lang="en">year</rdfs:label>
    <rdfs:comment xml:lang="en">Year of the journey.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#TightPickupWindowReservation">
    <rdfs:label xml:lang="en">tight pickup window reservation</rdfs:label>
    <rdfs:comment xml:lang="en">A reservation with a narrow pickup time window: the passenger must be picked up within a short time interval. The window may be modified after the reservation is created, and the reservation may then leave this class.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#driverName">
    <rdfs:label xml:lang="en">driver name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Driver"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#is_located_on_Streets">
    <rdfs:label xml:lang="en">is located on street</rdfs:label>
    <rdfs:comment xml:lang="en">Links a stop to the street on which it is located.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/infrastructure#Streets"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#ComfortSensitiveReservation">
    <rdfs:label xml:lang="en">comfort-sensitive reservation</rdfs:label>
    <rdfs:comment xml:lang="en">A reservation made for a user with a reduced-mobility (PMR) or elderly profile. Such reservations are comfort-sensitive: accessibility and comfort needs must be taken into account when the service is planned.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#noticeSec">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">notice in seconds</rdfs:label>
    <rdfs:comment xml:lang="en">Notice time, in seconds: the time between the creation of the request and the requested pickup time.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#indicationToDriver">
    <rdfs:label xml:lang="en">indication to driver</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text instructions for the driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#ShortNoticeReservation">
    <rdfs:label xml:lang="en">short-notice reservation</rdfs:label>
    <rdfs:comment xml:lang="en">A reservation made with a short lead time between its creation and its requested pickup time. The lead time is recalculated if the requested pickup time changes, so a reservation may enter or leave this class without losing its identity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#bookedFrom">
    <rdfs:label xml:lang="en">booked from</rdfs:label>
    <rdfs:comment xml:lang="en">Channel through which the reservation was made: mobile app, call centre, driver app or website.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#Email">
    <rdfs:label xml:lang="en">e-mail</rdfs:label>
    <rdfs:comment xml:lang="en">E-mail address of the person.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#totalPrice">
    <rdfs:label xml:lang="en">total price</rdfs:label>
    <rdfs:comment xml:lang="en">Total price paid for the reservation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#wait_at">
    <rdfs:label xml:lang="en">waits at</rdfs:label>
    <rdfs:comment xml:lang="en">Links a passenger to the stop where he or she waits to be picked up.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Passenger"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#Stops"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#constraintPrecision">
    <rdfs:label xml:lang="en">constraint precision</rdfs:label>
    <rdfs:comment xml:lang="en">Precision attached to the time constraint expressed by the customer.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/urbanmobility/drt#lastName">
    <rdfs:label xml:lang="en">last name</rdfs:label>
    <rdfs:comment xml:lang="en">Last name of the person.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/urbanmobility/drt#usesFareProduct">
    <rdfs:label xml:lang="en">uses fare product</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reservation to the fare product applied to it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/urbanmobility/drt#Reservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:range rdf:resource="https://w3id.org/urbanmobility/gtfs#FareProduct"/>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
  <rdf:Description rdf:about="https://w3id.org/urbanmobility/infrastructure#Pedestrians">
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
  </rdf:Description>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/language"/>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#Passenger">
    <rdfs:label xml:lang="en">passenger</rdfs:label>
    <rdfs:comment xml:lang="en">A person who travels on a DRT trip under a reservation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#Customer">
    <rdfs:label xml:lang="en">customer</rdfs:label>
    <rdfs:comment xml:lang="en">A person who books DRT trips. The customer makes the reservation and may travel or book for other passengers.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#Ride">
    <rdfs:label xml:lang="en">ride</rdfs:label>
    <rdfs:comment xml:lang="en">A vehicle run of the DRT service. A ride is operated by one driver with one shuttle on a DRT line, and includes the trips of all the passengers served during the run.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
  </owl:Class>
  <rdf:Description rdf:about="https://orcid.org/0000-0002-1599-9326">
    <rdfs:label>Alain Bouju</rdfs:label>
  </rdf:Description>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#Trips">
    <rdfs:label xml:lang="en">DRT trip</rdfs:label>
    <rdfs:comment xml:lang="en">A passenger journey of the DRT service: the trip of one passenger from a pickup stop to a drop-off stop during a ride. Every DRT trip originates from a prior reservation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#Driver">
    <rdfs:label xml:lang="en">driver</rdfs:label>
    <rdfs:comment xml:lang="en">A person who drives the vehicle during a ride or, for an autonomous shuttle, supervises it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/urbanmobility/drt#Person"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#Reservation">
    <rdfs:label xml:lang="en">reservation</rdfs:label>
    <rdfs:comment xml:lang="en">A booking for the on-demand transport service, made by a customer for one or more passengers. It states the requested pickup and drop-off stops, the time windows and the constraints of the journey, and is assigned to a ride.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nb80dc5248cca428186d1599097a42238b1">
        <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasTime"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2006/time#Interval"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Plan"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/2006/time#Interval"/>
  <owl:Class rdf:about="https://w3id.org/urbanmobility/drt#Person">
    <rdfs:label xml:lang="en">person</rdfs:label>
    <rdfs:comment xml:lang="en">A person involved in the DRT service: a customer, a passenger, a driver or an administrator.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/urbanmobility/drt"/>
  </owl:Class>
  <rdf:Description rdf:about="https://orcid.org/0000-0002-7792-8953">
    <rdfs:label>Esma Talhi</rdfs:label>
  </rdf:Description>
  <owl:Class rdf:about="http://purl.org/td/transportdisruption#Plan"/>
  <rdf:Description rdf:about="https://orcid.org/0009-0000-4334-4557">
    <rdfs:label>Nourelhouda El Gadi</rdfs:label>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasTime"/>
</rdf:RDF>
