     xmlns:schema="https://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:geosparql="http://www.opengis.net/ont/geosparql#"
     xmlns:Infrastructure="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand">
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <owl:imports rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport"/>
        <owl:imports rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#"/>
        <owl:imports rdf:resource="http://www.semanticweb.org/nelgad01/ontologies/2026/10/Event"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
    </owl:Ontology>
    


