    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#operatesOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#operatesOn">
