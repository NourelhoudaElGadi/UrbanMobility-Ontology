        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#BookingRule"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasException -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasException">
