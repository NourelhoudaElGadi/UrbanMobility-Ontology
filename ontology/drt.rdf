    <!-- http://semanticweb.cs.vu.nl/2009/11/sem/eventType -->

    <owl:ObjectProperty rdf:about="http://semanticweb.cs.vu.nl/2009/11/sem/eventType"/>
    


    <!-- http://semanticweb.cs.vu.nl/2009/11/sem/hasPlace -->

    <owl:ObjectProperty rdf:about="http://semanticweb.cs.vu.nl/2009/11/sem/hasPlace"/>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    


    <!-- http://www.opengis.net/ont/geosparql#sfIntersects -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfIntersects"/>
    


    <!-- http://www.opengis.net/ont/geosparql#sfTouches -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfTouches"/>
    


    <!-- http://www.opengis.net/ont/geosparql#sfWithin -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfWithin"/>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Arrives_at -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Arrives_at">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>the passenger arrives at an location</rdfs:comment>
        <rdfs:label>arrives at</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Departs_from -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Departs_from">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:comment>A passenger  depart from an location</rdfs:comment>
        <rdfs:label>departs from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Makes_a -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Makes_a">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#madeBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Customer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation"/>
        <rdfs:comment>A passenger make a reservation</rdfs:comment>
        <rdfs:label>makes a reservation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#StopAt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#StopAt">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#DRT_Shuttle"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
        <rdfs:label>stops at</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Travels_by -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Travels_by">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Passenger"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#DRT_Shuttle"/>
        <rdfs:comment>A passeger traveed by the shuttle</rdfs:comment>
        <rdfs:label>travels by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Use_fare_media -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Use_fare_media">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Customer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareMedia"/>
        <rdfs:comment>the passenger use differents fare media</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#assigned_to -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#assigned_to">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Ride"/>
        <rdfs:label>assigned to ride</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#belongsToRide -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#belongsToRide">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#includesTrip"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Ride"/>
        <rdfs:label>belongs to ride</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#buy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#buy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Customer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#FareProduct"/>
        <rdfs:comment>the customer buy a  fare product</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#complies_with -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#complies_with">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#BookingRule"/>
        <rdfs:comment>A reservation must comply with certain booking rules.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#driven_by -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#driven_by">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Driver"/>
        <rdfs:label>driven by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#hasDropoffLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#hasDropoffLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#hasDropoffTimeWindow -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#hasDropoffTimeWindow">
