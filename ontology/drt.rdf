     -->

    


    <!-- http://purl.org/td/transportdisruption#BlockadeOrBarrier -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BlockadeOrBarrier"/>
    


    <!-- http://purl.org/td/transportdisruption#Plan -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Plan"/>
    


    <!-- http://semanticweb.cs.vu.nl/2009/11/sem/Actor -->

    <owl:Class rdf:about="http://semanticweb.cs.vu.nl/2009/11/sem/Actor"/>
    


    <!-- http://semanticweb.cs.vu.nl/2009/11/sem/Event -->

    <owl:Class rdf:about="http://semanticweb.cs.vu.nl/2009/11/sem/Event"/>
    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature"/>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry"/>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Admin -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Admin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Person"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#ComfortSensitiveReservation -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#ComfortSensitiveReservation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation"/>
        <rdfs:comment>A demand-responsive transport reservation associated with a user having a reduced-mobility (PMR) or elderly profile. Such reservations are classified as comfort-sensitive to account for potential accessibility during transport service planning.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Customer -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Customer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Person"/>
        <rdfs:comment>Describes a customer who make a reservation for on-demand transportation services.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Driver -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Driver">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Person"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Passenger -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Passenger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Person"/>
        <rdfs:comment>Describes a passenger who uses on-demand transportation services.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Person -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Person"/>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Plan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2006/time#Interval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a booking made by a passenger to access on-demand transportation services.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Ride -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Ride"/>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#ShortNoticeReservation -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#ShortNoticeReservation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation"/>
        <rdfs:comment>A reservation made with a short lead time between its creation time and its currently requested pickup time. If the requested pickup time is modified, the lead time is recalculated, and the reservation may enter or leave this class without losing its identity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#TightDropWindowReservation -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#TightDropWindowReservation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation"/>
        <rdfs:comment>A reservation with a narrow drop-off time window, meaning that the passenger must be dropped off within a limited time interval defined by the DRT service. This time window may be modified after the reservation is created, and the reservation may consequently cease to belong to this class.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#TightPickupWindowReservation -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#TightPickupWindowReservation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Reservation"/>
        <rdfs:comment>A reservation with a narrow pickup time window, meaning that the passenger must be picked up within a limited time interval defined by the DRT service. This time window may be modified after the reservation is created, and the reservation may consequently cease to belong to this class.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Trips -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#Trips">
        <rdfs:comment>Defines a DRT trips, which are specific journeys made on a  route at a particular time.
Each Trips instance represents a passenger journey performed as a result of a prior Reservation. In the DRT system, every passenger trip necessarily originates from a reservation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#AreaOfInterest -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#AreaOfInterest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#UrbanEntity"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Arrow_markings -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Arrow_markings">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_markings"/>
        <rdfs:comment>Directional arrows painted on the road surface to indicate traffic flow and vehicle movements</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Building -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Building">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Micro Level: A  structure situated within the streets.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Bus -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Bus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:comment>A transport vehicle that travels along a fixed route, used for public or private transit in specific areas</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Cars -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Cars">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:comment>Motorized vehicles used primarily for personal transportation,  with four wheels.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Charging_station -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Charging_station">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Meso Level: A designated location for charging electric vehicles.</rdfs:comment>
        <rdfs:comment>Micro level: a specific charging point or station for electric vehicles</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#DRT_Shuttle -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#DRT_Shuttle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:comment>A Demand-responsive transport (DRT) shuttle that provides flexible transit services, allowing users to request rides as needed</rdfs:comment>
        <rdfs:comment>A Transport On Demand (DRT) shuttle that provides flexible transit services, allowing users to request rides as needed</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Hospital -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Hospital">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Building"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Industrial_Zone -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Industrial_Zone">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Meso Level: An area where specific types of economic activities are concentrated, such as industrial zones</rdfs:comment>
        <rdfs:comment>Meso Level: An area where specific types of economic activities are concentrated, such as industrial zones or commercial areas.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Intersection -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Intersection">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Micro Level: A junction where several streets intersect, requiring vehicles and pedestrians to follow signage to navigate the correct direction.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Lidar_sensor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Lidar_sensor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sensor"/>
        <rdfs:comment>A sensor that uses laser light to measure distances and detect objects</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Metro -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Metro">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Municipalities -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Municipalities">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>At the macro level, a municipality is a territorial district corresponding to a city</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Neighborhood -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Neighborhood">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Meso Level: A defined area that generally includes multiple streets, POIs (Points of Interest), etc.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Obstacles -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Obstacles">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment>Micro Level: An object or structure on the street that may block or impede the flow of vehicles or pedestrians</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Parking -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Parking">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Meso Level: A designated area for vehicle parking within a neighborhood, including parking lots or designated spaces</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Parking_markings -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Parking_markings">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_markings"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Markings that indicate designated parking spots on the road or in parking lots</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Pedestrian_crossing -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Pedestrian_crossing">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_markings"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>road surface markings that indicate safe crossing zones for pedestrians</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Pedestrians -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Pedestrians">
        <rdfs:subClassOf rdf:resource="http://semanticweb.cs.vu.nl/2009/11/sem/Actor"/>
        <rdfs:comment>micro level : People walking along the streets or crossing roads, or use a sidewalks</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Radar_sensor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Radar_sensor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sensor"/>
        <rdfs:comment>A sensor that uses radio waves to detect the speed and position of vehicles and other objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_markings -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_markings">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment>Micro Level: Road surface markings used to direct traffic, including lane lines, crosswalks, and directional arrows.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_segment -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_segment">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Micro Level: A segment of road between two points, such as those defined by intersections or road markings.
A spatially and topologically delimited portion of the road network at the micro level, generally defined between two reference points such as intersections or stops. Its identity is determined by its position, endpoints, and segmentation within the road network. Corrections to geometric coordinates do not create a new segment when the network segment remains unchanged, whereas splitting or merging segments results in distinct network segment identities.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#RondAbout -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#RondAbout">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#School -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#School">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Building"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sensor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sensor">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Micro Level: A device used to collect data on vehicle flow, such as speed, traffic volume, or vehicle density on a road.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Shuttle -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Shuttle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:comment>A transport vehicle that travels along a fixed route, used for public or private transit in specific areas</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sidewalk -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sidewalk">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A paved pathway adjacent to a street, intended for pedestrian use</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Micro Level: Describes streets designed for the movement of both vehicles and pedestrians</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_control -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_control">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Micro Level: Includes all signs, traffic lights, and road markings used to regulate, warn, or inform drivers and pedestrians about traffic rules</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_light -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_light">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_control"/>
        <rdfs:comment>Micro Level: A traffic signal that manages vehicle and pedestrian movement by switching between red, yellow, and green lights.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_signs -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_signs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_control"/>
        <rdfs:comment>Micro Level: Signs displaying traffic information, such as speed limits, restrictions, or directions to follow</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Train -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Train">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#UrbanEntity -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#UrbanEntity"/>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Weather_sensor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Weather_sensor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sensor"/>
        <rdfs:comment>A sensor that detects and reports weather conditions, such as rain, fog, or wind, which can affect traffic</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#bicycle -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#bicycle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:comment>A human-powered two-wheeled vehicle commonly used on streets, bike lanes, and sidewalks</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle">
        <rdfs:subClassOf rdf:resource="http://semanticweb.cs.vu.nl/2009/11/sem/Actor"/>
        <rdfs:comment>Motorized or non-motorized transportation devices used on roads for the movement of people or goods.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Agency -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Agency">
        <rdfs:subClassOf rdf:resource="http://semanticweb.cs.vu.nl/2009/11/sem/Actor"/>
        <rdfs:comment>Describes information about the transportation agency</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Area -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Area">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Describes the geographical areas within the transportation network</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Attribution -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Attribution">
        <rdfs:comment>describes the attributions for the provided data, such as copyrights and licenses etc ..</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#BookingRule -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#BookingRule">
        <rdfs:comment>Specifies the rules for booking services requested by the passenger, e.g. in the case of transport on demand, the rules include a deadline for booking before departure</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Calendar -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Calendar">
        <rdfs:comment>Defines the service days for different route and schedules</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#CalendarDates -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#CalendarDates">
        <rdfs:comment>specifying exceptions or adjustments to the schedules defined in calendar (e.g., holidays).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#FareAttribute -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#FareAttribute">
        <rdfs:comment>Defines the fare attributes of the services, including the price, payment method, validity etc</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#FareLegRule -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#FareLegRule">
        <rdfs:comment>Specifies the fare rules for each segment of the legs</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#FareMedia -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#FareMedia">
        <rdfs:comment>Specifies the types of media used to pay the fare, such as smart cards or paper tickets</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#FareProduct -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#FareProduct">
        <rdfs:comment>describe the range of fares available for purchase by riders</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#FareRule -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#FareRule">
        <rdfs:comment>Specifies the fare application rules based on routes, zones...</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#FareTransferRule -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#FareTransferRule">
        <rdfs:comment>Defines the Fare rules for transfers between legs of trips</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#FeedInfo -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#FeedInfo">
        <rdfs:comment>Provides general information about the GTFS data feed, including the producer and validity period.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Frequency -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Frequency">
        <rdfs:comment>represents trips that operate on regular headways (time between trips)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Level -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Level">
        <rdfs:comment>used to model the different physical levels of a station or transport building, such as :
Floors in a multimodal station (basement, first floor, upper floor), The levels of a multi-storey parking lot. etc</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Location -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Location">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Defines geographical areas where passengers can request pick-up or drop-off,( represented in GeoJSON format).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#LocationGroup -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#LocationGroup">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Defines location groups, which are groups of stops where a rider may request pickup or drop off.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Network -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Network">
        <rdfs:comment>Defines the transportation networks, such as route groups.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Pathway -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Pathway">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Provides a graphical representation to describe subway or train stations, with nodes representing locations and edges representing pathways</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Routes -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes">
        <rdfs:comment>Routes describe the public transit lines.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Shapes -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Shapes">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment>Describes the geometry of routes as connected GPS points, to represent the paths on a map.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#StopTimes -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#StopTimes">
        <rdfs:comment>Contains detailed schedules for each trip, with arrival and departure times for each stop on the trip&apos;s</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Stops -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Stops">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>the stops or stations served by the transportation network</rdfs:comment>
        <rdfs:label>GTFS Stops</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#TimeFrame -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#TimeFrame">
        <rdfs:comment>Used to describe fares that can change depending on the time of day, day of the week, or specific dates throughout the year.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Transfer">
        <rdfs:comment>Defines the transfer rules between stops,routes and trips</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Translation -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Translation">
        <rdfs:comment>Provides translations for text fields in multiple languages</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#Trips -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips">
        <rdfs:comment>Defines trips, which are specific journeys made on a  route at a particular time</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#Container -->

    <owl:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Container"/>
    


    <!-- http://www.w3.org/2006/time#Interval -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Interval"/>
    


    <!-- http://www.w3.org/2006/time#TemporalUnit -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalUnit"/>
    


