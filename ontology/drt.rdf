    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#hasGranularityLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#hasGranularityLevel"/>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#hasSensor -->

