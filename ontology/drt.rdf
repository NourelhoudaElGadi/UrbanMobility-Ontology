        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:comment>specifies which routes are operated by an agency.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#hasStop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#hasStop">
