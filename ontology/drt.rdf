    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#wait_at -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/6/OnDemand#wait_at">
