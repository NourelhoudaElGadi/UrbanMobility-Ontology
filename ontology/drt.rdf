    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#operatesOnRoute -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#operatesOnRoute">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Trips"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:comment>represents that Trips operate on a Route</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#partOfNetwork -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#partOfNetwork">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Routes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Network"/>
