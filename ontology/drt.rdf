        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/transport#Shapes"/>
        <rdfs:comment>It indicates that the trip follows a geographical shape.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#fromStop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#fromStop">
