    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/transport#isScheduledBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/transport#isScheduledBy">
