digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.3", ranksep="0.55", fontname="Overpass", splines=true, newrank=true];
node [shape=box, style="rounded,filled", fontname="Overpass", fontsize=13, height=0.34, margin="0.12,0.05", penwidth=1.4, fontcolor="#14212b"];
edge [fontname="Overpass", fontsize=11, color="#8795a1", fontcolor="#5a6977", arrowsize=0.7, penwidth=1.1];
compound=true;
subgraph cluster_event { label=<<B>Events and impacts</B>>; fontname="Overpass"; fontsize=14; fontcolor="#8a2f9e"; style="rounded,dashed"; color="#8a2f9e"; penwidth=1.2; margin=14; class="cl m-event";
"Events:impact" [label=<impact>, href="#impact", tooltip="Events:impact: An effect of an event. The module separates the effects on the travel plans of agents (Dtx:DisruptiveImpact)…", color="#8a2f9e", fillcolor="#f5ebf8", peripheries=1, class="own m-event"];
"Events:PlaceImpact" [label=<PlaceImpact>, href="#PlaceImpact", tooltip="Events:PlaceImpact: An impact of an event on a place of the transport network, such as a blocked road segment, a closed street or…", color="#8a2f9e", fillcolor="#f5ebf8", peripheries=1, class="own m-event"];
}
subgraph cluster_std { label=<<B>Reused ontologies</B>>; fontname="Overpass"; fontsize=14; fontcolor="#64748b"; style="rounded,dashed"; color="#64748b"; penwidth=1.2; margin=14; class="cl m-std";
"event:Event" [label=<event:Event>, href="http://motools.sourceforge.net/event/event.html#term_Event", target="_blank", tooltip="event:Event (reused ontology)", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"sem:Event" [label=<sem:Event>, href="https://semanticweb.cs.vu.nl/2009/11/sem/", target="_blank", tooltip="sem:Event: Events are things that happen. This comprises everything from historical events to web site sessions and mythical…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"sem:Place" [label=<sem:Place>, href="https://semanticweb.cs.vu.nl/2009/11/sem/", target="_blank", tooltip="sem:Place: Places are locations where an Event happens. They do not need to be physical places and hence do not necessarily need…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"sem:Actor" [label=<sem:Actor>, href="https://semanticweb.cs.vu.nl/2009/11/sem/", target="_blank", tooltip="sem:Actor: Actors are entities that take part in an Event, either actively or passively. Actors do not necessarily have to be…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"sem:EventType" [label=<sem:EventType>, href="https://semanticweb.cs.vu.nl/2009/11/sem/", target="_blank", tooltip="sem:EventType: EventType contains all resources that are used to classify Events, e.g. meeting.", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"sem:Time" [label=<sem:Time>, href="https://semanticweb.cs.vu.nl/2009/11/sem/", target="_blank", tooltip="sem:Time: Time contains symbolic representations of when an Event took place. Time instances do not necessarily need to have a…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"Dtx:DisruptiveImpact" [label=<Dtx:DisruptiveImpact>, href="https://transportdisruption.github.io/transportdisruption.html#d4e2064", target="_blank", tooltip="Dtx:DisruptiveImpact: A disruptive impact the action of one or more events causing or tending to prevent an agent's planned travel from…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"Dtx:Plan" [label=<Dtx:Plan>, href="https://transportdisruption.github.io/transportdisruption.html#d4e4574", target="_blank", tooltip="Dtx:Plan: Plan provides an extension point for users of the ontology to describe an agent's plan that may be impacted by an event.", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
}
subgraph cluster_drt { label=<<B>DRT core</B>>; fontname="Overpass"; fontsize=14; fontcolor="#c2410c"; style="rounded,dashed"; color="#c2410c"; penwidth=1.2; margin=14; class="cl m-drt";
"DRT:Reservation" [label=<DRT:Reservation>, href="drt.html#Reservation", tooltip="DRT:Reservation: A booking for the on-demand transport service, made by a customer for one or more passengers. It states the…", color="#c2410c", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=1, class="xmod m-drt"];
}
"event:Event" -> "Events:impact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="event.html#HasImpact" TOOLTIP="Events:HasImpact: Links an event to an impact that it causes.">HasImpact</TD></TR></TABLE>>, class="op"];
"sem:Event" -> "sem:Place" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="event.html#HasLocation" TOOLTIP="Events:HasLocation: Links an event to the place where it occurs, such as a road segment or a stop.">HasLocation</TD></TR></TABLE>>, class="op"];
"Events:PlaceImpact" -> "sem:Place" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="event.html#ImpactsOnPlace" TOOLTIP="Events:ImpactsOnPlace: Links a place impact to the place that it affects, such as a road segment or a stop.">ImpactsOnPlace</TD></TR></TABLE>>, class="op"];
"Events:impact" -> "sem:Actor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="event.html#AffectsActor" TOOLTIP="Events:AffectsActor: Links an impact to an actor that it affects, such as a passenger, a vehicle or an…">AffectsActor</TD></TR></TABLE>>, class="op"];
"sem:Event" -> "sem:EventType" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="https://semanticweb.cs.vu.nl/2009/11/sem/" TOOLTIP="sem:eventType">sem:eventType</TD></TR></TABLE>>, class="op std", color="#a3adb8", fontcolor="#7b8794"];
"sem:Event" -> "sem:Time" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="https://semanticweb.cs.vu.nl/2009/11/sem/" TOOLTIP="sem:hasTime">sem:hasTime</TD></TR></TABLE>>, class="op std", color="#a3adb8", fontcolor="#7b8794"];
"event:Event" -> "Dtx:DisruptiveImpact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="https://transportdisruption.github.io/transportdisruption.html#d4e223" TOOLTIP="Dtx:causeOf">Dtx:causeOf</TD></TR></TABLE>>, class="op std", color="#a3adb8", fontcolor="#7b8794"];
"Dtx:DisruptiveImpact" -> "Dtx:Plan" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="https://transportdisruption.github.io/transportdisruption.html#d4e271" TOOLTIP="Dtx:impactsOn">Dtx:impactsOn</TD></TR></TABLE>>, class="op std", color="#a3adb8", fontcolor="#7b8794"];
"Events:PlaceImpact" -> "Events:impact" [arrowhead=onormal, arrowsize=1.0, class="sub", tooltip="subclass of"];
"Dtx:DisruptiveImpact" -> "Events:impact" [arrowhead=onormal, arrowsize=1.0, class="sub", tooltip="subclass of"];
"event:Event" -> "sem:Event" [arrowhead=onormal, arrowsize=1.0, class="sub", tooltip="subclass of"];
"DRT:Reservation" -> "Dtx:Plan" [arrowhead=onormal, arrowsize=1.0, class="sub", tooltip="subclass of"];
}
