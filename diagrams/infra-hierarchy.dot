digraph G {
graph [rankdir=RL, bgcolor="transparent", pad="0.15", nodesep="0.12", ranksep="0.55", fontname="Overpass", splines=true, newrank=true];
node [shape=box, style="rounded,filled", fontname="Overpass", fontsize=13, height=0.34, margin="0.12,0.05", penwidth=1.4, fontcolor="#14212b"];
edge [fontname="Overpass", fontsize=11, color="#8795a1", fontcolor="#5a6977", arrowsize=0.7, penwidth=1.1];
"Infrastructure:AreaOfInterest" [label=<AreaOfInterest>, href="#AreaOfInterest", tooltip="Infrastructure:AreaOfInterest: A functional urban area of interest, such as a school, commercial or residential zone.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:UrbanEntity" [label=<UrbanEntity>, href="#UrbanEntity", tooltip="Infrastructure:UrbanEntity: Any entity of the urban and peri-urban environment considered in mobility modelling. It is the top class of the…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Arrow_markings" [label=<Arrow_markings>, href="#Arrow_markings", tooltip="Infrastructure:Arrow_markings: Directional arrows painted on the road surface to indicate traffic flow and vehicle movements.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Road_markings" [label=<Road_markings>, href="#Road_markings", tooltip="Infrastructure:Road_markings: Road surface markings that guide traffic, such as lane lines, crosswalks and directional arrows.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:bicycle" [label=<bicycle>, href="#bicycle", tooltip="Infrastructure:bicycle: A human-powered two-wheeled vehicle, used on streets, bicycle lanes and sometimes sidewalks.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:vehicle" [label=<vehicle>, href="#vehicle", tooltip="Infrastructure:vehicle: A motorised or non-motorised means of transport used on roads to move people or goods.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Bicycle_lane_marking" [label=<Bicycle_lane_marking>, href="#Bicycle_lane_marking", tooltip="Infrastructure:Bicycle_lane_marking: Ground markings indicating a lane or a space reserved for cyclists, with specific symbols or signs.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Building" [label=<Building>, href="#Building", tooltip="Infrastructure:Building: A building located along a street.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Bus" [label=<Bus>, href="#Bus", tooltip="Infrastructure:Bus: A road vehicle that runs on fixed routes for public or private transport.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Cars" [label=<Cars>, href="#Cars", tooltip="Infrastructure:Cars: A four-wheeled motor vehicle, used mainly for personal transport.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Charging_station" [label=<Charging_station>, href="#Charging_station", tooltip="Infrastructure:Charging_station: A place where electric vehicles, including DRT shuttles, can be charged.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:DRT_Shuttle" [label=<DRT_Shuttle>, href="#DRT_Shuttle", tooltip="Infrastructure:DRT_Shuttle: A vehicle temporarily assigned to the demand-responsive transport (DRT) service. It can stop playing this role without…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Hospital" [label=<Hospital>, href="#Hospital", tooltip="Infrastructure:Hospital: A hospital building, an important destination of DRT trips.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Industrial_Zone" [label=<Industrial_Zone>, href="#Industrial_Zone", tooltip="Infrastructure:Industrial_Zone: An area where economic activities, such as industry, are concentrated.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Intersection" [label=<Intersection>, href="#Intersection", tooltip="Infrastructure:Intersection: A junction where several streets meet, where vehicles and pedestrians follow signage to take the right direction.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Lidar_sensor" [label=<Lidar_sensor>, href="#Lidar_sensor", tooltip="Infrastructure:Lidar_sensor: A sensor that uses laser light to measure distances and detect objects.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Sensor" [label=<Sensor>, href="#Sensor", tooltip="Infrastructure:Sensor: A device that collects traffic data, such as vehicle speed, traffic volume or density on a road.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Metro" [label=<Metro>, href="#Metro", tooltip="Infrastructure:Metro: A metro (urban rail) vehicle.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Municipalities" [label=<Municipalities>, href="#Municipalities", tooltip="Infrastructure:Municipalities: A municipality: the territory of a city or a town, delimited in space and represented by a polygon or a multipolygon.…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Neighborhood" [label=<Neighborhood>, href="#Neighborhood", tooltip="Infrastructure:Neighborhood: A geographically delimited urban area that comprises streets, points of interest and other urban infrastructure…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Obstacles" [label=<Obstacles>, href="#Obstacles", tooltip="Infrastructure:Obstacles: An object or a structure on the street that may block or slow down vehicles or pedestrians.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Parking" [label=<Parking>, href="#Parking", tooltip="Infrastructure:Parking: A designated area for parking vehicles, such as a car park or parking spaces.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Parking_markings" [label=<Parking_markings>, href="#Parking_markings", tooltip="Infrastructure:Parking_markings: Markings that indicate parking spaces on the road or in car parks.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Pedestrian_crossing" [label=<Pedestrian_crossing>, href="#Pedestrian_crossing", tooltip="Infrastructure:Pedestrian_crossing: A zebra-style road marking that shows a pedestrian crossing.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Pedestrians" [label=<Pedestrians>, href="#Pedestrians", tooltip="Infrastructure:Pedestrians: People walking along streets, crossing roads or using sidewalks.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"DRT:Person" [label=<DRT:Person>, href="drt.html#Person", tooltip="DRT:Person: A person involved in the DRT service: a customer, a passenger, a driver or an administrator.", color="#c2410c", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=1, class="xmod m-drt"];
"Infrastructure:Radar_sensor" [label=<Radar_sensor>, href="#Radar_sensor", tooltip="Infrastructure:Radar_sensor: A sensor that uses radio waves to detect the speed and position of vehicles and other objects.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Road_segment" [label=<Road_segment>, href="#Road_segment", tooltip="Infrastructure:Road_segment: A portion of road between two reference points, such as intersections or stops. Its identity is determined by its…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:RondAbout" [label=<RondAbout>, href="#RondAbout", tooltip="Infrastructure:RondAbout: A roundabout: a circular intersection where traffic flows around a central island.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:School" [label=<School>, href="#School", tooltip="Infrastructure:School: A school building, an important destination of DRT trips.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Shuttle" [label=<Shuttle>, href="#Shuttle", tooltip="Infrastructure:Shuttle: A small vehicle that carries passengers along a fixed route, for public or private transit in a specific area.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Sidewalk" [label=<Sidewalk>, href="#Sidewalk", tooltip="Infrastructure:Sidewalk: A paved pathway adjacent to a street, intended for pedestrian use.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Streets" [label=<Streets>, href="#Streets", tooltip="Infrastructure:Streets: A street used by vehicles and pedestrians, made of one or more road segments.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Traffic_control" [label=<Traffic_control>, href="#Traffic_control", tooltip="Infrastructure:Traffic_control: The signs, traffic lights and road markings that regulate traffic and warn or inform drivers and pedestrians.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Traffic_light" [label=<Traffic_light>, href="#Traffic_light", tooltip="Infrastructure:Traffic_light: A traffic signal that controls the movement of vehicles and pedestrians with red, amber and green lights.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Traffic_signs" [label=<Traffic_signs>, href="#Traffic_signs", tooltip="Infrastructure:Traffic_signs: A road sign giving traffic information, such as a speed limit, a restriction or a direction.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Train" [label=<Train>, href="#Train", tooltip="Infrastructure:Train: A train (rail vehicle).", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Weather_sensor" [label=<Weather_sensor>, href="#Weather_sensor", tooltip="Infrastructure:Weather_sensor: A sensor that detects and reports weather conditions, such as rain, fog, or wind, which can affect traffic.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:AreaOfInterest" -> "Infrastructure:UrbanEntity" [arrowhead=onormal, arrowsize=1.0, class="sub", tooltip="subclass of"];
