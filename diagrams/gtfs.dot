digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.28", ranksep="0.5", fontname="Overpass", splines=true, newrank=true];
node [shape=box, style="rounded,filled", fontname="Overpass", fontsize=13, height=0.34, margin="0.12,0.05", penwidth=1.4, fontcolor="#14212b"];
edge [fontname="Overpass", fontsize=11, color="#8795a1", fontcolor="#5a6977", arrowsize=0.7, penwidth=1.1];
"GTFS:Attribution" [label=<Attribution<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">8 attributes</FONT>>, href="#Attribution", tooltip="GTFS:Attribution: An organisation credited for the data of the feed, such as its producer, operator or authority, with copyright and licence…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Agency" [label=<Agency<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">8 attributes</FONT>>, href="#Agency", tooltip="GTFS:Agency: A transit agency whose services are described in the feed. It corresponds to the file agency.txt of the GTFS reference.", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:FareTransferRule" [label=<FareTransferRule<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">4 attributes</FONT>>, href="#FareTransferRule", tooltip="GTFS:FareTransferRule: A rule for the cost of a transfer between two fare legs (GTFS-Fares v2). It corresponds to the file fare_transfer_rules.txt of…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:FareLegRule" [label=<FareLegRule<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">2 attributes</FONT>>, href="#FareLegRule", tooltip="GTFS:FareLegRule: A fare rule for one leg of a journey (GTFS-Fares v2), defined by origin and destination areas, network and time frames. It…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Routes" [label=<Routes<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">13 attributes</FONT>>, href="#Routes", tooltip="GTFS:Routes: A public transit line: a group of trips shown to riders as a single service. It corresponds to the file routes.txt of the GTFS…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Trips" [label=<Trips<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">7 attributes</FONT>>, href="#Trips", tooltip="GTFS:Trips: A journey of a vehicle along a route at a given time, serving a sequence of stops. It corresponds to the file trips.txt of the…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:BookingRule" [label=<BookingRule<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">14 attributes</FONT>>, href="#BookingRule", tooltip="GTFS:BookingRule: The booking rules of a service that must be booked in advance, such as on-demand transport: how, when and how far ahead a pickup…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:StopTimes" [label=<StopTimes<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">9 attributes</FONT>>, href="#StopTimes", tooltip="GTFS:StopTimes: The scheduled time at which a trip serves a stop: arrival time, departure time and position of the stop in the trip. It…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Level" [label=<Level<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">3 attributes</FONT>>, href="#Level", tooltip="GTFS:Level: A physical level of a station, such as a floor of a multimodal station or of a multi-storey car park. It corresponds to the file…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Stops" [label=<Stops<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">20 attributes</FONT>>, href="#Stops", tooltip="GTFS:Stops: A stop or a station where vehicles pick up or drop off riders. Stops of the regular network and stops of the DRT service are both…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=2, class="own m-gtfs feature"];
"GTFS:Shapes" [label=<Shapes<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">5 attributes</FONT>>, href="#Shapes", tooltip="GTFS:Shapes: The path that a vehicle travels along a route, as an ordered sequence of points. It corresponds to the file shapes.txt of the…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=2, class="own m-gtfs feature"];
"GTFS:Pathway" [label=<Pathway<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">10 attributes</FONT>>, href="#Pathway", tooltip="GTFS:Pathway: A link between two locations of a station, such as a walkway, stairs, an escalator or an elevator. It corresponds to the file…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=2, class="own m-gtfs feature"];
"GTFS:Area" [label=<Area<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">2 attributes</FONT>>, href="#Area", tooltip="GTFS:Area: A geographical area that groups stops, used to define fares by origin and destination areas. It corresponds to the file areas.txt…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=2, class="own m-gtfs feature"];
"GTFS:Transfer" [label=<Transfer<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">2 attributes</FONT>>, href="#Transfer", tooltip="GTFS:Transfer: A rule for connections between routes, trips or stops, such as a minimum transfer time. It corresponds to the file transfers.txt…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:TimeFrame" [label=<TimeFrame<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">3 attributes</FONT>>, href="#TimeFrame", tooltip="GTFS:TimeFrame: A time period (time of day and service days) during which a fare applies. It corresponds to the file timeframes.txt of the GTFS…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:FareProduct" [label=<FareProduct<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">4 attributes</FONT>>, href="#FareProduct", tooltip="GTFS:FareProduct: A fare product that riders can buy, such as a single ticket or a pass. It corresponds to the file fare_products.txt of the GTFS…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:FareRule" [label=<FareRule<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">3 attributes</FONT>>, href="#FareRule", tooltip="GTFS:FareRule: A rule that says when a fare applies, based on the route, the origin, the destination or the zones a rider passes through…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Location" [label=<Location>, href="#Location", tooltip="GTFS:Location: A zone, given as a GeoJSON polygon, where riders can request a pickup or a drop-off (GTFS-Flex). It corresponds to the file…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=2, class="own m-gtfs feature"];
"GTFS:LocationGroup" [label=<LocationGroup<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">2 attributes</FONT>>, href="#LocationGroup", tooltip="GTFS:LocationGroup: A group of stops where a rider may request a pickup or a drop-off (GTFS-Flex). It corresponds to the file location_groups.txt of…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=2, class="own m-gtfs feature"];
"GTFS:Calendar" [label=<Calendar<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">10 attributes</FONT>>, href="#Calendar", tooltip="GTFS:Calendar: The days of the week on which a service runs, between a start date and an end date. It corresponds to the file calendar.txt of…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:CalendarDates" [label=<CalendarDates<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">2 attributes</FONT>>, href="#CalendarDates", tooltip="GTFS:CalendarDates: An exception to a service calendar on a given date, for example a service added or removed on a public holiday. It corresponds to…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Frequency" [label=<Frequency<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">4 attributes</FONT>>, href="#Frequency", tooltip="GTFS:Frequency: A headway-based service, whose trips run at regular intervals instead of following a fixed timetable. It corresponds to the file…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:FareAttribute" [label=<FareAttribute<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">6 attributes</FONT>>, href="#FareAttribute", tooltip="GTFS:FareAttribute: A fare (GTFS-Fares v1): its price, currency, payment method and transfer conditions. It corresponds to the file…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:FareMedia" [label=<FareMedia<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">3 attributes</FONT>>, href="#FareMedia", tooltip="GTFS:FareMedia: A medium that holds or validates a fare product, such as a smart card, a paper ticket or a mobile app. It corresponds to the file…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Network" [label=<Network<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">2 attributes</FONT>>, href="#Network", tooltip="GTFS:Network: A group of routes, used in particular to define fares by network. It corresponds to the file networks.txt of the GTFS reference.", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Attribution" -> "GTFS:Agency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#AppliesToAgency" TOOLTIP="GTFS:AppliesToAgency: Links an attribution record to the agency it applies to.">AppliesToAgency</TD></TR></TABLE>>, class="op"];
"GTFS:FareTransferRule" -> "GTFS:FareLegRule" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#appliesToLegGroup" TOOLTIP="GTFS:appliesToLegGroup: Links a fare transfer rule to the fare leg rules (leg group) between which the transfer applies.">appliesToLegGroup</TD></TR></TABLE>>, class="op"];
"GTFS:Attribution" -> "GTFS:Routes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#appliesToRoute" TOOLTIP="GTFS:appliesToRoute: Links an attribution record to the route to which it applies.">appliesToRoute</TD></TR></TABLE>>, class="op"];
"GTFS:Attribution" -> "GTFS:Trips" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#AppliesToTrip" TOOLTIP="GTFS:AppliesToTrip: Links an attribution record to the trip it applies to.">AppliesToTrip</TD></TR></TABLE>>, class="op"];
"GTFS:BookingRule" -> "GTFS:Trips" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#bookingRuleAppliesToTrip" TOOLTIP="GTFS:bookingRuleAppliesToTrip: Links a booking rule to a trip it applies to.">bookingRuleAppliesToTrip</TD></TR></TABLE>>, class="op"];
"GTFS:StopTimes" -> "GTFS:Trips" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#belongsToTrip" TOOLTIP="GTFS:belongsToTrip: Links a stop time to the trip it belongs to.">belongsToTrip</TD></TR></TABLE>>, class="op"];
"GTFS:Level" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#definesLevelFor" TOOLTIP="GTFS:definesLevelFor: Links a level to a stop located on that level.">definesLevelFor</TD></TR></TABLE>>, class="op"];
"GTFS:Trips" -> "GTFS:Shapes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#followsShape" TOOLTIP="GTFS:followsShape: Links a trip to the shape that its vehicle follows.">followsShape</TD></TR></TABLE>>, class="op"];
"GTFS:Pathway" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#fromStop" TOOLTIP="GTFS:fromStop: Links a pathway to the stop where the pathway starts.">fromStop</TD></TR><TR><TD HREF="#ToStop" TOOLTIP="GTFS:ToStop: Links a pathway to the stop where the pathway ends.">ToStop</TD></TR></TABLE>>, class="op"];
"GTFS:Routes" -> "GTFS:Agency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasAgency" TOOLTIP="GTFS:hasAgency: Links a route to the agency that operates it.">hasAgency</TD></TR></TABLE>>, class="op"];
"GTFS:StopTimes" -> "GTFS:BookingRule" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasBookingRule" TOOLTIP="GTFS:hasBookingRule: Links a stop time record to the booking rule that governs it.">hasBookingRule</TD></TR></TABLE>>, class="op"];
"GTFS:FareLegRule" -> "GTFS:Area" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasDestinationArea" TOOLTIP="GTFS:hasDestinationArea: Links a fare leg rule to the destination area at which the fare leg ends.">hasDestinationArea</TD></TR><TR><TD HREF="#hasOriginArea" TOOLTIP="GTFS:hasOriginArea: Links a fare leg rule to the origin area from which the fare leg starts.">hasOriginArea</TD></TR></TABLE>>, class="op"];
"GTFS:Transfer" -> "GTFS:Routes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasDestinationRoute" TOOLTIP="GTFS:hasDestinationRoute: Links a transfer rule to the destination route to which the transfer leads.">hasDestinationRoute</TD></TR><TR><TD HREF="#hasOriginRoute" TOOLTIP="GTFS:hasOriginRoute: Links a transfer rule to the origin route from which the transfer starts.">hasOriginRoute</TD></TR></TABLE>>, class="op"];
"GTFS:Transfer" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasDestinationStop" TOOLTIP="GTFS:hasDestinationStop: Links a transfer rule to the destination stop where the transfer ends.">hasDestinationStop</TD></TR><TR><TD HREF="#hasOriginStop" TOOLTIP="GTFS:hasOriginStop: Links a transfer rule to the origin stop where the transfer begins.">hasOriginStop</TD></TR></TABLE>>, class="op"];
"GTFS:Transfer" -> "GTFS:Trips" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasDestinationTrip" TOOLTIP="GTFS:hasDestinationTrip: Links a transfer rule to the destination trip to which the transfer leads.">hasDestinationTrip</TD></TR><TR><TD HREF="#hasOriginTrip" TOOLTIP="GTFS:hasOriginTrip: Links a transfer rule to the origin trip from which the transfer starts.">hasOriginTrip</TD></TR></TABLE>>, class="op"];
"GTFS:FareLegRule" -> "GTFS:TimeFrame" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasEndTimeframeGroup" TOOLTIP="GTFS:hasEndTimeframeGroup: Links a fare leg rule to the timeframe group that applies to the fare validation event at the end…">hasEndTimeframeGroup</TD></TR><TR><TD HREF="#hasStartTimeframeGroup" TOOLTIP="GTFS:hasStartTimeframeGroup: Links a fare leg rule to the timeframe group that applies to the fare validation event at the start…">hasStartTimeframeGroup</TD></TR></TABLE>>, class="op"];
"GTFS:FareLegRule" -> "GTFS:FareProduct" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasFareProduct" TOOLTIP="GTFS:hasFareProduct: Links a fare leg rule to the fare product that it applies.">hasFareProduct</TD></TR></TABLE>>, class="op"];
"GTFS:Routes" -> "GTFS:FareRule" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasFareRule" TOOLTIP="GTFS:hasFareRule: Links a route to a fare rule that applies to it.">hasFareRule</TD></TR></TABLE>>, class="op"];
"GTFS:Stops" -> "GTFS:Location" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasLocation" TOOLTIP="GTFS:hasLocation: Links a stop to a GTFS-Flex zone (location) associated with it.">hasLocation</TD></TR><TR><TD HREF="#isLocatedIn" TOOLTIP="GTFS:isLocatedIn: Links a stop to a zone (location) in which it is located.">isLocatedIn</TD></TR></TABLE>>, class="op"];
"GTFS:Stops" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasParentStation" TOOLTIP="GTFS:hasParentStation: Links a stop to its parent station.">hasParentStation</TD></TR></TABLE>>, class="op"];
"GTFS:Trips" -> "GTFS:Routes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasRoute" TOOLTIP="GTFS:hasRoute: Links a trip to the route it belongs to.">hasRoute</TD></TR></TABLE>>, class="op"];
"GTFS:LocationGroup" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasStop" TOOLTIP="GTFS:hasStop: Links a location group to a stop that it contains.">hasStop</TD></TR></TABLE>>, class="op"];
"GTFS:Trips" -> "GTFS:StopTimes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasStopTime" TOOLTIP="GTFS:hasStopTime: Links a trip to one of its stop times.">hasStopTime</TD></TR></TABLE>>, class="op"];
"GTFS:TimeFrame" -> "GTFS:Calendar" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#isApplicableDuring" TOOLTIP="GTFS:isApplicableDuring: Indicates that the time period described by timeframes applies to the service days defined in the…">isApplicableDuring</TD></TR></TABLE>>, class="op"];
"GTFS:Calendar" -> "GTFS:CalendarDates" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasException" TOOLTIP="GTFS:isExceptionOf: ">isExceptionOf</TD></TR></TABLE>>, class="op"];
"GTFS:Trips" -> "GTFS:Frequency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#isScheduledBy" TOOLTIP="GTFS:isScheduledBy: Links a trip to the frequency (headway) definition that schedules it.">isScheduledBy</TD></TR></TABLE>>, class="op"];
"GTFS:Stops" -> "GTFS:StopTimes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#isServedAtTime" TOOLTIP="GTFS:isServedAtTime: Links a stop to a stop time at which it is served.">isServedAtTime</TD></TR></TABLE>>, class="op"];
"GTFS:FareAttribute" -> "GTFS:Agency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#managedBy" TOOLTIP="GTFS:managedBy: Links a fare to the agency that manages it.">managedBy</TD></TR></TABLE>>, class="op"];
"GTFS:FareMedia" -> "GTFS:FareProduct" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#offersSupportTo" TOOLTIP="GTFS:offersSupportTo: Links a fare medium to a fare product that it can hold.">offersSupportTo</TD></TR></TABLE>>, class="op"];
"GTFS:Routes" -> "GTFS:Network" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#partOfNetwork" TOOLTIP="GTFS:partOfNetwork: Links a route to the network it belongs to.">partOfNetwork</TD></TR></TABLE>>, class="op"];
"GTFS:StopTimes" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#servesStop" TOOLTIP="GTFS:servesStop: Links a stop time to the stop that it serves.">servesStop</TD></TR></TABLE>>, class="op"];
"GTFS:Stops" -> "GTFS:Area" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#stopInArea" TOOLTIP="GTFS:stopInArea: Links a stop to an area that contains or groups it.">stopInArea</TD></TR></TABLE>>, class="op"];
"GTFS:Stops" -> "GTFS:LocationGroup" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#stopInLocationGroup" TOOLTIP="GTFS:stopInLocationGroup: Links a stop to the location group to which it belongs.">stopInLocationGroup</TD></TR></TABLE>>, class="op"];
"GTFS:FareRule" -> "GTFS:FareAttribute" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#usesFareAttribute" TOOLTIP="GTFS:usesFareAttribute: Links a fare rule to the fare that it applies.">usesFareAttribute</TD></TR></TABLE>>, class="op"];
"GTFS:Trips" -> "GTFS:Calendar" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#usesService" TOOLTIP="GTFS:usesService: Links a trip to the service calendar that says on which days it runs.">usesService</TD></TR></TABLE>>, class="op"];
}
