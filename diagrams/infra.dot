"Infrastructure:Municipalities" [label=<Municipalities<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">5 attributes</FONT>>, href="#Municipalities", tooltip="Infrastructure:Municipalities: A municipality: the territory of a city or a town, delimited in space and represented by a polygon or a multipolygon.…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Neighborhood" [label=<Neighborhood<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">4 attributes</FONT>>, href="#Neighborhood", tooltip="Infrastructure:Neighborhood: A geographically delimited urban area that comprises streets, points of interest and other urban infrastructure…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
