"Infrastructure:UrbanEntity" [label=<UrbanEntity>, href="#UrbanEntity", tooltip="Infrastructure:UrbanEntity: Any entity of the urban and peri-urban environment considered in mobility modelling. It is the top class of the…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Sidewalk" [label=<Sidewalk>, href="#Sidewalk", tooltip="Infrastructure:Sidewalk: A paved pathway adjacent to a street, intended for pedestrian use.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Obstacles" [label=<Obstacles<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">3 attributes</FONT>>, href="#Obstacles", tooltip="Infrastructure:Obstacles: An object or a structure on the street that may block or slow down vehicles or pedestrians.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Road_segment" [label=<Road_segment<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">12 attributes</FONT>>, href="#Road_segment", tooltip="Infrastructure:Road_segment: A portion of road between two reference points, such as intersections or stops. Its identity is determined by its…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Intersection" [label=<Intersection<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">3 attributes</FONT>>, href="#Intersection", tooltip="Infrastructure:Intersection: A junction where several streets meet, where vehicles and pedestrians follow signage to take the right direction.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Traffic_control" [label=<Traffic_control>, href="#Traffic_control", tooltip="Infrastructure:Traffic_control: The signs, traffic lights and road markings that regulate traffic and warn or inform drivers and pedestrians.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Building" [label=<Building<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">3 attributes</FONT>>, href="#Building", tooltip="Infrastructure:Building: A building located along a street.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:GranularityLevel" [label=<GranularityLevel>, href="#GranularityLevel", tooltip="Infrastructure:GranularityLevel: The level of spatial granularity of an urban entity: micro (street level), meso (neighbourhood level) or macro…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Sensor" [label=<Sensor<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">4 attributes</FONT>>, href="#Sensor", tooltip="Infrastructure:Sensor: A device that collects traffic data, such as vehicle speed, traffic volume or density on a road.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
