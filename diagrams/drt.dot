"DRT:Reservation" -> "DRT:Ride" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#assigned_to" TOOLTIP="DRT:assigned_to: Links a reservation to the ride (vehicle run) to which it is assigned.">assigned_to</TD></TR></TABLE>>, class="op"];
"DRT:Trips" -> "DRT:Ride" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#belongsToRide" TOOLTIP="DRT:belongsToRide: Links a DRT trip to the ride during which it is performed.">belongsToRide</TD></TR></TABLE>>, class="op"];
"DRT:Customer" -> "GTFS:FareProduct" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#buy" TOOLTIP="DRT:buy: Links a customer to a fare product that he or she buys.">buy</TD></TR></TABLE>>, class="op"];
"DRT:Reservation" -> "GTFS:BookingRule" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#complies_with" TOOLTIP="DRT:complies_with: Links a reservation to a booking rule that it must comply with, for example a minimum…">complies_with</TD></TR></TABLE>>, class="op"];
"DRT:Trips" -> "DRT:Driver" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#driven_by" TOOLTIP="DRT:driven_by: Links a DRT trip to the driver of the vehicle that performs it.">driven_by</TD></TR></TABLE>>, class="op"];
