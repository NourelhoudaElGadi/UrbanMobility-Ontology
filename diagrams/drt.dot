"DRT:Reservation" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasDropoffLocation" TOOLTIP="DRT:hasDropoffLocation: Links a reservation to the requested drop-off stop.">hasDropoffLocation</TD></TR><TR><TD HREF="#hasPickupLocation" TOOLTIP="DRT:hasPickupLocation: Links a reservation to the requested pickup stop.">hasPickupLocation</TD></TR></TABLE>>, class="op"];
"DRT:Reservation" -> "time:Interval" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasDropoffTimeWindow" TOOLTIP="DRT:hasDropoffTimeWindow: Links a reservation to the time interval in which the passenger must be dropped off.">hasDropoffTimeWindow</TD></TR><TR><TD HREF="#hasPickupTimeWindow" TOOLTIP="DRT:hasPickupTimeWindow: Links a reservation to the time interval in which the passenger must be picked up.">hasPickupTimeWindow</TD></TR><TR><TD HREF="https://www.w3.org/TR/owl-time/#time:hasTime" TOOLTIP="restriction: time:hasTime some …"><I>time:hasTime (some)</I></TD></TR></TABLE>>, class="op has-restr"];
"DRT:Reservation" -> "DRT:Passenger" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#hasPassenger" TOOLTIP="DRT:hasPassenger: Links a reservation to a passenger who travels under it.">hasPassenger</TD></TR></TABLE>>, class="op"];
"DRT:Ride" -> "DRT:Trips" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#includesTrip" TOOLTIP="DRT:includesTrip: Links a ride to a passenger trip that it includes.">includesTrip</TD></TR></TABLE>>, class="op"];
"GTFS:Stops" -> "Infrastructure:Streets" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#is_located_on_Streets" TOOLTIP="DRT:is_located_on_Streets: Links a stop to the street on which it is located.">is_located_on_Streets</TD></TR></TABLE>>, class="op"];
"DRT:Reservation" -> "DRT:Customer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#madeBy" TOOLTIP="DRT:madeBy: Links a reservation to the customer who made it.">madeBy</TD></TR></TABLE>>, class="op"];
"Infrastructure:DRT_Shuttle" -> "DRT:Trips" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#make_a_trip" TOOLTIP="DRT:make_a_trip: Links a DRT shuttle to a trip that it performs.">make_a_trip</TD></TR></TABLE>>, class="op"];
"DRT:Customer" -> "DRT:Reservation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#Makes_a" TOOLTIP="DRT:Makes_a: Links a customer to a reservation that he or she makes.">Makes_a</TD></TR></TABLE>>, class="op"];
"DRT:Trips" -> "GTFS:Routes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#operate_on" TOOLTIP="DRT:operate_on: Links a DRT trip to the DRT line (route) on which it operates.">operate_on</TD></TR></TABLE>>, class="op"];
