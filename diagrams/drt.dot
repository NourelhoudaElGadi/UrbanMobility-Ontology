digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.28", ranksep="0.5", fontname="Overpass", splines=true, newrank=true];
node [shape=box, style="rounded,filled", fontname="Overpass", fontsize=13, height=0.34, margin="0.12,0.05", penwidth=1.4, fontcolor="#14212b"];
edge [fontname="Overpass", fontsize=11, color="#8795a1", fontcolor="#5a6977", arrowsize=0.7, penwidth=1.1];
"DRT:Trips" [label=<Trips<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">14 attributes</FONT>>, href="#Trips", tooltip="DRT:Trips: A passenger journey of the DRT service: the trip of one passenger from a pickup stop to a drop-off stop during a ride.…", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"GTFS:Stops" [label=<GTFS:Stops>, href="gtfs.html#Stops", tooltip="GTFS:Stops: A stop or a station where vehicles pick up or drop off riders. Stops of the regular network and DRT stops are both…", color="#1d5fa8", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=2, class="xmod m-gtfs feature"];
"DRT:Reservation" [label=<Reservation<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">38 attributes</FONT>>, href="#Reservation", tooltip="DRT:Reservation: A booking for the on-demand transport service, made by a customer for one or more passengers. It states the requested…", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"DRT:Ride" [label=<Ride>, href="#Ride", tooltip="DRT:Ride: A vehicle run of the DRT service. A ride is operated by one driver with one shuttle on a DRT line, and includes the…", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"DRT:Customer" [label=<Customer>, href="#Customer", tooltip="DRT:Customer: A person who books DRT trips. The customer makes the reservation and may travel or book for other passengers.", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"GTFS:FareProduct" [label=<GTFS:FareProduct>, href="gtfs.html#FareProduct", tooltip="GTFS:FareProduct: A fare product that riders can buy, such as a single ticket or a pass.", color="#1d5fa8", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=1, class="xmod m-gtfs"];
"GTFS:BookingRule" [label=<GTFS:BookingRule>, href="gtfs.html#BookingRule", tooltip="GTFS:BookingRule: The booking rules of a service that must be booked in advance, such as on-demand transport: how, when and how far ahead…", color="#1d5fa8", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=1, class="xmod m-gtfs"];
"DRT:Driver" [label=<Driver<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">2 attributes</FONT>>, href="#Driver", tooltip="DRT:Driver: A person who drives the vehicle during a ride or, for an autonomous shuttle, supervises it.", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"GTFS:Routes" [label=<GTFS:Routes>, href="gtfs.html#Routes", tooltip="GTFS:Routes: A public transit line: a group of trips shown to riders as a single service.", color="#1d5fa8", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=1, class="xmod m-gtfs"];
"Infrastructure:DRT_Shuttle" [label=<Infrastructure:DRT_Shuttle>, href="infrastructure.html#DRT_Shuttle", tooltip="Infrastructure:DRT_Shuttle: A vehicle temporarily assigned to the demand-responsive transport (DRT) service. It can stop playing this role without…", color="#2f7d32", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=1, class="xmod m-infra"];
"time:Interval" [label=<time:Interval>, href="https://www.w3.org/TR/owl-time/#time:Interval", target="_blank", tooltip="time:Interval: A temporal entity with an extent or duration", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"DRT:Passenger" [label=<Passenger>, href="#Passenger", tooltip="DRT:Passenger: A person who travels on a DRT trip under a reservation.", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"Infrastructure:Streets" [label=<Infrastructure:Streets>, href="infrastructure.html#Streets", tooltip="Infrastructure:Streets: A street used by vehicles and pedestrians, made of one or more road segments.", color="#2f7d32", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=2, class="xmod m-infra feature"];
"GTFS:FareMedia" [label=<GTFS:FareMedia>, href="gtfs.html#FareMedia", tooltip="GTFS:FareMedia: A medium that holds or validates a fare product, such as a smart card, a paper ticket or a mobile app.", color="#1d5fa8", fillcolor="#ffffff", style="rounded,dashed,filled", peripheries=1, class="xmod m-gtfs"];
"DRT:Person" [label=<Person<BR/><FONT POINT-SIZE="10" COLOR="#5a6977">6 attributes</FONT>>, href="#Person", tooltip="DRT:Person: A person involved in the DRT service: a customer, a passenger, a driver or an administrator.", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
