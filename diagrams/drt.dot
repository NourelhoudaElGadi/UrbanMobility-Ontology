"DRT:Passenger" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#wait_at" TOOLTIP="DRT:wait_at: Links a passenger to the stop where he or she waits to be picked up.">wait_at</TD></TR></TABLE>>, class="op"];
"DRT:Reservation" -> "DRT:Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#wasCancelledBy" TOOLTIP="DRT:wasCancelledBy: Links a cancelled reservation to the person who cancelled it: the customer, the driver or…">wasCancelledBy</TD></TR></TABLE>>, class="op"];
