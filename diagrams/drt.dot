"DRT:Customer" -> "GTFS:FareMedia" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="#Use_fare_media" TOOLTIP="DRT:Use_fare_media: Links a customer to a fare medium (card, ticket or app) that he or she uses.">Use_fare_media</TD></TR></TABLE>>, class="op"];
