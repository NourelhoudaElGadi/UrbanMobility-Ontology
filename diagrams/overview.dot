digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.3", ranksep="0.55", fontname="Overpass", splines=true, newrank=true];
node [shape=box, style="rounded,filled", fontname="Overpass", fontsize=13, height=0.34, margin="0.12,0.05", penwidth=1.4, fontcolor="#14212b"];
edge [fontname="Overpass", fontsize=11, color="#8795a1", fontcolor="#5a6977", arrowsize=0.7, penwidth=1.1];
compound=true;
subgraph cluster_drt { label=<<B>DRT core</B>>; fontname="Overpass"; fontsize=14; fontcolor="#c2410c"; style="rounded,dashed"; color="#c2410c"; penwidth=1.2; margin=14; class="cl m-drt";
"DRT:Customer" [label=<Customer>, href="drt.html#Customer", tooltip="DRT:Customer: A person who books DRT trips. The customer makes the reservation and may travel or book for other passengers.", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"DRT:Reservation" [label=<Reservation>, href="drt.html#Reservation", tooltip="DRT:Reservation: A booking for the on-demand transport service, made by a customer for one or more passengers. It states the requested pickup and…", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"DRT:Passenger" [label=<Passenger>, href="drt.html#Passenger", tooltip="DRT:Passenger: A person who travels on a DRT trip under a reservation.", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"DRT:Ride" [label=<Ride>, href="drt.html#Ride", tooltip="DRT:Ride: A vehicle run of the DRT service. A ride is operated by one driver with one shuttle on a DRT line, and includes the trips of all…", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
"DRT:Trips" [label=<Trips>, href="drt.html#Trips", tooltip="DRT:Trips: A passenger journey of the DRT service: the trip of one passenger from a pickup stop to a drop-off stop during a ride. Every DRT…", color="#c2410c", fillcolor="#fdeee6", peripheries=1, class="own m-drt"];
}
subgraph cluster_gtfs { label=<<B>GTFS service</B>>; fontname="Overpass"; fontsize=14; fontcolor="#1d5fa8"; style="rounded,dashed"; color="#1d5fa8"; penwidth=1.2; margin=14; class="cl m-gtfs";
"GTFS:BookingRule" [label=<BookingRule>, href="gtfs.html#BookingRule", tooltip="GTFS:BookingRule: The booking rules of a service that must be booked in advance, such as on-demand transport: how, when and how far ahead a pickup…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Routes" [label=<Routes>, href="gtfs.html#Routes", tooltip="GTFS:Routes: A public transit line: a group of trips shown to riders as a single service. It corresponds to the file routes.txt of the GTFS…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Trips" [label=<Trips>, href="gtfs.html#Trips", tooltip="GTFS:Trips: A journey of a vehicle along a route at a given time, serving a sequence of stops. It corresponds to the file trips.txt of the…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:StopTimes" [label=<StopTimes>, href="gtfs.html#StopTimes", tooltip="GTFS:StopTimes: The scheduled time at which a trip serves a stop: arrival time, departure time and position of the stop in the trip. It…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
"GTFS:Stops" [label=<Stops>, href="gtfs.html#Stops", tooltip="GTFS:Stops: A stop or a station where vehicles pick up or drop off riders. Stops of the regular network and stops of the DRT service are both…", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=2, class="own m-gtfs feature"];
"GTFS:Agency" [label=<Agency>, href="gtfs.html#Agency", tooltip="GTFS:Agency: A transit agency whose services are described in the feed. It corresponds to the file agency.txt of the GTFS reference.", color="#1d5fa8", fillcolor="#e8f0fa", peripheries=1, class="own m-gtfs"];
}
subgraph cluster_infra { label=<<B>Urban infrastructure</B>>; fontname="Overpass"; fontsize=14; fontcolor="#2f7d32"; style="rounded,dashed"; color="#2f7d32"; penwidth=1.2; margin=14; class="cl m-infra";
"Infrastructure:vehicle" [label=<vehicle>, href="infrastructure.html#vehicle", tooltip="Infrastructure:vehicle: A motorised or non-motorised means of transport used on roads to move people or goods.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:DRT_Shuttle" [label=<DRT_Shuttle>, href="infrastructure.html#DRT_Shuttle", tooltip="Infrastructure:DRT_Shuttle: A vehicle temporarily assigned to the demand-responsive transport (DRT) service. It can stop playing this role without ceasing to…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=1, class="own m-infra"];
"Infrastructure:Road_segment" [label=<Road_segment>, href="infrastructure.html#Road_segment", tooltip="Infrastructure:Road_segment: A portion of road between two reference points, such as intersections or stops. Its identity is determined by its position, its…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Intersection" [label=<Intersection>, href="infrastructure.html#Intersection", tooltip="Infrastructure:Intersection: A junction where several streets meet, where vehicles and pedestrians follow signage to take the right direction.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Streets" [label=<Streets>, href="infrastructure.html#Streets", tooltip="Infrastructure:Streets: A street used by vehicles and pedestrians, made of one or more road segments.", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Neighborhood" [label=<Neighborhood>, href="infrastructure.html#Neighborhood", tooltip="Infrastructure:Neighborhood: A geographically delimited urban area that comprises streets, points of interest and other urban infrastructure elements. A…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
"Infrastructure:Municipalities" [label=<Municipalities>, href="infrastructure.html#Municipalities", tooltip="Infrastructure:Municipalities: A municipality: the territory of a city or a town, delimited in space and represented by a polygon or a multipolygon. Its…", color="#2f7d32", fillcolor="#e9f4ea", peripheries=2, class="own m-infra feature"];
}
subgraph cluster_event { label=<<B>Events and impacts</B>>; fontname="Overpass"; fontsize=14; fontcolor="#8a2f9e"; style="rounded,dashed"; color="#8a2f9e"; penwidth=1.2; margin=14; class="cl m-event";
"Events:impact" [label=<impact>, href="event.html#impact", tooltip="Events:impact: An effect of an event. The module separates the effects on the travel plans of agents (Dtx:DisruptiveImpact) from the effects on…", color="#8a2f9e", fillcolor="#f5ebf8", peripheries=1, class="own m-event"];
"Events:PlaceImpact" [label=<PlaceImpact>, href="event.html#PlaceImpact", tooltip="Events:PlaceImpact: An impact of an event on a place of the transport network, such as a blocked road segment, a closed street or an unavailable stop.", color="#8a2f9e", fillcolor="#f5ebf8", peripheries=1, class="own m-event"];
}
subgraph cluster_std { label=<<B>Reused ontologies</B>>; fontname="Overpass"; fontsize=14; fontcolor="#64748b"; style="rounded,dashed"; color="#64748b"; penwidth=1.2; margin=14; class="cl m-std";
"event:Event" [label=<event:Event>, href="http://motools.sourceforge.net/event/event.html#term_Event", target="_blank", tooltip="event:Event (reused ontology)", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"sem:Event" [label=<sem:Event>, href="https://semanticweb.cs.vu.nl/2009/11/sem/", target="_blank", tooltip="sem:Event: Events are things that happen. This comprises everything from historical events to web site sessions and mythical…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"sem:Place" [label=<sem:Place>, href="https://semanticweb.cs.vu.nl/2009/11/sem/", target="_blank", tooltip="sem:Place: Places are locations where an Event happens. They do not need to be physical places and hence do not necessarily need…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"sem:Actor" [label=<sem:Actor>, href="https://semanticweb.cs.vu.nl/2009/11/sem/", target="_blank", tooltip="sem:Actor: Actors are entities that take part in an Event, either actively or passively. Actors do not necessarily have to be…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"Dtx:DisruptiveImpact" [label=<Dtx:DisruptiveImpact>, href="https://transportdisruption.github.io/transportdisruption.html#d4e2064", target="_blank", tooltip="Dtx:DisruptiveImpact: A disruptive impact the action of one or more events causing or tending to prevent an agent's planned travel from…", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"Dtx:Plan" [label=<Dtx:Plan>, href="https://transportdisruption.github.io/transportdisruption.html#d4e4574", target="_blank", tooltip="Dtx:Plan: Plan provides an extension point for users of the ontology to describe an agent's plan that may be impacted by an event.", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
"time:Interval" [label=<time:Interval>, href="https://www.w3.org/TR/owl-time/#time:Interval", target="_blank", tooltip="time:Interval: A temporal entity with an extent or duration", color="#64748b", fillcolor="#eef1f5", style="rounded,dashed,filled", class="ext"];
}
"Infrastructure:Road_segment" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="https://docs.ogc.org/is/22-047r1/22-047r1.html#sf_relations" TOOLTIP="geosparql:sfIntersects">geosparql:sfIntersects</TD></TR></TABLE>>, class="op std", color="#a3adb8", fontcolor="#7b8794"];
"DRT:Reservation" -> "DRT:Customer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#madeBy" TOOLTIP="DRT:madeBy: Links a reservation to the customer who made it.">madeBy</TD></TR></TABLE>>, class="op"];
"DRT:Reservation" -> "DRT:Passenger" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#hasPassenger" TOOLTIP="DRT:hasPassenger: Links a reservation to a passenger who travels under it.">hasPassenger</TD></TR></TABLE>>, class="op"];
