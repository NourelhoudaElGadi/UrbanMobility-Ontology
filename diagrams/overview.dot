"Infrastructure:Road_segment" -> "Infrastructure:Intersection" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="infrastructure.html#connectedToIntersection" TOOLTIP="Infrastructure:connectedToIntersection: Links a road segment to an intersection at one of its ends.">connectedToIntersection</TD></TR></TABLE>>, class="op"];
"Infrastructure:Streets" -> "Infrastructure:Neighborhood" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="infrastructure.html#IsPartOfNeighborhood" TOOLTIP="Infrastructure:IsPartOfNeighborhood: Links a street to the neighbourhood it belongs to.">IsPartOfNeighborhood</TD></TR></TABLE>>, class="op"];
"Infrastructure:Neighborhood" -> "Infrastructure:Municipalities" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="infrastructure.html#isPartOfMunicipalities" TOOLTIP="Infrastructure:isPartOfMunicipalities: Links a neighbourhood to the municipality it belongs to.">isPartOfMunicipalities</TD></TR></TABLE>>, class="op"];
"Infrastructure:vehicle" -> "Infrastructure:Streets" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="infrastructure.html#RunsOnStreet" TOOLTIP="Infrastructure:RunsOnStreet: Links a vehicle to a street on which it runs.">RunsOnStreet</TD></TR></TABLE>>, class="op"];
"event:Event" -> "Events:impact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="event.html#HasImpact" TOOLTIP="Events:HasImpact: Links an event to an impact that it causes.">HasImpact</TD></TR></TABLE>>, class="op"];
"sem:Event" -> "sem:Place" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="event.html#HasLocation" TOOLTIP="Events:HasLocation: Links an event to the place where it occurs, such as a road segment or a stop.">HasLocation</TD></TR></TABLE>>, class="op"];
"Events:PlaceImpact" -> "sem:Place" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="event.html#ImpactsOnPlace" TOOLTIP="Events:ImpactsOnPlace: Links a place impact to the place that it affects, such as a road segment or a stop.">ImpactsOnPlace</TD></TR></TABLE>>, class="op"];
