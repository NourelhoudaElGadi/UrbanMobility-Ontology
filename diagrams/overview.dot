"DRT:Ride" -> "DRT:Trips" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#includesTrip" TOOLTIP="DRT:includesTrip: Links a ride to a passenger trip that it includes.">includesTrip</TD></TR></TABLE>>, class="op"];
"DRT:Ride" -> "Infrastructure:DRT_Shuttle" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#usesVehicle" TOOLTIP="DRT:usesVehicle: Links a ride to the DRT shuttle that performs it.">usesVehicle</TD></TR></TABLE>>, class="op"];
"DRT:Ride" -> "GTFS:Routes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#operatesOn" TOOLTIP="DRT:operatesOn: Links a ride to the DRT line (route) on which it operates.">operatesOn</TD></TR></TABLE>>, class="op"];
"DRT:Trips" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#Departs_from" TOOLTIP="DRT:Departs_from: Links a DRT trip to the stop where the passenger is picked up.">Departs_from</TD></TR><TR><TD HREF="drt.html#Arrives_at" TOOLTIP="DRT:Arrives_at: Links a DRT trip to the stop where the passenger is dropped off.">Arrives_at</TD></TR></TABLE>>, class="op"];
"DRT:Reservation" -> "GTFS:BookingRule" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#complies_with" TOOLTIP="DRT:complies_with: Links a reservation to a booking rule that it must comply with, for example a minimum prior notice.">complies_with</TD></TR></TABLE>>, class="op"];
"DRT:Reservation" -> "time:Interval" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#hasPickupTimeWindow" TOOLTIP="DRT:hasPickupTimeWindow: Links a reservation to the time interval in which the passenger must be picked up.">hasPickupTimeWindow</TD></TR><TR><TD HREF="drt.html#hasDropoffTimeWindow" TOOLTIP="DRT:hasDropoffTimeWindow: Links a reservation to the time interval in which the passenger must be dropped off.">hasDropoffTimeWindow</TD></TR></TABLE>>, class="op"];
"GTFS:Stops" -> "Infrastructure:Streets" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="drt.html#is_located_on_Streets" TOOLTIP="DRT:is_located_on_Streets: Links a stop to the street on which it is located.">is_located_on_Streets</TD></TR></TABLE>>, class="op"];
"GTFS:StopTimes" -> "GTFS:Stops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="gtfs.html#servesStop" TOOLTIP="GTFS:servesStop: Links a stop time to the stop that it serves.">servesStop</TD></TR></TABLE>>, class="op"];
"GTFS:StopTimes" -> "GTFS:Trips" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD HREF="gtfs.html#belongsToTrip" TOOLTIP="GTFS:belongsToTrip: Links a stop time to the trip it belongs to.">belongsToTrip</TD></TR></TABLE>>, class="op"];
